{
    "name": "Vlasov particle orbits in a tokamak",
    "description": "Trace full-orbit test particles through a tokamak\u2019s magnetic field and watch them gyrate around field lines while circulating -- or bouncing -- through the torus.",
    "model": {
        "model": "Vlasov"
    },
    "params_path": null,
    "env": {
        "out_folders": "struphy_gallery_runs",
        "sim_folder": "vlasov_tokamak",
        "sim_label": null,
        "restart": false,
        "max_runtime": 300,
        "save_step": 1,
        "save_restart": true,
        "sort_step": 0,
        "num_clones": 1
    },
    "time_opts": {
        "dt": 0.005,
        "Tend": 20.0,
        "split_algo": "LieTrotter"
    },
    "domain": {
        "type": "Tokamak",
        "params": {
