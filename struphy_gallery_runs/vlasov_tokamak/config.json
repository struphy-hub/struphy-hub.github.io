                    "n1": 2.0,
                    "n2": 1.0,
                    "na": 0.2,
                    "p_kind": 1,
                    "p0": 1.0,
                    "p1": 0.1,
                    "p2": 0.1,
                    "beta": 0.179,
                    "psi_k": 3,
                    "psi_nel": 50
                }
            },
            "num_elements": [
                4,
                16
            ],
            "degree": [
                2,
                3
            ],
            "psi_power": 0.75,
            "psi_shifts": [
                0.01,
                2.0
            ],
            "r_min": 0.0,
            "xi_param": "equal_angle",
            "r0": 0.3,
            "num_elements_pre": [
                64,
                256
            ],
            "p_pre": [
                3,
                3
            ],
            "tor_period": 1
        }
    },
    "equil": {
        "type": "AdhocTorus",
        "params": {
            "a": 1.0,
            "R0": 3.0,
            "B0": 8.0,
            "q_kind": 0,
            "q0": 1.71,
            "q1": 1.87,
            "l": 0.0,
            "n1": 2.0,
            "n2": 1.0,
            "na": 0.2,
            "p_kind": 1,
            "p0": 1.0,
            "p1": 0.1,
            "p2": 0.1,
            "beta": 0.179,
            "psi_k": 3,
            "psi_nel": 50
        }
    },
    "grid": {
        "num_elements": [
            8,
            12,
            4
        ],
        "mpi_dims_mask": [
            true,
            true,
            true
