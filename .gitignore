# Python
.venv/
__pycache__/
.cache/
*.py[cod]

# Generated data and logs
/*.vtp
/docs/public/domains/
/docs/public/example-domains/
/docs/src/data/equilibria/*.json
/docs/src/data/perturbations/*.json
*.log
# Scratch simulation output from running docs/src/examples/*.py -- never the
# site's own content, and can be hundreds of MB (raw HDF5 run data).
/docs/public/examples/struphy_gallery_runs/
# Everything docs/src/examples/*.py produces is regenerated by CI
# (see .github/workflows/build-site.yml) before every site build, so none of it
# is committed. Locally, `python cli.py run <example>` (or `python cli.py metadata --all`
# for just the metadata) makes it.
/docs/public/examples/*.metadata.json
/docs/public/images/examples/*.png
/docs/src/data/examples-index.json
/docs/public/examples/*.html
/docs/public/examples/*.plotly.json
/docs/public/examples/*.png
/docs/public/examples/*-profile.h5
/docs/public/examples/*-durations.json
/docs/public/examples/*-gantt.json
/docs/public/examples/*-flame.json
/docs/public/examples/*-region-stats.json
docs/src/examples/EXAMPLE_IDEAS.md
docs/public/examples/struphy.log.*

# Editors and operating systems
.idea/
.vscode/
.DS_Store
