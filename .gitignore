# Python
.venv/
__pycache__/
*.py[cod]

# Generated data and logs
/*.vtp
/docs/public/domains/
/docs/src/data/equilibria/*.json
/docs/src/data/perturbations/*.json
*.log
# Scratch simulation output from running docs/src/examples/*.py -- never the
# site's own content, and can be hundreds of MB (raw HDF5 run data).
/docs/public/examples/struphy_gallery_runs/
# Everything else docs/src/examples/*.py produces is regenerated by CI
# (see .github/workflows/deploy.yml) before every site build, so it's never
# committed -- only the small, hand-curated *.metadata.json (name,
# description, thumbnail/interactive paths, ...) is tracked.
/docs/public/examples/*.html
/docs/public/examples/*.png
/docs/public/examples/*-profile.h5
/docs/public/examples/*-durations.json
/docs/public/examples/*-gantt.json
/docs/public/examples/*-flame.json
/docs/public/examples/*-region-stats.json

# Editors and operating systems
.idea/
.vscode/
.DS_Store
