---
// Two VTK PolyData layers rendered together: a translucent flux surface and field-line tubes, both carrying
// the point array `B` (|B|). Generated by scripts/generate_hero_stellarator.py; the ramp below matches it.
const {
  domain = 'Stellarator',
  layers = [
    { source: '/hero/stellarator-surface.vtp', opacity: 0.32 },
    { source: '/hero/stellarator-lines.vtp', opacity: 1 },
  ],
  poster = '/images/stellarator-hero.webp',
  caption = 'Magnetic field lines and |B| on the flux surface of a five-period GVEC stellarator, the equilibrium of the gallery example.',
} = Astro.props;
---
<figure class="hero-domain" data-hero-domain data-layers={JSON.stringify(layers)} data-domain={domain}>
  <div class="viewer-shell">
    <img class="poster" src={poster} width="1440" height="1120" alt={`${domain}: magnetic field lines on a flux surface coloured by field strength, computed with GVEC and Struphy`} fetchpriority="high" />
    <div class="viewer" data-hero-viewer role="img" aria-label={`Interactive ${domain} model. Drag to rotate, scroll to zoom, and shift-drag to pan.`} aria-hidden="true"></div>
    <p class="status" data-hero-status role="status">Loading interactive view…</p>
    <button class="reset" type="button" data-hero-reset disabled>Reset view</button>
  </div>
  <figcaption><span>{caption}</span><span class="instructions">Drag to rotate · Scroll to zoom · Shift-drag to pan</span></figcaption>
</figure>

<script>
  type Cleanup = () => void;
  type Layer = { source: string; opacity: number };
  const heroCleanups = new Map<HTMLElement, Cleanup>();
  const heroPending = new Map<HTMLElement, IntersectionObserver>();

  // |B| ramp shared with the poster: low, middle, high field strength.
  const FIELD_STOPS: [number, number, number][] = [[0x2f, 0x6b, 0xd8], [0x55, 0xe6, 0xe1], [0xff, 0xd1, 0x66]];
  const FIELD_RANGE: [number, number] = [1.0, 1.42];

  function themeColour(variable: string): [number, number, number] {
    const value = getComputedStyle(document.documentElement).getPropertyValue(variable).trim();
    const hex = value.match(/^#([\da-f]{3}|[\da-f]{6})$/i)?.[1];
    if (hex) {
      const expanded = hex.length === 3 ? [...hex].map((character) => character + character).join('') : hex;
      return [0, 2, 4].map((offset) => parseInt(expanded.slice(offset, offset + 2), 16) / 255) as [number, number, number];
    }
    const rgb = value.match(/^rgba?\(\s*([\d.]+)[, ]+\s*([\d.]+)[, ]+\s*([\d.]+)/i);
    return rgb ? [Number(rgb[1]) / 255, Number(rgb[2]) / 255, Number(rgb[3]) / 255] : [0, 0, 0];
  }

  async function setupHero(root: HTMLElement): Promise<Cleanup> {
    await import('@kitware/vtk.js/Rendering/Profiles/Geometry');
    const [{ default: vtkGenericRenderWindow }, { default: vtkActor }, { default: vtkMapper }, { default: vtkXMLPolyDataReader }, { default: vtkColorTransferFunction }] = await Promise.all([
      import('@kitware/vtk.js/Rendering/Misc/GenericRenderWindow'), import('@kitware/vtk.js/Rendering/Core/Actor'),
      import('@kitware/vtk.js/Rendering/Core/Mapper'), import('@kitware/vtk.js/IO/XML/XMLPolyDataReader'),
      import('@kitware/vtk.js/Rendering/Core/ColorTransferFunction'),
    ]);
    const container = root.querySelector<HTMLElement>('[data-hero-viewer]');
    const poster = root.querySelector<HTMLImageElement>('.poster');
    const status = root.querySelector<HTMLElement>('[data-hero-status]');
    const reset = root.querySelector<HTMLButtonElement>('[data-hero-reset]');
    if (!container || !poster || !status || !reset) return () => {};

    const layers: Layer[] = JSON.parse(root.dataset.layers || '[]');
    const grw = vtkGenericRenderWindow.newInstance();
    grw.setContainer(container); grw.resize();
    const renderer = grw.getRenderer(), renderWindow = grw.getRenderWindow();

    const lut = vtkColorTransferFunction.newInstance();
    FIELD_STOPS.forEach(([r, g, b], index) => lut.addRGBPoint(FIELD_RANGE[0] + (FIELD_RANGE[1] - FIELD_RANGE[0]) * index / (FIELD_STOPS.length - 1), r / 255, g / 255, b / 255));

    const parts = layers.map((layer) => {
      const reader = vtkXMLPolyDataReader.newInstance(), mapper = vtkMapper.newInstance(), actor = vtkActor.newInstance();
      mapper.setLookupTable(lut); mapper.setScalarRange(...FIELD_RANGE); mapper.setColorModeToMapScalars();
      mapper.setScalarModeToUsePointFieldData(); mapper.setColorByArrayName('B'); mapper.setScalarVisibility(true);
      actor.setMapper(mapper); actor.getProperty().setOpacity(layer.opacity);
      actor.getProperty().setAmbient(0.55); actor.getProperty().setDiffuse(0.55); actor.getProperty().setSpecular(0);
      renderer.addActor(actor);
      return { layer, reader, mapper, actor };
    });

    let cameraState: any, disposed = false;
    const applyTheme = () => { renderer.setBackground(...themeColour('--ink')); renderWindow.render(); };
    const resetView = () => { if (!cameraState) return; const camera = renderer.getActiveCamera(); camera.setPosition(...cameraState.position); camera.setFocalPoint(...cameraState.focalPoint); camera.setViewUp(...cameraState.viewUp); renderer.resetCameraClippingRange(); renderWindow.render(); };
    applyTheme(); reset.addEventListener('click', resetView);
    const themeObserver = new MutationObserver(applyTheme); themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    const resizeObserver = new ResizeObserver(() => { if (!disposed) { grw.resize(); renderWindow.render(); } }); resizeObserver.observe(container);

    try {
      const bounds = [Infinity, -Infinity, Infinity, -Infinity, Infinity, -Infinity];
      await Promise.all(parts.map(async ({ layer, reader, mapper }) => {
        const response = await fetch(layer.source);
        if (!response.ok) throw new Error(`${layer.source} returned ${response.status}`);
        reader.parseAsArrayBuffer(await response.arrayBuffer());
        const data = reader.getOutputData(0);
        if (!data || data.getNumberOfPoints() === 0) throw new Error(`No renderable points in ${layer.source}`);
        mapper.setInputData(data);
        const b = data.getBounds();
        for (let i = 0; i < 6; i += 2) { bounds[i] = Math.min(bounds[i], b[i]); bounds[i + 1] = Math.max(bounds[i + 1], b[i + 1]); }
      }));
      const center = [(bounds[0] + bounds[1]) / 2, (bounds[2] + bounds[3]) / 2, (bounds[4] + bounds[5]) / 2];
      const span = Math.max(bounds[1] - bounds[0], bounds[3] - bounds[2], bounds[5] - bounds[4]);
      const camera = renderer.getActiveCamera(); camera.setFocalPoint(...center); camera.setPosition(center[0] + 0.35 * span, center[1] - 0.95 * span, center[2] + 0.7 * span); camera.setViewUp(0, 0, 1);
      renderer.resetCamera(); camera.zoom(1.35); renderer.resetCameraClippingRange();
      cameraState = { position: [...camera.getPosition()], focalPoint: [...camera.getFocalPoint()], viewUp: [...camera.getViewUp()] }; applyTheme();
      root.classList.add('ready'); container.setAttribute('aria-hidden', 'false'); poster.setAttribute('aria-hidden', 'true'); status.hidden = true; reset.disabled = false;
    } catch (error) {
      console.error(`Unable to load ${root.dataset.domain}:`, error); status.textContent = 'Interactive view unavailable; showing a rendered preview.'; status.classList.add('error');
    }
    return () => {
      disposed = true; themeObserver.disconnect(); resizeObserver.disconnect(); reset.removeEventListener('click', resetView);
      parts.forEach(({ reader, mapper, actor }) => { renderer.removeActor(actor); actor.delete(); mapper.delete(); reader.delete(); });
      lut.delete(); grw.delete();
    };
  }

  function initialiseHero() {
    document.querySelectorAll<HTMLElement>('[data-hero-domain]').forEach((root) => {
      if (heroCleanups.has(root) || heroPending.has(root)) return;
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect(); heroPending.delete(root);
        setupHero(root).then((cleanup) => root.isConnected ? heroCleanups.set(root, cleanup) : cleanup());
      }, { rootMargin: '250px' });
      heroPending.set(root, observer); observer.observe(root);
    });
  }
  initialiseHero(); document.addEventListener('astro:page-load', initialiseHero);
  document.addEventListener('astro:before-swap', () => { heroPending.forEach((observer) => observer.disconnect()); heroPending.clear(); heroCleanups.forEach((cleanup) => cleanup()); heroCleanups.clear(); });
</script>

<style>
  .hero-domain{margin:0;min-width:0}.viewer-shell{position:relative;aspect-ratio:9/7;overflow:hidden;border:1px solid var(--rule);background:var(--ink)}.poster,.viewer{position:absolute;inset:0;width:100%;height:100%}.poster{display:block;object-fit:cover;opacity:1;transition:opacity .25s ease}.viewer{opacity:0;touch-action:none;transition:opacity .25s ease}.viewer :global(canvas){display:block;width:100%;height:100%}.ready .poster{opacity:0;pointer-events:none}.ready .viewer{opacity:1}.status{position:absolute;inset:auto 14px 14px;z-index:2;margin:0;color:#a9b7bb;font-size:.78rem;pointer-events:none}.status.error{max-width:300px;padding:6px 8px;background:color-mix(in srgb,var(--ink) 88%,transparent);color:var(--paper)}.status[hidden]{display:none}.reset{position:absolute;top:12px;right:12px;z-index:3;padding:6px 10px;border:1px solid var(--rule);background:color-mix(in srgb,var(--ink) 88%,transparent);color:var(--paper);cursor:pointer;font:600 .75rem/1.4 var(--sans)}.reset:hover:not(:disabled){border-color:var(--cyan);color:var(--cyan)}.reset:disabled{opacity:0;pointer-events:none}figcaption{display:flex;justify-content:space-between;gap:12px;margin-top:10px;color:var(--muted);font-size:.82rem}.instructions{text-align:right}@media(prefers-reduced-motion:reduce){.poster,.viewer{transition:none}}@media(max-width:520px){figcaption{flex-direction:column;gap:2px}.instructions{text-align:left}}
</style>
