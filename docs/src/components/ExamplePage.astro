---
import Layout from '../layouts/Layout.astro';
import ExtraFigures from './ExtraFigures.astro';
import VtkDomainViewer from './VtkDomainViewer.astro';
import { toSlug } from '../lib/catalogue';

const { slug, data, config, highlightedSource, equationsHtml, nextExample, exampleDomain } = Astro.props;
const model = typeof data.model === 'string' ? data.model : data.model?.model || 'Struphy';
const domainName = typeof data.domain === 'string' ? data.domain.split(' ')[0] : '';
const hasProfiling = Boolean(data.profilingRegionStats);
---

<Layout title={`${data.name} — Struphy Examples`} description={data.description}>
  <main>
    <header class="intro">
      <p class="eyebrow"><a href={`/models/${toSlug(model)}/`}>{model}</a> · {config.category}</p>
      <h1>{data.name}</h1>
      <p>{data.description}</p>
      <nav class="example-navigation" aria-label="Example navigation">
        <a class="back" href="/examples/">← All examples</a>
        <a class="source-shortcut" href="#source-title">Simulation script ↓</a>
        {nextExample && <a class="next-example" href={nextExample.href}>Next example: {nextExample.name} →</a>}
      </nav>
    </header>

    <figure class="result">
      <div class="plot-frame"><iframe src={`/examples/${slug}.html`} title={config.plotTitle} loading="eager"></iframe></div>
      <noscript><img src={`/images/examples/${slug}.png`} alt={config.plotAlt} width="2200" height="1500" /></noscript>
      <figcaption>Actual output from the script below. Interactive controls are available in the plot above.</figcaption>
    </figure>

    {data.projectionsInteractive && (
      <figure class="result">
        <div class="plot-frame projections"><iframe src={data.projectionsInteractive} title="Projected particle trajectories" loading="lazy"></iframe></div>
        <noscript><img src={data.projectionsThumbnail} alt="Projected particle trajectories" width="3000" height="1120" /></noscript>
        <figcaption>Additional projections of the simulated trajectories.</figcaption>
      </figure>
    )}

    {data.figures && <ExtraFigures figures={data.figures} />}

    <section class="explanation" aria-labelledby="setup-title">
      <div>
        <p class="eyebrow">Physical problem</p>
        <h2 id="setup-title">{config.setupTitle}</h2>
        <p>{data.description}</p>
        {equationsHtml && <div class="equations prose" aria-label="PDE equations" set:html={equationsHtml}></div>}
        {exampleDomain && <section class="example-domain" aria-labelledby="example-domain-title">
          <p class="eyebrow">Simulation geometry</p>
          <h3 id="example-domain-title">Domain used in this run</h3>
          <p class="requirements">The actual <code>{exampleDomain.name}</code> geometry reconstructed from this run's metadata. Switch between the 3D view and physical-coordinate slices.</p>
          <VtkDomainViewer single initialDomain={exampleDomain.name} domains={[{
            name: exampleDomain.name,
            url: `/example-domains/${slug}.vtp`,
            sliceBase: `/example-domains/${slug}`,
            docsUrl: `https://struphy-hub.github.io/struphy/sections/subsections/domains-avail.html#struphy.geometry.domains.${exampleDomain.name}`,
            metadata: { parameters: exampleDomain.parameters },
          }]} />
        </section>}
      </div>
      <dl>
        <div><dt>Model</dt><dd><a href={`/models/${toSlug(model)}/`}>{model}</a></dd></div>
        {domainName && <div><dt>Domain</dt><dd><a href={`/domains/#${domainName}`}>{data.domain}</a></dd></div>}
        {data.grid && <div><dt>Grid</dt><dd>{data.grid}</dd></div>}
        {data.degree && <div><dt>FEEC degree</dt><dd>{data.degree}</dd></div>}
        {data.integrator && <div><dt>Integrator</dt><dd>{data.integrator}</dd></div>}
        {data.steps && <div><dt>Evolution</dt><dd>{data.steps.toLocaleString()} steps</dd></div>}
        {data.visualization && <div><dt>Visualization</dt><dd>{data.visualization}</dd></div>}
      </dl>
    </section>

    {hasProfiling && <section class="profiling" aria-labelledby="profiling-title" id="profiling-section"
      data-durations={data.profilingDurations} data-gantt={data.profilingGantt} data-stats={data.profilingRegionStats}>
      <div class="source-heading"><div><p class="eyebrow">Performance</p><h2 id="profiling-title">Profiling</h2></div>
        <div class="source-actions"><a href={data.profilingData} download>Download profile .h5</a></div></div>
      <p class="requirements">Struphy's built-in <a href="https://pypi.org/project/scope-profiler/">scope-profiler</a> instruments every propagator, pusher and solver call — these are the real per-call timings from the run above.</p>
      <div class="pf-grid"><article class="pf-tile"><div class="pf-tile-header"><h3>Durations</h3><select id="pf-metric" class="pf-select" aria-label="Duration metric"><option value="total">Total</option><option value="avg">Average</option></select></div><input id="pf-filter-durations" class="pf-filter" type="search" placeholder="Filter regions" aria-label="Filter regions" autocomplete="off" /><div id="pf-plot-durations" class="pf-plot"></div></article><article class="pf-tile"><div class="pf-tile-header"><h3>Gantt <span class="muted">(rank 0)</span></h3></div><input id="pf-filter-gantt" class="pf-filter" type="search" placeholder="Filter regions" aria-label="Filter regions" autocomplete="off" /><div id="pf-plot-gantt" class="pf-plot"></div></article></div>
      <div class="pf-tile-header"><h3>Region statistics</h3><input id="pf-filter-table" class="pf-filter" type="search" placeholder="Filter regions" aria-label="Filter regions" autocomplete="off" /></div><div class="table-wrap"><table><thead><tr><th>Region</th><th>Count</th><th>Avg (s)</th><th>Min (s)</th><th>Max (s)</th><th>Total (s)</th></tr></thead><tbody id="pf-region-body"></tbody></table></div>
    </section>}

    <section class="source" aria-labelledby="source-title"><div class="source-heading"><div><p class="eyebrow">Complete source</p><h2 id="source-title">Simulation script</h2></div><div class="source-actions"><button type="button" data-copy>Copy script</button><a href={`/examples/${slug}.py`} download>Download .py</a></div></div><p class="requirements">Requires Struphy with compiled kernels and Plotly. Run <code>struphy compile</code> once, then execute <code>python {slug}.py</code>.</p><div class="highlight" data-source set:html={highlightedSource}></div><p class="provenance">See the <a href="https://struphy-hub.github.io/struphy/sections/userguide.html#post-processing-and-visualization">post-processing guide</a> for more ways to inspect the result.</p></section>
  </main>
</Layout>

<script>
  function mountCopyButton() { const button=document.querySelector<HTMLButtonElement>('[data-copy]'); const source=document.querySelector<HTMLElement>('[data-source]'); if(!button||!source)return; button.onclick=async()=>{try{await navigator.clipboard.writeText(source.textContent||'');button.textContent='Copied'}catch{button.textContent='Copy failed'}setTimeout(()=>{button.textContent='Copy script'},1800)}; }
  mountCopyButton(); document.addEventListener('astro:page-load',mountCopyButton);
  function mountProfiling(){ import('../lib/profiling-page.js').then(({ mountProfilingSection }) => mountProfilingSection(document.getElementById('profiling-section'))); }
  if (document.getElementById('profiling-section')) { mountProfiling(); document.addEventListener('astro:page-load', mountProfiling); }
</script>

<style>
  .intro{max-width:850px;padding-block:clamp(52px,7vw,84px)}.example-navigation{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;margin-top:20px}.source-shortcut{padding:8px 12px;border:1px solid var(--cyan);color:var(--cyan);font:650 .78rem var(--sans);text-decoration:none}.source-shortcut:hover{background:var(--accent-wash)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}h1{margin:0 0 18px;font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.08;letter-spacing:-.035em}.intro>p:not(.eyebrow){color:var(--muted);font-size:1.05rem}.eyebrow a{color:var(--cyan);text-decoration:none}.eyebrow a:hover{text-decoration:underline}.back,.next-example{color:var(--cyan)}.next-example{margin-left:auto;text-align:right}
  .result,.extra{margin:0;padding-block:40px 52px;border-top:1px solid var(--rule)}.plot-frame{width:min(100%,1100px);aspect-ratio:1100/650;margin-inline:auto}.plot-frame.projections{width:min(100%,1500px);aspect-ratio:1500/560}.result iframe,.extra iframe{display:block;width:100%;height:100%;border:1px solid var(--rule);background:#fff}.result img,.extra img{display:block;width:min(100%,1100px);height:auto;margin-inline:auto;border:1px solid var(--rule);background:#fff}.result figcaption,.extra figcaption{width:min(100%,1100px);margin:10px auto 0;color:var(--muted);font-size:.84rem}.explanation,.source,.profiling{padding-block:clamp(44px,7vw,68px);border-top:1px solid var(--rule)}.example-domain{margin-top:32px;padding-top:28px;border-top:1px solid var(--rule)}.example-domain h3{margin:0 0 12px;font-size:1.25rem}.example-domain>:global(.domain-browser){margin-top:28px}.explanation{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.48fr);gap:clamp(40px,8vw,100px)}h2{margin:0 0 14px;font-size:clamp(1.55rem,3vw,2.1rem)}.explanation>div>p:not(.eyebrow),.requirements,.provenance{color:var(--muted)}.equations{margin-top:24px;padding:18px 20px;border-left:2px solid var(--cyan);background:var(--accent-wash);font-size:.95rem;overflow-x:auto}.equations :global(p){margin:0 0 6px}.equations :global(p:last-child){margin-bottom:0}.equations :global(strong){color:var(--cyan)}dl{margin:0;border-top:1px solid var(--rule)}dl div{display:flex;justify-content:space-between;gap:24px;padding:10px 0;border-bottom:1px solid var(--rule)}dt{color:var(--muted);font-size:.82rem}dd{margin:0;text-align:right;font:700 .8rem var(--mono)}dd a{color:var(--cyan);text-decoration:none}.source-heading{display:flex;align-items:end;justify-content:space-between;gap:24px}.source-actions{display:flex;gap:12px}.source-actions button,.source-actions a{padding:8px 12px;border:1px solid var(--cyan);background:none;color:var(--cyan);cursor:pointer;font:650 .78rem var(--sans);text-decoration:none}.source-actions button:hover,.source-actions a:hover{background:var(--accent-wash)}.requirements code{color:var(--paper)}.highlight{max-height:720px;margin:24px 0 0;overflow:auto;border:1px solid var(--rule);background:var(--code-bg)}.highlight :global(.shiki){min-width:max-content;margin:0;padding:22px;background:var(--code-bg)!important;font:.79rem/1.65 var(--mono);tab-size:4}.highlight :global(.shiki code){display:block}.provenance{font-size:.82rem}.provenance a{color:var(--cyan)}.pf-grid{display:grid;grid-template-columns:1fr;gap:20px;margin-top:24px}.pf-tile{border:1px solid var(--rule);padding:16px}.pf-tile-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.pf-tile-header h3{margin:0;font-size:1rem}.pf-select,.pf-filter{font:600 .78rem var(--sans);border:1px solid var(--rule);background:var(--paper-bg,transparent);color:var(--paper);padding:6px 8px}.pf-filter{width:100%;margin-bottom:10px}.pf-plot{width:100%;min-height:340px;max-height:640px;overflow-y:auto}.table-wrap{margin-top:16px;overflow-x:auto;border:1px solid var(--rule)}.table-wrap table{width:100%;border-collapse:collapse;font:.8rem var(--mono)}.table-wrap th,.table-wrap td{padding:7px 10px;border-bottom:1px solid var(--rule);text-align:left;white-space:nowrap}.table-wrap th{color:var(--muted);font-weight:600;position:sticky;top:0;background:var(--code-bg)}.muted{color:var(--muted)}@media(max-width:720px){.example-navigation{align-items:flex-start;flex-direction:column;gap:14px}.next-example{margin-left:0;text-align:left}.explanation{grid-template-columns:1fr}.source-heading{align-items:flex-start;flex-direction:column}.source-actions{flex-wrap:wrap}.highlight :global(.shiki){padding:16px}}
</style>
