---
interface Props {
  src: string;
  title: string;
  eager?: boolean;
}

const { src, title, eager = false } = Astro.props;
---

<div
  class="plotly-figure"
  data-plotly-figure
  data-plot-src={src}
  data-eager={eager ? 'true' : undefined}
  role="img"
  aria-label={title}
  aria-busy="true"
>
  <p class="plot-status" data-plot-status>Loading interactive figure…</p>
</div>

<script>
  import { mountPlotlyFigures } from '../lib/plotly-figures.js';

  mountPlotlyFigures();
  document.addEventListener('astro:page-load', mountPlotlyFigures);
</script>

<style>
  .plotly-figure{width:100%;height:100%;min-height:320px;background:transparent}
  .plotly-figure.plot-error{display:grid;place-items:center;color:var(--muted);font-size:.84rem}
  .plot-status{display:grid;height:100%;margin:0;place-items:center;color:var(--muted);font-size:.84rem}
</style>
