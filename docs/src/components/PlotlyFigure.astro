---
interface Props {
  src: string;
  title: string;
  eager?: boolean;
}

const { src, title, eager = false } = Astro.props;
---

<div
  class="plotly-figure"
  data-plotly-figure
  data-plot-src={src}
  data-eager={eager ? 'true' : undefined}
  role="img"
  aria-label={title}
  aria-busy="true"
>
  <p class="plot-status" data-plot-status>Loading interactive figure…</p>
  <button class="plot-play" data-plot-play hidden type="button" aria-label="Play animation">
    <span aria-hidden="true">▶</span> <span data-plot-play-label>Play</span>
  </button>
</div>

<script>
  import { mountPlotlyFigures } from '../lib/plotly-figures.js';

  mountPlotlyFigures();
  document.addEventListener('astro:page-load', mountPlotlyFigures);
</script>

<style>
  .plotly-figure{position:relative;width:100%;height:100%;min-height:320px;background:transparent}
  .plotly-figure.plot-error{display:grid;place-items:center;color:var(--muted);font-size:.84rem}
  .plot-status{display:grid;height:100%;margin:0;place-items:center;color:var(--muted);font-size:.84rem}
  .plotly-figure :global(.plot-play){position:absolute;z-index:2;bottom:52px;left:18px;display:flex;align-items:center;gap:8px;padding:10px 17px;border:1px solid color-mix(in srgb,var(--cyan) 70%,white);border-radius:999px;background:var(--cyan);box-shadow:0 5px 18px color-mix(in srgb,var(--ink) 35%,transparent);color:var(--ink);cursor:pointer;font:700 .82rem var(--sans);letter-spacing:.01em;transition:transform .15s ease,box-shadow .15s ease,filter .15s ease}
  .plotly-figure :global(.plot-play:hover){transform:translateY(-2px);box-shadow:0 8px 22px color-mix(in srgb,var(--ink) 45%,transparent);filter:saturate(1.15)}
  .plotly-figure :global(.plot-play:focus-visible){outline:3px solid color-mix(in srgb,var(--cyan) 45%,white);outline-offset:3px}
  .plotly-figure :global(.plot-play span:first-child){font-size:.78rem}
  @media(max-width:720px){.plotly-figure :global(.plot-play){display:none}}
</style>
