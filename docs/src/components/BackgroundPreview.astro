---
const { initialSlug } = Astro.props;
---
<article class="detail" data-background-preview data-slug={initialSlug} aria-live="polite">
  <p class="eyebrow">Kinetic background</p><h2 data-name>Loading…</h2><p class="description" data-summary></p><p class="loading" data-status>Loading distribution data…</p>
  <section class="distribution" data-distribution hidden><h3>Velocity-space distribution</h3><div class="plots" data-plots></div></section>
  <dl class="facts" data-facts></dl>
  <section class="parameters" data-parameters hidden><h3>Constructor defaults</h3><div class="table-wrap"><table><thead><tr><th>Parameter</th><th>Default</th></tr></thead><tbody data-parameter-rows></tbody></table></div></section>
  <div class="actions"><a class="button" data-open>Open plots and parameters →</a><a class="docs-link" data-docs>Reference documentation ↗</a></div>
</article>
<script>
  const svg='http://www.w3.org/2000/svg',value=(input:any)=>Array.isArray(input)?String(input[0]??'—'):input===null?'None':String(input??'—'),range=(items:number[])=>[Math.min(...items),Math.max(...items)] as const;
  const lineFigure=(profile:any)=>{const figure=document.createElement('figure'),chart=document.createElementNS(svg,'svg'),values=profile.values.map(Number),[min,max]=range(values),span=max-min||1;chart.setAttribute('viewBox','0 0 320 170');chart.setAttribute('role','img');chart.setAttribute('aria-label',`Distribution profile along ${profile.axis}`);const frame=document.createElementNS(svg,'rect');frame.setAttribute('x','10');frame.setAttribute('y','10');frame.setAttribute('width','300');frame.setAttribute('height','140');frame.setAttribute('fill','none');frame.setAttribute('stroke','var(--rule)');const line=document.createElementNS(svg,'polyline');line.setAttribute('points',values.map((item:number,index:number)=>`${10+(index/Math.max(1,values.length-1))*300},${150-((item-min)/span)*140}`).join(' '));line.setAttribute('fill','none');line.setAttribute('stroke','var(--cyan)');line.setAttribute('stroke-width','2');chart.append(frame,line);const caption=document.createElement('figcaption');caption.innerHTML=`<strong>${profile.axis}</strong><span>${min.toExponential(2)} to ${max.toExponential(2)}</span>`;figure.append(chart,caption);return figure;};
  const heatmapFigure=(slice:any)=>{const figure=document.createElement('figure'),canvas=document.createElement('canvas'),values=slice.values.map((row:any[])=>row.map(Number)),flat=values.flat(),[min,max]=range(flat),span=max-min||1;canvas.width=480;canvas.height=330;const context=canvas.getContext('2d');if(context){const rows=values.length,columns=values[0]?.length||1;values.forEach((row:number[],y:number)=>row.forEach((item:number,x:number)=>{const t=(item-min)/span;context.fillStyle=`rgb(${Math.round(68+185*t)},${Math.round(1+230*t)},${Math.round(84-47*t)})`;context.fillRect(x*canvas.width/columns,y*canvas.height/rows,Math.ceil(canvas.width/columns),Math.ceil(canvas.height/rows))}));}canvas.setAttribute('role','img');canvas.setAttribute('aria-label',`Distribution heatmap over ${slice.axes.join(' and ')}`);const caption=document.createElement('figcaption');caption.innerHTML=`<strong>f₀(${slice.axes.join(', ')})</strong><span>${min.toExponential(2)} to ${max.toExponential(2)}</span>`;figure.append(canvas,caption);return figure;};
  document.querySelectorAll<HTMLElement>('[data-background-preview]').forEach((root)=>{const name=root.querySelector<HTMLElement>('[data-name]'),summary=root.querySelector<HTMLElement>('[data-summary]'),status=root.querySelector<HTMLElement>('[data-status]'),distribution=root.querySelector<HTMLElement>('[data-distribution]'),plots=root.querySelector<HTMLElement>('[data-plots]'),facts=root.querySelector<HTMLElement>('[data-facts]'),parameters=root.querySelector<HTMLElement>('[data-parameters]'),rows=root.querySelector<HTMLElement>('[data-parameter-rows]'),open=root.querySelector<HTMLAnchorElement>('[data-open]'),docs=root.querySelector<HTMLAnchorElement>('[data-docs]');let request=0;const render=(item:any)=>{if(name)name.textContent=item.className;if(summary)summary.textContent=item.summary;if(open)open.href=`/backgrounds/${root.dataset.slug}/`;if(docs)docs.href=item.docsUrl||'/backgrounds/';if(facts)facts.innerHTML=[['Velocity dimension',item.vdim],['Velocity coordinates',item.velocityCoords||'—'],['Axes',(item.velocityLabels||[]).join(' · ')||'—'],['Volume form',item.volumeForm?'Includes velocity Jacobian':'None']].map(([label,data])=>`<div><dt>${label}</dt><dd>${data}</dd></div>`).join('');if(plots&&distribution){plots.replaceChildren();if(item.slice)plots.append(heatmapFigure(item.slice));(item.profiles||[]).forEach((profile:any)=>plots.append(lineFigure(profile)));distribution.hidden=!plots.childElementCount;}if(parameters&&rows){const entries=Object.entries(item.parameters||{});rows.innerHTML=entries.map(([key,data])=>`<tr><td><code>${key}</code></td><td><code>${value(data)}</code></td></tr>`).join('');parameters.hidden=!entries.length;}if(status)status.hidden=true;};const load=async(slug:string)=>{const current=++request;if(status){status.hidden=false;status.textContent='Loading distribution data…';}try{const response=await fetch(`/catalogue-data/backgrounds/${slug}.json`);if(!response.ok)throw new Error(String(response.status));const item=await response.json();if(current===request)render(item);}catch(error){console.error('Unable to load kinetic background:',error);if(status)status.textContent='Distribution data could not be loaded.';}};root.addEventListener('background-preview-change',((event:CustomEvent)=>{const slug=event.detail?.slug;if(slug){root.dataset.slug=slug;load(slug);}}) as EventListener);load(root.dataset.slug||'');});
</script>
<style>
  .detail{min-width:0;padding:28px;border:1px solid var(--rule)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}.detail h2{margin:0 0 14px;font-size:clamp(1.6rem,3vw,2.2rem);overflow-wrap:anywhere}.description,.loading{max-width:680px;color:var(--muted)}.distribution,.parameters{margin-top:28px;padding-top:22px;border-top:1px solid var(--rule)}h3{margin:0 0 12px;font-size:1rem}.plots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.plots :global(figure){margin:0}.plots :global(canvas),.plots :global(svg){display:block;width:100%;height:auto;border:1px solid var(--rule);background:var(--plot-bg)}.plots :global(figcaption){display:flex;justify-content:space-between;gap:10px;margin-top:6px;color:var(--muted);font-size:.76rem}.plots :global(figcaption strong){color:var(--paper)}.facts{display:grid;grid-template-columns:repeat(2,1fr);margin:28px 0 0;border-top:1px solid var(--rule)}.facts :global(div){padding:16px 20px 0 0}.facts :global(div:nth-child(even)){padding-left:20px;border-left:1px solid var(--rule)}.facts :global(dt){font-weight:700}.facts :global(dd){margin:4px 0 0;color:var(--muted)}.table-wrap{overflow-x:auto;border:1px solid var(--rule)}table{width:100%;border-collapse:collapse;font-size:.82rem}th,td{padding:9px 12px;border-bottom:1px solid var(--rule);text-align:left}th{color:var(--muted);font:.7rem var(--mono);text-transform:uppercase}tbody tr:last-child td{border-bottom:0}td code{color:var(--paper)}.actions{display:flex;flex-wrap:wrap;gap:18px;margin-top:28px;align-items:center}.button{display:inline-block;padding:10px 15px;border:1px solid var(--cyan);color:var(--cyan);font-weight:650;text-decoration:none}.button:hover{background:var(--cyan);color:var(--ink)}.docs-link{color:var(--cyan)}@media(max-width:700px){.plots,.facts{grid-template-columns:1fr}.facts :global(div:nth-child(even)){padding-left:0;border-left:0}.facts :global(div){padding-bottom:14px;border-bottom:1px solid var(--rule)}}
</style>
