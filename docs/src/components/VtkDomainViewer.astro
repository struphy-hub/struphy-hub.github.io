---
interface DomainEntry { name: string; url?: string; docsUrl: string; unavailableReason?: string; }
interface Props { domains: DomainEntry[]; initialDomain: string; }
const { domains, initialDomain } = Astro.props;
---

<div class="domain-browser" data-domain-browser data-domains={JSON.stringify(domains)} data-initial-domain={initialDomain}>
  <aside class="domain-index" aria-label="Available Struphy domains">
    <p>Domain classes</p>
    <ul>{domains.map((domain) => <li><button type="button" class="domain-option" data-domain-name={domain.name} aria-label={`View ${domain.name} geometry`} aria-pressed={domain.name === initialDomain ? 'true' : 'false'} disabled={!domain.url} title={domain.unavailableReason}><code>{domain.name}</code></button></li>)}</ul>
  </aside>
  <figure aria-labelledby="domain-caption">
    <div class="slice-tabs" role="tablist" aria-label="Domain view"><button type="button" role="tab" aria-selected="true" data-view-mode="3d">3D</button><button type="button" role="tab" aria-selected="false" data-slice-plane="xy">XY</button><button type="button" role="tab" aria-selected="false" data-slice-plane="xz">XZ</button><button type="button" role="tab" aria-selected="false" data-slice-plane="yz">YZ</button></div>
    <div class="viewer" data-vtk-viewer role="img" aria-label={`Interactive ${initialDomain} domain. Drag to rotate, scroll to zoom, and shift-drag to pan.`}>
      <p class="status" data-vtk-status role="status" aria-live="polite">Loading {initialDomain}…</p>
    </div>
    <div class="slice-view" data-slice-view hidden role="img" aria-label="2D domain grid slice"><svg viewBox="0 0 600 420" preserveAspectRatio="xMidYMid meet"><g data-grid-lines></g></svg></div>
    <div class="viewer-details">
      <figcaption id="domain-caption"><strong data-domain-caption>{initialDomain}</strong> — generated and exported by Struphy. <a data-domain-docs href={domains.find((domain) => domain.name === initialDomain)?.docsUrl} target="_blank" rel="noreferrer">Read the docs ↗</a><span>Drag to rotate · Scroll to zoom · Shift-drag to pan</span></figcaption>
      <button type="button" class="reset" data-vtk-reset disabled>Reset view</button>
    </div>
  </figure>
</div>

<script>
  import '@kitware/vtk.js/Rendering/Profiles/Geometry';
  import vtkGenericRenderWindow from '@kitware/vtk.js/Rendering/Misc/GenericRenderWindow';
  import vtkActor from '@kitware/vtk.js/Rendering/Core/Actor';
  import vtkMapper from '@kitware/vtk.js/Rendering/Core/Mapper';
  import vtkXMLPolyDataReader from '@kitware/vtk.js/IO/XML/XMLPolyDataReader';
  import vtkPlane from '@kitware/vtk.js/Common/DataModel/Plane';
  import vtkCutter from '@kitware/vtk.js/Filters/Core/Cutter';

  type DomainEntry = { name: string; url?: string; docsUrl: string };
  type Cleanup = () => void;
  const cleanups = new Map<HTMLElement, Cleanup>();

  async function setup(root: HTMLElement): Promise<Cleanup> {
    const container = root.querySelector<HTMLElement>('[data-vtk-viewer]');
    const status = root.querySelector<HTMLElement>('[data-vtk-status]');
    const reset = root.querySelector<HTMLButtonElement>('[data-vtk-reset]');
    const caption = root.querySelector<HTMLElement>('[data-domain-caption]');
    const docsLink = root.querySelector<HTMLAnchorElement>('[data-domain-docs]');
    const options = [...root.querySelectorAll<HTMLButtonElement>('[data-domain-name]')];
    const sliceTabs = [...root.querySelectorAll<HTMLButtonElement>('[data-slice-plane]')];
    const view3d = root.querySelector<HTMLButtonElement>('[data-view-mode="3d"]');
    const sliceView = root.querySelector<HTMLElement>('[data-slice-view]');
    const gridLines = root.querySelector<SVGGElement>('[data-grid-lines]');
    if (!container || !status || !reset || !caption || !docsLink || !sliceView || !gridLines) return () => {};
    const domains = JSON.parse(root.dataset.domains || '[]') as DomainEntry[];
    const byName = new Map(domains.map((d) => [d.name, d]));
    const grw = vtkGenericRenderWindow.newInstance({ background: [0.027, 0.075, 0.114] });
    grw.setContainer(container); grw.resize();
    const renderer = grw.getRenderer();
    const renderWindow = grw.getRenderWindow();
    const mapper = vtkMapper.newInstance();
    const plane = vtkPlane.newInstance();
    const cutter = vtkCutter.newInstance({ cutFunction: plane });
    const actor = vtkActor.newInstance();
    actor.setMapper(mapper);
    actor.getProperty().setColor(0.39, 0.93, 0.9);
    actor.getProperty().setOpacity(0.9);
    actor.getProperty().setEdgeVisibility(true);
    actor.getProperty().setEdgeColor(0.39, 0.93, 0.9);
    actor.getProperty().setLineWidth(1.2);
    let actorAdded = false;
    let reader: ReturnType<typeof vtkXMLPolyDataReader.newInstance> | undefined;
    let cameraState: any;
    let activeView = '3d';
    let activeDomain = root.dataset.initialDomain || '';
    let aborter: AbortController | undefined;
    let serial = 0;
    let disposed = false;

    const resetView = () => {
      if (!cameraState) return;
      const c = renderer.getActiveCamera();
      c.setPosition(...cameraState.position); c.setFocalPoint(...cameraState.focalPoint);
      c.setViewUp(...cameraState.viewUp); c.setParallelProjection(cameraState.parallelProjection);
      c.setParallelScale(cameraState.parallelScale); c.setViewAngle(cameraState.viewAngle);
      renderer.resetCameraClippingRange(); renderWindow.render();
    };
    const setPlane = (planeName: string) => {
      activeView = planeName;
      const c = renderer.getActiveCamera();
      const focal = c.getFocalPoint(); const distance = Math.max(1, c.getDistance());
      const positions: Record<string, [number, number, number]> = { xy: [0, 0, 1], xz: [0, 1, 0], yz: [1, 0, 0] };
      const direction = positions[planeName] || positions.xy;
      plane.setNormal(...direction); cutter.update(); mapper.setInputConnection(cutter.getOutputPort()); void drawGrid(activeDomain, planeName);
      container.hidden = true; sliceView.hidden = false;
      c.setPosition(focal[0] + direction[0] * distance, focal[1] + direction[1] * distance, focal[2] + direction[2] * distance);
      c.setViewUp(planeName === 'yz' ? [0, 0, 1] : [0, 1, 0]); renderer.resetCamera(); renderer.resetCameraClippingRange(); renderWindow.render();
      sliceTabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.slicePlane === planeName)));
      view3d?.setAttribute('aria-selected', 'false');
    };
    const show3d = () => { if (!reader) return; activeView = '3d'; sliceView.hidden = true; container.hidden = false; mapper.setInputData(reader.getOutputData(0)); renderer.resetCamera(); renderWindow.render(); view3d?.setAttribute('aria-selected', 'true'); sliceTabs.forEach((tab) => tab.setAttribute('aria-selected', 'false')); };
    const drawGrid = async (name: string, planeName: string) => {
      const requestedDomain = name;
      const requestedView = planeName;
      const response = await fetch(`/domains/${name}-${planeName}.json`);
      if (!response.ok || requestedDomain !== activeDomain || requestedView !== activeView) return;
      const data = await response.json() as {
        grids: Array<{
          a: number[][];
          b: number[][];
          highlight_rows: number[];
          markers: Array<[number, number]>;
          omit_last_column: boolean;
        }>;
      };
      const valuesA = data.grids.flatMap((grid) => grid.a.flat());
      const valuesB = data.grids.flatMap((grid) => grid.b.flat());
      const minA = Math.min(...valuesA), maxA = Math.max(...valuesA);
      const minB = Math.min(...valuesB), maxB = Math.max(...valuesB);
      const width = maxA - minA || 1;
      const height = maxB - minB || 1;
      const scale = Math.min(540 / width, 360 / height);
      const offsetX = (600 - width * scale) / 2;
      const offsetY = (420 - height * scale) / 2;
      const sx = (value: number) => offsetX + (value - minA) * scale;
      const sy = (value: number) => 420 - offsetY - (value - minB) * scale;
      gridLines.innerHTML = '';

      const addDot = (a: number, b: number) => {
        const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        dot.setAttribute('cx', String(sx(a)));
        dot.setAttribute('cy', String(sy(b)));
        dot.setAttribute('r', '4');
        dot.setAttribute('fill', '#e85d5d');
        gridLines.appendChild(dot);
      };
      const addLine = (points: Array<[number, number]>, highlight = false) => {
        const spanA = Math.max(...points.map(([a]) => a)) - Math.min(...points.map(([a]) => a));
        const spanB = Math.max(...points.map(([, b]) => b)) - Math.min(...points.map(([, b]) => b));
        if (highlight && Math.hypot(spanA, spanB) < 1e-12) {
          addDot(points[0][0], points[0][1]);
          return;
        }
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
        line.setAttribute('points', points.map(([a, b]) => `${sx(a)},${sy(b)}`).join(' '));
        line.setAttribute('fill', 'none');
        line.setAttribute('stroke', highlight ? '#e85d5d' : '#63eee6');
        line.setAttribute('stroke-opacity', highlight ? '1' : '.55');
        line.setAttribute('stroke-width', highlight ? '2' : '1');
        gridLines.appendChild(line);
      };

      data.grids.forEach((grid) => {
        const highlighted = new Set(grid.highlight_rows);
        grid.a.forEach((row, rowIndex) => {
          addLine(row.map((a, columnIndex) => [a, grid.b[rowIndex][columnIndex]]), highlighted.has(rowIndex));
        });
        const columnCount = grid.a[0].length - (grid.omit_last_column ? 1 : 0);
        for (let columnIndex = 0; columnIndex < columnCount; columnIndex += 1) {
          addLine(grid.a.map((row, rowIndex) => [row[columnIndex], grid.b[rowIndex][columnIndex]]));
        }
        grid.markers.forEach(([row, column]) => addDot(grid.a[row][column], grid.b[row][column]));
      });
    };
    const load = async (name: string) => {
      const domain = byName.get(name);
      if (!domain?.url || disposed) return;
      aborter?.abort(); aborter = new AbortController();
      const current = ++serial;
      status.hidden = false; status.classList.remove('error'); status.textContent = `Loading ${name}…`; reset.disabled = true;
      try {
        const response = await fetch(domain.url, { signal: aborter.signal });
        if (!response.ok) throw new Error(`Domain file returned ${response.status}`);
        const nextReader = vtkXMLPolyDataReader.newInstance();
        nextReader.parseAsArrayBuffer(await response.arrayBuffer());
        const data = nextReader.getOutputData(0);
        if (!data || data.getNumberOfPoints() === 0) { nextReader.delete(); throw new Error('No renderable points'); }
        if (disposed || current !== serial) { nextReader.delete(); return; }
        const bounds = data.getBounds();
        plane.setOrigin((bounds[0] + bounds[1]) / 2, (bounds[2] + bounds[3]) / 2, (bounds[4] + bounds[5]) / 2);
        cutter.setInputData(data); mapper.setInputData(data); cutter.update(); reader?.delete(); reader = nextReader;
        activeDomain = name;
        if (!actorAdded) { renderer.addActor(actor); actorAdded = true; }
        const c = renderer.getActiveCamera();
        renderer.resetCamera(); c.zoom(1.15); renderer.resetCameraClippingRange();
        cameraState = { position: [...c.getPosition()], focalPoint: [...c.getFocalPoint()], viewUp: [...c.getViewUp()], parallelProjection: c.getParallelProjection(), parallelScale: c.getParallelScale(), viewAngle: c.getViewAngle() };
        options.forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.domainName === name)));
        if (activeView === '3d') show3d(); else { container.hidden = true; sliceView.hidden = false; void drawGrid(activeDomain, activeView); }
        caption.textContent = name;
        docsLink.href = domain.docsUrl;
        container.setAttribute('aria-label', `Interactive ${name} domain. Drag to rotate, scroll to zoom, and shift-drag to pan.`);
        status.hidden = true; reset.disabled = false;
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        console.error(`Unable to load ${name}:`, error);
        status.textContent = `${name} could not be loaded. Try selecting it again.`; status.classList.add('error');
      }
    };
    const handlers = options.map((option) => {
      const handler = () => load(option.dataset.domainName || '');
      option.addEventListener('click', handler); return [option, handler] as const;
    });
    reset.addEventListener('click', resetView);
    const sliceHandlers = sliceTabs.map((tab) => { const handler = () => setPlane(tab.dataset.slicePlane || 'xy'); tab.addEventListener('click', handler); return [tab, handler] as const; });
    const modeHandler = () => show3d(); view3d?.addEventListener('click', modeHandler);
    const observer = new ResizeObserver(() => { if (!disposed) { grw.resize(); renderWindow.render(); } });
    observer.observe(container);
    await load(root.dataset.initialDomain || domains.find((d) => d.url)?.name || '');
    return () => {
      disposed = true; aborter?.abort(); observer.disconnect(); reset.removeEventListener('click', resetView);
      handlers.forEach(([o, h]) => o.removeEventListener('click', h));
      sliceHandlers.forEach(([tab, handler]) => tab.removeEventListener('click', handler));
      view3d?.removeEventListener('click', modeHandler);
      if (actorAdded) renderer.removeActor(actor);
      reader?.delete(); actor.delete(); cutter.delete(); plane.delete(); mapper.delete(); grw.delete();
    };
  }
  function initialise() {
    document.querySelectorAll<HTMLElement>('[data-domain-browser]').forEach((root) => {
      if (!cleanups.has(root)) setup(root).then((cleanup) => cleanups.set(root, cleanup));
    });
  }
  initialise();
  document.addEventListener('astro:page-load', initialise);
  document.addEventListener('astro:before-swap', () => { cleanups.forEach((c) => c()); cleanups.clear(); });
</script>

<style>
  .domain-browser { display:grid; grid-template-columns:minmax(210px,.34fr) minmax(0,1fr); gap:clamp(28px,5vw,56px); align-items:start; }
  .slice-tabs { display:flex; gap:0 24px; margin-bottom:12px; border-bottom:1px solid var(--rule); }
  .slice-tabs button { padding:9px 0 7px; border:0; border-bottom:2px solid transparent; background:none; color:var(--muted); cursor:pointer; font:inherit; font-size:.82rem; }
  .slice-tabs button[aria-selected="true"] { border-bottom-color:var(--cyan); color:var(--paper); }
  .domain-index p { margin:0 0 10px; color:var(--muted); font-size:.82rem; }
  ul { margin:0; padding:0; border-top:1px solid var(--rule); list-style:none; }
  li { border-bottom:1px solid var(--rule); }
  .domain-index li { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:12px; padding:9px 0; }
  .domain-index a { min-width:0; overflow-wrap:anywhere; color:var(--cyan); font-size:.88rem; }
  .domain-index a:hover { color:var(--paper); text-decoration-thickness:2px; text-underline-offset:.2em; }
  .domain-index a:focus-visible { outline:2px solid var(--paper); outline-offset:3px; }
  .domain-index button { padding:3px 7px; border:1px solid var(--cyan); border-radius:0; background:transparent; color:var(--cyan); font:inherit; font-size:.72rem; cursor:pointer; }
  .domain-index button:hover:not(:disabled), .domain-index button[aria-pressed="true"] { background:var(--cyan); color:var(--ink); }
  button:focus-visible { outline:2px solid var(--paper); outline-offset:3px; }
  .domain-index button:disabled { color:var(--muted); cursor:not-allowed; opacity:.62; }
  .domain-index small { grid-column:1 / -1; margin-top:-5px; font-size:.7rem; }
  figure { min-width:0; margin:0; }
  .viewer { position:relative; width:100%; height:clamp(400px,46vw,520px); overflow:hidden; border:1px solid var(--rule); background:var(--ink); touch-action:none; }
  .viewer :global(canvas) { display:block; width:100%; height:100%; }
  .status { position:absolute; inset:0; z-index:1; display:grid; place-items:center; margin:0; padding:24px; color:var(--muted); text-align:center; pointer-events:none; }
  .status.error { color:var(--paper); } .status[hidden] { display:none; }
  .viewer-details { display:flex; align-items:start; justify-content:space-between; gap:24px; margin-top:12px; }
  figcaption { color:var(--muted); font-size:.85rem; } figcaption strong { color:var(--paper); } figcaption span { display:block; margin-top:3px; }
  .reset { flex:none; padding:7px 12px; border:1px solid var(--cyan); border-radius:0; background:transparent; color:var(--cyan); font:inherit; font-size:.82rem; cursor:pointer; }
  .reset:hover:not(:disabled) { background:var(--cyan); color:var(--ink); } .reset:disabled { opacity:.45; cursor:wait; }
  @media(max-width:760px) { .domain-browser { grid-template-columns:1fr; } .domain-index ul { columns:2; column-gap:24px; } .domain-index li { break-inside:avoid; } .viewer { height:clamp(320px,92vw,400px); } }
  @media(max-width:440px) { .domain-index ul { columns:1; } .viewer-details { align-items:stretch; flex-direction:column; gap:12px; } .reset { align-self:flex-start; } }
</style>
<style>
  .slice-view { width:100%; height:clamp(400px,46vw,520px); border:1px solid var(--rule); background:var(--ink); }
  .slice-view svg { width:100%; height:100%; }
  .slice-view[hidden] { display:none; }
</style>
<style>
  .domain-index ul { max-height: 600px; overflow: auto; }
  .domain-index li { display: block; padding: 0; }
  .domain-index .domain-option { display: block; width: 100%; padding: 11px 8px; border: 0; border-bottom: 1px solid var(--rule); background: none; color: var(--cyan); text-align: left; cursor: pointer; }
  .domain-option code { display: block; color: inherit; font: 600 .87rem/1.45 var(--mono); }
  .domain-option small { display: block; margin-top: 2px; color: var(--muted); font: .72rem var(--mono); }
  .domain-option:hover:not(:disabled), .domain-option:focus-visible, .domain-option[aria-pressed="true"] { background: rgba(99,238,230,.12); color: var(--paper); }
  .domain-option[aria-pressed="true"] { border-left: 2px solid var(--cyan); padding-left: 6px; }
  .domain-option:disabled { color: var(--muted); cursor: not-allowed; opacity: .62; }
  .domain-index .domain-option + small { display: none; }
  figcaption a { color: var(--cyan); }
  @media(max-width:760px) { .domain-index ul { columns: 2; max-height: none; } .domain-index li { break-inside: avoid; } }
  @media(max-width:440px) { .domain-index ul { columns: 1; } }
</style>
