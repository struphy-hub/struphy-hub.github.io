---
import PlotlyFigure from './PlotlyFigure.astro';
import type { ExampleFigureText } from '../data/example-config';

// The additional figures of an example: the `figures` list of its metadata. run_example.py writes the
// files of each; the alt text and caption are in example-config.ts by key (older scripts write them
// into the metadata themselves, with `save_extra_figure` of struphy_plots.gallery).
interface ExampleFigure {
  key: string;
  interactive: string;
  thumbnail: string;
  alt?: string;
  caption?: string;
}

const { figures: entries = [], texts = {} } = Astro.props as {
  figures?: ExampleFigure[];
  texts?: Record<string, ExampleFigureText>;
};
const figures = entries.map((figure) => ({
  ...figure,
  alt: figure.alt ?? texts[figure.key]?.alt ?? '',
  caption: figure.caption ?? texts[figure.key]?.caption ?? '',
}));
const htmlHref = (interactive: string) => interactive.replace(/\.plotly\.json$/, '.html');
---

{figures.map((figure) => (
  <figure class="extra">
    <div class="plot-frame"><PlotlyFigure src={figure.interactive.replace(/\.html$/, '.plotly.json')} title={figure.alt} /></div>
    <img class="plot-static" src={figure.thumbnail} alt={figure.alt} width="2200" height="1300" />
    <figcaption>
      {figure.caption}
      <a class="figure-link" href={htmlHref(figure.interactive)} target="_blank" rel="noopener noreferrer">Open graph in a new tab ↗</a>
    </figcaption>
  </figure>
))}

<style>
  .extra{margin:0;padding-block:40px 52px;border-top:1px solid var(--rule)}
  .plot-frame{display:grid;width:min(100%,1100px);aspect-ratio:1100/650;margin-inline:auto}
  .extra img{display:block;width:min(100%,1100px);height:auto;margin-inline:auto;border:1px solid var(--rule);background:#fff}
  .extra figcaption{width:min(100%,1100px);margin:10px auto 0;color:var(--muted);font-size:.84rem}
  .figure-link{margin-left:.55rem;color:var(--cyan);white-space:nowrap}
  /* Phones show the rendered PNG instead of the Plotly page; ExamplePage.astro swaps them. */
  .extra .plot-static{display:none}
  @media(max-width:720px){.extra .plot-frame{display:none}.extra .plot-static{display:block}}
</style>
