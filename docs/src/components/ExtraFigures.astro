---
import PlotlyFigure from './PlotlyFigure.astro';

// The additional figures of an example: the `figures` list that its script writes to its
// metadata with `save_extra_figure` (docs/src/examples/_gallery.py).
interface ExampleFigure {
  key: string;
  interactive: string;
  thumbnail: string;
  alt: string;
  caption: string;
}

const { figures = [] } = Astro.props as { figures?: ExampleFigure[] };
---

{figures.map((figure) => (
  <figure class="extra">
    <div class="plot-frame"><PlotlyFigure src={figure.interactive.replace(/\.html$/, '.plotly.json')} title={figure.alt} /></div>
    <img class="plot-static" src={figure.thumbnail} alt={figure.alt} width="2200" height="1300" />
    <figcaption>{figure.caption}</figcaption>
  </figure>
))}

<style>
  .extra{margin:0;padding-block:40px 52px;border-top:1px solid var(--rule)}
  .plot-frame{width:min(100%,1100px);aspect-ratio:1100/650;margin-inline:auto}
  .extra img{display:block;width:min(100%,1100px);height:auto;margin-inline:auto;border:1px solid var(--rule);background:#fff}
  .extra figcaption{width:min(100%,1100px);margin:10px auto 0;color:var(--muted);font-size:.84rem}
  /* Phones show the rendered PNG instead of the Plotly page; ExamplePage.astro swaps them. */
  .extra .plot-static{display:none}
  @media(max-width:720px){.extra .plot-frame{display:none}.extra .plot-static{display:block}}
</style>
