---
const { title = 'Struphy — Structure-preserving plasma physics', description = 'An open-source Python package for structure-preserving simulations of plasma physics PDEs.' } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#07131d" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" /><meta name="generator" content={Astro.generator} /><title>{title}</title></head><body><slot /></body></html>
<style is:global>
:root{color-scheme:dark}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:#07131d}a,button{-webkit-tap-highlight-color:transparent}:focus-visible{outline:2px solid #63eee6;outline-offset:4px}::selection{color:#07131d;background:#63eee6}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important}}
</style>
