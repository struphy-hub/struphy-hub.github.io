---
const { title = 'Struphy — Structure-preserving plasma physics', description = 'An open-source Python package for structure-preserving simulations of plasma physics PDEs.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2e8" />
    <script is:inline>
      (() => {
        let storedTheme = null;
        try { storedTheme = localStorage.getItem('struphy-theme'); } catch {}
        const theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          theme === 'light' ? '#f5f2e8' : '#07131d',
        );
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <button class="theme-toggle" type="button" aria-label="Switch color theme"></button>
    <script>
      const THEME_KEY = 'struphy-theme';

      function setTheme(theme: 'light' | 'dark', persist = false) {
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          theme === 'light' ? '#f5f2e8' : '#07131d',
        );

        const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
        if (toggle) {
          const nextTheme = theme === 'light' ? 'dark' : 'light';
          const label = `Switch to ${nextTheme} mode`;
          toggle.textContent = nextTheme === 'light' ? 'Light' : 'Dark';
          toggle.setAttribute('aria-label', label);
          toggle.title = label;
          toggle.setAttribute('aria-pressed', String(theme === 'light'));
        }

        if (persist) {
          try { localStorage.setItem(THEME_KEY, theme); } catch {}
        }
      }

      function mountThemeToggle() {
        const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
        const nav = document.querySelector<HTMLElement>('.site-header nav');
        if (!toggle) return;
        if (nav && toggle.parentElement !== nav) nav.append(toggle);

        const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        setTheme(theme);
        toggle.onclick = () => {
          const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
          setTheme(current === 'light' ? 'dark' : 'light', true);
        };
      }

      mountThemeToggle();
      document.addEventListener('astro:page-load', mountThemeToggle);
      document.addEventListener('astro:after-swap', mountThemeToggle);
    </script>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light;
    --ink: #f5f2e8;
    --paper: #10222d;
    --cyan: #087f7b;
    --muted: #52646b;
    --rule: rgba(16, 34, 45, 0.2);
    --accent-wash: rgba(8, 127, 123, 0.1);
    --code-bg: #e8e5dc;
    --plot-bg: #e9ede8;
  }

  html[data-theme='dark'] {
    color-scheme: dark;
    --ink: #07131d;
    --paper: #eeeadd;
    --cyan: #63eee6;
    --muted: #a9b7bb;
    --rule: rgba(238, 234, 221, 0.2);
    --accent-wash: rgba(99, 238, 230, 0.12);
    --code-bg: #0b1a25;
    --plot-bg: #112c34;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; background: var(--ink); }
  a, button { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; }
  ::selection { color: var(--ink); background: var(--cyan); }

  .theme-toggle {
    flex: none;
    padding: 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .theme-toggle:hover { color: var(--paper); }
  .theme-toggle:focus-visible { outline-color: var(--cyan); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *:before, *:after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
  }
</style>
