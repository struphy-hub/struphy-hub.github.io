---
import Layout from '../../../layouts/Layout.astro';
import maxwellWave from '../../../examples/maxwell-wave.py?raw';
import { codeToHtml } from 'shiki';

const highlightedSource = await codeToHtml(maxwellWave, {
  lang: 'python',
  themes: { light: 'github-light', dark: 'github-dark' },
  defaultColor: false,
});
---

<Layout title="Maxwell light-wave dispersion — Struphy Examples" description="A complete Struphy Maxwell simulation measuring the numerical light-wave dispersion relation.">
  <main>
    <header class="intro">
      <p class="eyebrow">Maxwell · Electromagnetic waves</p>
      <h1>Maxwell light-wave dispersion</h1>
      <p>Excite a broadband electric field and recover the vacuum dispersion relation ω = ck with Struphy’s FEEC Maxwell solver.</p>
      <a class="back" href="/examples/">← All examples</a>
    </header>

    <figure class="result">
      <div class="plot-frame"><iframe src="/examples/maxwell-dispersion.html" title="Interactive Plotly power spectrum of the Struphy Maxwell simulation" loading="eager"></iframe></div>
      <noscript><img src="/images/examples/maxwell-dispersion.png" alt="Power spectrum of a simulated Struphy Maxwell simulation, with the fitted numerical branch closely following the exact light-wave dispersion line" width="2200" height="1300" /></noscript>
      <figcaption>Actual output from the script below. The fitted numerical branch gives c = 0.98324, compared with the normalized exact value c = 1.</figcaption>
    </figure>

    <section class="explanation" aria-labelledby="setup-title">
      <div>
        <p class="eyebrow">Physical problem</p>
        <h2 id="setup-title">A broadband vacuum light wave</h2>
        <p>Small deterministic noise perturbations excite several modes of the electric field in a periodic one-dimensional domain. A two-dimensional Fourier spectrum reveals the numerical relation between angular frequency and wavenumber.</p>
        <div class="equations" aria-label="Maxwell equations and light-wave dispersion relation">
          <span>∂ₜE − ∇ × B = 0</span>
          <span>∂ₜB + ∇ × E = 0</span>
          <strong>ω = ck</strong>
        </div>
      </div>
      <dl>
        <div><dt>Model</dt><dd>Maxwell</dd></div>
        <div><dt>Domain</dt><dd>Cuboid, Lz = 20</dd></div>
        <div><dt>Grid</dt><dd>1 × 1 × 128</dd></div>
        <div><dt>FEEC degree</dt><dd>1 × 1 × 3</dd></div>
        <div><dt>Integrator</dt><dd>Implicit</dd></div>
        <div><dt>Evolution</dt><dd>1,000 steps</dd></div>
        <div><dt>Visualization</dt><dd>Plotly</dd></div>
      </dl>
    </section>

    <section class="source" aria-labelledby="source-title">
      <div class="source-heading">
        <div><p class="eyebrow">Complete source</p><h2 id="source-title">Run the simulation</h2></div>
        <div class="source-actions"><button type="button" data-copy>Copy script</button><a href="/examples/maxwell-wave.py" download>Download .py</a></div>
      </div>
      <p class="requirements">Requires Struphy 3.2 with compiled kernels and Plotly. Run <code>struphy compile</code> once, then execute <code>python maxwell-wave.py</code>.</p>
      <div class="highlight" data-source set:html={highlightedSource}></div>
      <p class="provenance">Adapted from Struphy’s maintained <a href="https://github.com/struphy-hub/struphy/blob/devel/src/struphy/models/tests/verification/test_verif_Maxwell.py">Maxwell verification test</a>. See the <a href="https://struphy-hub.github.io/struphy/sections/userguide.html#post-processing-and-visualization">post-processing guide</a> for more ways to inspect the result.</p>
    </section>
  </main>
</Layout>

<script>
  function mountCopyButton() {
    const button=document.querySelector<HTMLButtonElement>('[data-copy]');
    const source=document.querySelector<HTMLElement>('[data-source]');
    if(!button||!source)return;
    button.onclick=async()=>{try{await navigator.clipboard.writeText(source.textContent||'');button.textContent='Copied'}catch{button.textContent='Copy failed'}setTimeout(()=>{button.textContent='Copy script'},1800)};
  }
  mountCopyButton();
  document.addEventListener('astro:page-load',mountCopyButton);
</script>

<style>
  .intro{max-width:850px;padding-block:clamp(52px,7vw,84px)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}h1{margin:0 0 18px;font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.08;letter-spacing:-.035em}.intro>p:not(.eyebrow){color:var(--muted);font-size:1.05rem}.back{display:inline-block;margin-top:12px;color:var(--cyan)}
  .result{margin:0;padding-block:40px 52px;border-top:1px solid var(--rule)}.plot-frame{width:min(100%,1100px);aspect-ratio:1100/650;margin-inline:auto}.result iframe{display:block;width:100%;height:100%;border:1px solid var(--rule);background:#fff}.result img{display:block;width:min(100%,1100px);height:auto;margin-inline:auto;border:1px solid var(--rule);background:#fff}.result figcaption{width:min(100%,1100px);margin:10px auto 0;color:var(--muted);font-size:.84rem}
  .explanation,.source{padding-block:clamp(44px,7vw,68px);border-top:1px solid var(--rule)}.explanation{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.48fr);gap:clamp(40px,8vw,100px)}h2{margin:0 0 14px;font-size:clamp(1.55rem,3vw,2.1rem)}.explanation>div>p:not(.eyebrow),.requirements,.provenance{color:var(--muted)}.equations{display:grid;gap:7px;margin-top:24px;padding:18px 20px;border-left:2px solid var(--cyan);background:var(--accent-wash);font:1rem var(--mono)}.equations strong{margin-top:5px;color:var(--cyan)}
  dl{margin:0;border-top:1px solid var(--rule)}dl div{display:flex;justify-content:space-between;gap:24px;padding:10px 0;border-bottom:1px solid var(--rule)}dt{color:var(--muted);font-size:.82rem}dd{margin:0;text-align:right;font:700 .8rem var(--mono)}
  .source-heading{display:flex;align-items:end;justify-content:space-between;gap:24px}.source-actions{display:flex;gap:12px}.source-actions button,.source-actions a{padding:8px 12px;border:1px solid var(--cyan);background:none;color:var(--cyan);cursor:pointer;font:650 .78rem var(--sans);text-decoration:none}.source-actions button:hover,.source-actions a:hover{background:var(--accent-wash)}.requirements code{color:var(--paper)}.highlight{max-height:720px;margin:24px 0 0;overflow:auto;border:1px solid var(--rule);background:var(--code-bg)}.highlight :global(.shiki){min-width:max-content;margin:0;padding:22px;background:var(--code-bg)!important;font:.79rem/1.65 var(--mono);tab-size:4}.highlight :global(.shiki code){display:block}.provenance{font-size:.82rem}.provenance a{color:var(--cyan)}
  :global(html[data-theme='dark'] .highlight .shiki),:global(html[data-theme='dark'] .highlight .shiki span){color:var(--shiki-dark)!important}
  @media(max-width:720px){.explanation{grid-template-columns:1fr}.source-heading{align-items:flex-start;flex-direction:column}.source-actions{flex-wrap:wrap}.highlight :global(.shiki){padding:16px}}
</style>
