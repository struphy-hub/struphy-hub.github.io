---
import Layout from '../../../layouts/Layout.astro';
import strongLandauDamping from '../../../examples/strong-landau-damping.py?raw';
import data from '../../../../public/examples/strong-landau-damping.metadata.json';
import { codeToHtml } from 'shiki';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import { toSlug } from '../../../lib/catalogue';

function pdeMarkdownToHtml(markdown: string): string {
  return markdown
    .split(/\$\$([\s\S]*?)\$\$/g)
    .map((part, i) => {
      if (i % 2 === 1) {
        let rendered;
        try {
          rendered = katex.renderToString(part.trim(), { displayMode: true, throwOnError: false, strict: false, output: 'html' });
        } catch {
          rendered = `<code>${part}</code>`;
        }
        return `<div class="math-display">${rendered}</div>`;
      }
      return part
        .split(/\n{2,}/)
        .map((p) => p.trim())
        .filter(Boolean)
        .map((p) => `<p>${p.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/:math:`([^`]+)`/g, (_m, latex) => {
          try {
            return katex.renderToString(latex, { throwOnError: false, strict: false, output: 'html' });
          } catch {
            return `<code>${latex}</code>`;
          }
        })}</p>`)
        .join('');
    })
    .join('');
}

const equationsHtml = pdeMarkdownToHtml(data.equationsMarkdown);

const highlightedSource = await codeToHtml(strongLandauDamping, {
  lang: 'python',
  themes: { light: 'github-light', dark: 'github-dark' },
  defaultColor: false,
});
---

<Layout title={`${data.name} — Struphy Examples`} description={data.description}>
  <main>
    <header class="intro">
      <p class="eyebrow"><a href={`/models/${toSlug(data.model)}/`}>{data.model}</a> · Kinetic electrostatics</p>
      <h1>{data.name}</h1>
      <p>{data.description}</p>
      <a class="back" href="/examples/">← All examples</a>
    </header>

    <figure class="result">
      <div class="plot-frame"><iframe src="/examples/strong-landau-damping.html" title="Interactive Plotly plot of the electric field energy in strong Landau damping" loading="eager"></iframe></div>
      <noscript><img src="/images/examples/strong-landau-damping.png" alt="Electric field energy damping sharply at first, then re-growing and bouncing as trapped particles oscillate in the wave's potential wells" width="2200" height="1300" /></noscript>
      <figcaption>Actual output from the script below. After the initial (linear) damping phase, trapped particles re-drive the field, producing a recurring bounce with a period of roughly {data.bouncePeriod.toFixed(1)} time units — a signature of nonlinear kinetic trapping, not present in weak Landau damping.</figcaption>
    </figure>

    <section class="explanation" aria-labelledby="setup-title">
      <div>
        <p class="eyebrow">Physical problem</p>
        <h2 id="setup-title">Particle trapping in a large-amplitude wave</h2>
        <p>The same setup as weak Landau damping, but with a perturbation 500× larger. The field is now strong enough to trap particles near the phase velocity in its own potential wells. Those trapped particles slosh back and forth (the "bounce" motion), periodically re-exciting the field instead of letting it decay away — the hallmark of nonlinear Landau damping.</p>
        <div class="equations prose" aria-label="Vlasov-Ampère equations" set:html={equationsHtml}></div>
      </div>
      <dl>
        <div><dt>Model</dt><dd><a href={`/models/${toSlug(data.model)}/`}>{data.model}</a></dd></div>
        <div><dt>Domain</dt><dd><a href={`/domains/#${data.domain.split(' ')[0]}`}>{data.domain}</a></dd></div>
        <div><dt>Grid</dt><dd>{data.grid}</dd></div>
        <div><dt>FEEC degree</dt><dd>{data.degree}</dd></div>
        {data.integrator && <div><dt>Integrator</dt><dd>{data.integrator}</dd></div>}
        <div><dt>Evolution</dt><dd>{data.steps.toLocaleString()} steps</dd></div>
        <div><dt>Visualization</dt><dd>{data.visualization}</dd></div>
      </dl>
    </section>

    {data.profilingRegionStats && (
      <section class="profiling" aria-labelledby="profiling-title" id="profiling-section"
        data-durations={data.profilingDurations} data-gantt={data.profilingGantt}
        data-flame={data.profilingFlame} data-stats={data.profilingRegionStats}>
        <div class="source-heading">
          <div><p class="eyebrow">Performance</p><h2 id="profiling-title">Where the time goes</h2></div>
          <div class="source-actions"><a href={data.profilingData} download>Download profile .h5</a></div>
        </div>
        <p class="requirements">Struphy's built-in <a href="https://pypi.org/project/scope-profiler/">scope-profiler</a> instruments every propagator, pusher and solver call — these are the real per-call timings from the run above, rendered live from its data.</p>

        <div class="pf-grid">
          <article class="pf-tile">
            <div class="pf-tile-header">
              <h3>Durations</h3>
              <select id="pf-metric" class="pf-select" aria-label="Duration metric">
                <option value="total">Total</option>
                <option value="avg">Average</option>
                <option value="min">Min</option>
                <option value="max">Max</option>
                <option value="first">First call</option>
                <option value="last">Last call</option>
              </select>
            </div>
            <input id="pf-filter-durations" class="pf-filter" type="search" placeholder="Filter regions, e.g. prop:, setup: total" aria-label="Filter regions" autocomplete="off" />
            <div id="pf-plot-durations" class="pf-plot"></div>
          </article>
          <article class="pf-tile">
            <div class="pf-tile-header"><h3>Gantt <span class="muted">(rank 0)</span></h3></div>
            <input id="pf-filter-gantt" class="pf-filter" type="search" placeholder="Filter regions, e.g. prop:, setup: total" aria-label="Filter regions" autocomplete="off" />
            <div id="pf-plot-gantt" class="pf-plot"></div>
          </article>
          <article class="pf-tile pf-tile-wide">
            <div class="pf-tile-header"><h3>Flame <span class="muted">(rank 0)</span></h3></div>
            <div id="pf-plot-flame" class="pf-plot pf-plot-tall"></div>
          </article>
        </div>

        <div class="pf-tile-header"><h3>Region statistics</h3><input id="pf-filter-table" class="pf-filter" type="search" placeholder="Filter regions, e.g. prop:, setup: total" aria-label="Filter regions" autocomplete="off" /></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Region</th><th>Count</th><th>Avg (s)</th><th>Min (s)</th><th>Max (s)</th><th>Total (s)</th></tr></thead>
            <tbody id="pf-region-body"></tbody>
          </table>
        </div>
      </section>
    )}

    <section class="source" aria-labelledby="source-title">
      <div class="source-heading">
        <div><p class="eyebrow">Complete source</p><h2 id="source-title">Run the simulation</h2></div>
        <div class="source-actions"><button type="button" data-copy>Copy script</button><a href="/examples/strong-landau-damping.py" download>Download .py</a></div>
      </div>
      <p class="requirements">Requires Struphy 3.2 with compiled kernels and Plotly. Run <code>struphy compile</code> once, then execute <code>python strong-landau-damping.py</code>.</p>
      <div class="highlight" data-source set:html={highlightedSource}></div>
      <p class="provenance">Adapted from Struphy’s maintained <a href="https://github.com/struphy-hub/struphy/blob/devel/examples/VlasovAmpereOneSpecies/strong_Landau_damping/params_strong_Landau_damping.py">strong Landau damping example</a>. See the <a href="https://struphy-hub.github.io/struphy/sections/userguide.html#post-processing-and-visualization">post-processing guide</a> for more ways to inspect the result.</p>
    </section>
  </main>
</Layout>

<script>
  function mountCopyButton() {
    const button=document.querySelector<HTMLButtonElement>('[data-copy]');
    const source=document.querySelector<HTMLElement>('[data-source]');
    if(!button||!source)return;
    button.onclick=async()=>{try{await navigator.clipboard.writeText(source.textContent||'');button.textContent='Copied'}catch{button.textContent='Copy failed'}setTimeout(()=>{button.textContent='Copy script'},1800)};
  }
  mountCopyButton();
  document.addEventListener('astro:page-load',mountCopyButton);

  function mountProfiling(){
    import('../../../lib/profiling-page.js').then(({ mountProfilingSection }) => {
      mountProfilingSection(document.getElementById('profiling-section'));
    });
  }
  mountProfiling();
  document.addEventListener('astro:page-load', mountProfiling);
</script>

<style>
  .intro{max-width:850px;padding-block:clamp(52px,7vw,84px)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}h1{margin:0 0 18px;font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.08;letter-spacing:-.035em}.intro>p:not(.eyebrow){color:var(--muted);font-size:1.05rem}.eyebrow a{color:var(--cyan);text-decoration:none}.eyebrow a:hover{text-decoration:underline}.back{display:inline-block;margin-top:12px;color:var(--cyan)}
  .result{margin:0;padding-block:40px 52px;border-top:1px solid var(--rule)}.plot-frame{width:min(100%,1100px);aspect-ratio:1100/650;margin-inline:auto}.result iframe{display:block;width:100%;height:100%;border:1px solid var(--rule);background:#fff}.result img{display:block;width:min(100%,1100px);height:auto;margin-inline:auto;border:1px solid var(--rule);background:#fff}.result figcaption{width:min(100%,1100px);margin:10px auto 0;color:var(--muted);font-size:.84rem}
  .explanation,.source,.profiling{padding-block:clamp(44px,7vw,68px);border-top:1px solid var(--rule)}
  .pf-grid{display:grid;grid-template-columns:1fr;gap:20px;margin-top:24px}.pf-tile{border:1px solid var(--rule);padding:16px}.pf-tile-wide{grid-column:1/-1}.pf-tile-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.pf-tile-header h3{margin:0;font-size:1rem}.pf-select,.pf-filter{font:600 .78rem var(--sans);border:1px solid var(--rule);background:var(--paper-bg,transparent);color:var(--paper);padding:6px 8px}.pf-filter{width:100%;margin-bottom:10px}.pf-plot{width:100%;min-height:340px;max-height:640px;overflow-y:auto}.pf-error{color:var(--muted);font-size:.85rem}.table-wrap{margin-top:16px;overflow-x:auto;border:1px solid var(--rule)}.table-wrap table{width:100%;border-collapse:collapse;font:.8rem var(--mono)}.table-wrap th,.table-wrap td{padding:7px 10px;border-bottom:1px solid var(--rule);text-align:left;white-space:nowrap}.table-wrap th{color:var(--muted);font-weight:600;position:sticky;top:0;background:var(--code-bg)}.explanation{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.48fr);gap:clamp(40px,8vw,100px)}h2{margin:0 0 14px;font-size:clamp(1.55rem,3vw,2.1rem)}.explanation>div>p:not(.eyebrow),.requirements,.provenance{color:var(--muted)}.provenance code{color:var(--paper)}.equations{margin-top:24px;padding:18px 20px;border-left:2px solid var(--cyan);background:var(--accent-wash);font-size:.95rem}.equations :global(p){margin:0 0 6px;color:inherit}.equations :global(p:last-child){margin-bottom:0}.equations :global(strong){color:var(--cyan)}.equations :global(.math-display){overflow-x:auto;margin:6px 0}
  dl{margin:0;border-top:1px solid var(--rule)}dl div{display:flex;justify-content:space-between;gap:24px;padding:10px 0;border-bottom:1px solid var(--rule)}dt{color:var(--muted);font-size:.82rem}dd{margin:0;text-align:right;font:700 .8rem var(--mono)}dd a{color:var(--cyan);text-decoration:none}dd a:hover{text-decoration:underline}
  .source-heading{display:flex;align-items:end;justify-content:space-between;gap:24px}.source-actions{display:flex;gap:12px}.source-actions button,.source-actions a{padding:8px 12px;border:1px solid var(--cyan);background:none;color:var(--cyan);cursor:pointer;font:650 .78rem var(--sans);text-decoration:none}.source-actions button:hover,.source-actions a:hover{background:var(--accent-wash)}.requirements code{color:var(--paper)}.highlight{max-height:720px;margin:24px 0 0;overflow:auto;border:1px solid var(--rule);background:var(--code-bg)}.highlight :global(.shiki){min-width:max-content;margin:0;padding:22px;background:var(--code-bg)!important;font:.79rem/1.65 var(--mono);tab-size:4}.highlight :global(.shiki code){display:block}.provenance{font-size:.82rem}.provenance a{color:var(--cyan)}
  .highlight :global(.shiki),.highlight :global(.shiki span){color:var(--shiki-light)}
  :global(html[data-theme='dark'] .highlight .shiki),:global(html[data-theme='dark'] .highlight .shiki span){color:var(--shiki-dark)!important}
  @media(max-width:720px){.explanation{grid-template-columns:1fr}.source-heading{align-items:flex-start;flex-direction:column}.source-actions{flex-wrap:wrap}.highlight :global(.shiki){padding:16px}}
</style>
