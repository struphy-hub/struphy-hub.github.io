---
import { codeToHtml } from 'shiki';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import ExamplePage from '../../../components/ExamplePage.astro';
import { exampleConfig } from '../../../data/example-config';
import examples from '../../../data/examples-index.json';

const sourceModules = import.meta.glob('../../../examples/*.py', { query: '?raw', import: 'default', eager: true });

function pdeMarkdownToHtml(markdown = ''): string {
  return markdown.split(/\$\$([\s\S]*?)\$\$/g).map((part, i) => {
    if (i % 2 === 1) return `<div class="math-display">${katex.renderToString(part.trim(), { displayMode: true, throwOnError: false, strict: false, output: 'html' })}</div>`;
    return part.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean).map((p) => `<p>${p.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/:math:`([^`]+)`/g, (_m, latex) => katex.renderToString(latex, { throwOnError: false, strict: false, output: 'html' }))}</p>`).join('');
  }).join('');
}

export function getStaticPaths() {
  // The prebuild hook generates this index from public/examples. Importing it
  // keeps static route generation independent of Astro's build working paths.
  return examples.map(({ slug, data }) => ({ params: { slug }, props: { data } }));
}

const { slug } = Astro.params;
const { data } = Astro.props;
const config = exampleConfig[slug as string] ?? { category: 'Struphy example', setupTitle: data.name, plotTitle: data.name, plotAlt: data.name };
const sourceEntry = Object.entries(sourceModules).find(([key]) => key.endsWith(`/${slug}.py`));
const source = String(sourceEntry?.[1] ?? '');
const highlightedSource = await codeToHtml(source, { lang: 'python', themes: { light: 'github-light', dark: 'github-dark' }, defaultColor: false });
const equationsHtml = pdeMarkdownToHtml(data.equationsMarkdown);
const exampleIndex = examples.findIndex((example) => example.slug === slug);
// Keep example pages browsable in the same order as the gallery, wrapping from
// the final entry back to the first one.
const nextExample = exampleIndex >= 0 ? examples[(exampleIndex + 1) % examples.length] : undefined;
---

<ExamplePage {slug} {data} {config} {highlightedSource} {equationsHtml} {nextExample} />
