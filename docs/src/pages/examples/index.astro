---
import Layout from '../../layouts/Layout.astro';
import { exampleConfig } from '../../data/example-config';
import examples from '../../data/examples-index.json';

function formatTotalTime(seconds: unknown): string {
  if (typeof seconds !== 'number' || !Number.isFinite(seconds) || seconds < 0) return '—';
  if (seconds > 0 && seconds < 1) {
    const unit = seconds < 0.001 ? 'µs' : 'ms';
    const value = seconds * (unit === 'µs' ? 1e6 : 1e3);
    return `${value.toLocaleString('en-US', { maximumSignificantDigits: 3 })} ${unit}`;
  }
  return `${seconds.toLocaleString('en-US', { maximumFractionDigits: 2 })} s`;
}

const categories = [...new Set(examples.map((example: any) => exampleConfig[example.slug]?.category ?? 'Other'))].sort();
---

<Layout title="Examples — Struphy" description="A visual gallery of reproducible Struphy simulations with complete scripts and generated figures.">
  <main>
    <header class="intro">
      <p class="eyebrow">Reproducible simulations</p>
      <h1>Examples</h1>
      <p>Browse reproducible Struphy simulations by their output. Select a figure to explore the physical setup, numerical method, and complete runnable script.</p>
    </header>

    <section class="gallery-section" aria-labelledby="gallery-title">
      <div class="section-heading">
        <h2 id="gallery-title">All examples</h2>
        <div class="filter">
          <label for="example-filter">{examples.length} available</label>
          <input id="example-filter" type="search" data-filter placeholder="Filter examples, models or physics…" aria-describedby="filter-status" />
        </div>
      </div>
      <div class="category-filters" role="group" aria-label="Filter examples by category">
        <button type="button" class="category-filter is-active" data-category-filter="all" aria-pressed="true">All</button>
        {categories.map((category) => <button type="button" class="category-filter" data-category-filter={category} aria-pressed="false">{category}</button>)}
      </div>
      <p class="status" id="filter-status" role="status" data-status hidden></p>
      <div class="gallery-grid">
        {examples.map((example: any) => (
          <article class="gallery-item" data-example-card data-category={exampleConfig[example.slug]?.category ?? 'Other'} data-search={`${example.name} ${example.description} ${example.model ?? ''} ${exampleConfig[example.slug]?.category ?? ''}`.toLowerCase()}>
            {example.model && <a class="model-tag" href={`/models/${example.modelSlug}/`}>{example.model}</a>}
            <a class="card-link" href={example.href} aria-label={`Open ${example.name} example`}>
              <div class="thumbnail">
                {example.thumbnail && <img src={example.thumbnail} alt={`Figure from the ${example.name} example`} loading="eager" />}
                <span class="thumbnail-cta" aria-hidden="true">Open example <span>→</span></span>
              </div>
              <div class="caption">
                <span class="category">{exampleConfig[example.slug]?.category ?? 'Other'}</span>
                <h3>{example.name}</h3>
              </div>
            </a>
          </article>
        ))}
      </div>
      <p class="empty" data-empty hidden>No examples match your search.</p>
    </section>

    <section class="contribute" aria-labelledby="contribute-title">
      <p class="eyebrow">Extend the collection</p>
      <h2 id="contribute-title">Add an example</h2>
      <p>Each gallery entry should include a generated figure, a short physical description, the complete runnable Struphy script, its requirements, and approximate computational cost. Set <code>name=</code> and <code>description=</code> on the script's <code>Simulation(...)</code> — running <code>generate_examples.py</code> then picks up the model, equations, and configuration automatically, and links the example from that model's page.</p>
    </section>

    <details class="run-details">
      <summary>Run details <span>{examples.length} examples</span></summary>
      <div class="run-table-scroll" role="region" aria-label="Example run details" tabindex="0">
        <table>
          <caption>Total profiler wall time; hostname is the rank 0 host. — means unavailable.</caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Model</th>
              <th scope="col" class="numeric">Total time</th>
              <th scope="col" class="numeric">MPI ranks</th>
            </tr>
          </thead>
          <tbody>
            {examples.map((example: any) => (
              <tr>
                <th scope="row"><a href={example.href}>{example.name}</a></th>
                <td>{example.model ? (example.modelSlug ? <a href={`/models/${example.modelSlug}/`}>{example.model}</a> : example.model) : '—'}</td>
                <td class="numeric">{formatTotalTime(example.runSummary?.totalTimeSeconds)}</td>
                <td class="numeric">{example.runSummary?.mpiRanks ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </main>
</Layout>

<script is:inline>
  const input = document.querySelector('[data-filter]');
  const cards = [...document.querySelectorAll('[data-example-card]')];
  const empty = document.querySelector('[data-empty]');
  const status = document.querySelector('[data-status]');
  const categoryFilters = [...document.querySelectorAll('[data-category-filter]')];
  let selectedCategory = 'all';

  function updateGallery() {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const categoryMatch = selectedCategory === 'all' || card.dataset.category === selectedCategory;
      const match = categoryMatch && (!query || (card.dataset.search || '').includes(query));
      card.hidden = !match;
      if (match) visible += 1;
    });
    if (empty) empty.hidden = visible > 0;
    if (status) {
      const isFiltered = Boolean(query) || selectedCategory !== 'all';
      status.hidden = !isFiltered;
      status.textContent = `${visible} of ${cards.length} examples match${query ? ` “${input.value.trim()}”` : ''}${selectedCategory !== 'all' ? ` in ${selectedCategory}` : ''}.`;
    }
  }

  input?.addEventListener('input', updateGallery);
  categoryFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      selectedCategory = filter.dataset.categoryFilter || 'all';
      categoryFilters.forEach((item) => {
        const isActive = item === filter;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
      updateGallery();
    });
  });
</script>

<style>
  .intro{max-width:790px;padding-block:clamp(56px,8vw,92px)}
  .eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}
  .intro>p:not(.eyebrow),.section-heading p,.contribute>p:not(.eyebrow){color:var(--muted)}
  .gallery-section,.contribute{padding-block:clamp(44px,7vw,72px);border-top:1px solid var(--rule)}
  .section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:18px}.section-heading h2,.contribute h2{margin:0;font-size:clamp(1.5rem,3vw,2rem)}.section-heading p{margin:0;max-width:520px;text-align:right}
  .filter{width:min(320px,100%)}
  .filter label{display:block;margin-bottom:7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase;text-align:right}
  .filter input{width:100%;padding:10px 12px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit}
  .filter input:focus{outline:2px solid var(--cyan);outline-offset:2px}
  .category-filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}
  .category-filter{padding:7px 11px;border:1px solid var(--rule);border-radius:999px;background:transparent;color:var(--muted);cursor:pointer;font:600 .72rem var(--sans)}
  .category-filter:hover,.category-filter:focus-visible,.category-filter.is-active{border-color:var(--cyan);background:var(--accent-wash);color:var(--paper)}
  .category-filter:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
  .status,.empty{color:var(--muted);font-size:.84rem}
  .status{margin:0 0 18px}
  .empty{margin:26px 0 0}
  [hidden]{display:none!important}
  .gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px 24px}
  .gallery-item{min-width:0;position:relative}.card-link{display:block;color:var(--paper);text-decoration:none}.thumbnail{position:relative;aspect-ratio:1;overflow:hidden;border:1px solid var(--rule);background:#fff}.thumbnail img{display:block;width:100%;height:100%;object-fit:contain;transition:transform .25s ease,filter .25s ease}.thumbnail-cta{position:absolute;right:12px;bottom:12px;padding:7px 10px;background:var(--ink);color:var(--paper);font:650 .72rem var(--sans);opacity:0;transform:translateY(5px);transition:opacity .2s ease,transform .2s ease}.thumbnail-cta span{margin-left:5px;color:var(--cyan);font-size:1rem}.card-link:hover .thumbnail,.card-link:focus-visible .thumbnail{border-color:var(--cyan)}.card-link:hover img,.card-link:focus-visible img{transform:scale(1.018);filter:brightness(.88)}.card-link:hover .thumbnail-cta,.card-link:focus-visible .thumbnail-cta{opacity:1;transform:translateY(0)}
  .model-tag{position:absolute;top:10px;left:10px;z-index:1;padding:3px 8px;background:var(--ink);color:var(--cyan);font:650 .68rem var(--mono);letter-spacing:.06em;text-transform:uppercase;text-decoration:none;border:1px solid var(--rule)}.model-tag:hover{text-decoration:underline}
  .caption{padding-top:12px}.caption .category{display:block;margin-bottom:5px;color:var(--cyan);font:600 .68rem var(--mono);letter-spacing:.06em;text-transform:uppercase}.caption h3{margin:0;font-size:1rem}
  .contribute{max-width:780px}.contribute h2{margin-bottom:12px}.contribute p{margin-bottom:0}.contribute code{color:var(--paper)}
  .run-details{margin-bottom:44px;border-block:1px solid var(--rule);font-size:.8rem}
  .run-details summary{padding:18px 0;color:var(--muted);cursor:pointer;font-weight:600}
  .run-details summary span{margin-left:12px;font-weight:400;font-size:.72rem}
  .run-details summary:hover,.run-details[open] summary{color:var(--paper)}
  .run-details summary:focus-visible,.run-table-scroll:focus-visible,.run-details a:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
  .run-table-scroll{max-width:100%;overflow-x:auto;margin-bottom:18px}
  .run-details table{width:100%;border-collapse:collapse;text-align:left}
  .run-details caption{text-align:left;color:var(--muted);font-size:.75rem;padding:0 0 14px}
  .run-details th,.run-details td{padding:10px 14px;border-bottom:1px solid var(--rule);vertical-align:top}
  .run-details th:first-child{padding-left:0}
  .run-details th:last-child,.run-details td:last-child{padding-right:0}
  .run-details thead th{color:var(--muted);font-weight:500;white-space:nowrap}
  .run-details tbody th{font-weight:500;min-width:180px}
  .run-details tbody tr:last-child>*{border-bottom:0}
  .run-details a{color:var(--paper);text-decoration:none}
  .run-details a:hover{color:var(--cyan);text-decoration:underline}
  .run-details .numeric{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  @media(max-width:820px){.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.section-heading{align-items:flex-start;flex-direction:column;gap:12px}.section-heading p{text-align:left}.filter label{text-align:left}.gallery-grid{grid-template-columns:1fr}}
</style>
