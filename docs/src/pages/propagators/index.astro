---
import Layout from '../../layouts/Layout.astro';
import PropagatorPreview from '../../components/PropagatorPreview.astro';
import rawPropagators from '../../data/propagators.json';
import { toSlug } from '../../lib/catalogue';

const categoryOrder = ['Field', 'Particle', 'Coupling', 'Other'];

const propagators = (rawPropagators as any[]).map((propagator) => ({
  className: propagator.className,
  category: propagator.category,
  summary: propagator.summary,
  slug: toSlug(propagator.className),
  usedByCount: propagator.usedBy.length,
  variableNames: propagator.variables.map((variable: any) => variable.name),
}));

const categories = categoryOrder
  .map((name) => ({ name, items: propagators.filter((propagator) => propagator.category === name) }))
  .filter((category) => category.items.length);

const initial = propagators[0];
const modelCount = new Set((rawPropagators as any[]).flatMap((propagator) => propagator.usedBy.map((entry: any) => entry.model))).size;
---

<Layout
  title="Propagators — Struphy"
  description="Browse the propagators Struphy splits its models into: what each one solves, the variables it advances, its options, and the models that use it."
>
  <main>
    <header class="intro">
      <p class="eyebrow">Time-stepping building blocks</p>
      <h1>Propagators</h1>
      <p>
        Struphy does not integrate a model in one piece. Each model is split into <strong>propagators</strong> —
        substeps that each advance part of the state over a time step <code>dt</code>, composed in sequence to make
        the full scheme. Splitting this way keeps each substep small enough to be discretized in a
        structure-preserving way, and lets models reuse each other's physics: the {propagators.length} propagators
        below are shared across {modelCount} models.
      </p>
      <p class="links-row">
        <a class="relationships-link" href="/models/">Browse the models built from them →</a>
        <a class="relationships-link" href="/feec/">How the field variables are discretized →</a>
      </p>
    </header>

    <section class="browser" aria-label="Propagator catalogue">
      <aside class="selector">
        <label for="propagator-filter">{propagators.length} available</label>
        <input id="propagator-filter" type="search" data-filter placeholder="Filter by name, variable, or model…" />

        <div class="propagator-list">
          {categories.map((category) => (
            <section class="group" data-group>
              <h2>{category.name} <span>{category.items.length}</span></h2>
              <ul>
                {category.items.map((propagator) => (
                  <li
                    data-propagator-row
                    data-search={`${propagator.className} ${propagator.summary} ${propagator.category} ${propagator.variableNames.join(' ')}`.toLowerCase()}
                  >
                    <a
                      href={`/propagators/${propagator.slug}/`}
                      data-propagator-option={propagator.slug}
                      aria-current={propagator.slug === initial.slug ? 'true' : undefined}
                    >
                      <code>{propagator.className}</code>
                      <span>{propagator.summary}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <p class="empty" data-empty hidden>No propagators match your search.</p>
        </div>
      </aside>

      <PropagatorPreview initialSlug={initial.slug} />
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ propagators }}>
  const input = document.querySelector('[data-filter]');
  const options = [...document.querySelectorAll('[data-propagator-option]')];
  const rows = [...document.querySelectorAll('[data-propagator-row]')];
  const groups = [...document.querySelectorAll('[data-group]')];
  const empty = document.querySelector('[data-empty]');
  const preview = document.querySelector('[data-propagator-preview]');

  const selectPropagator = (slug, updateHash = true) => {
    if (!propagators.some((propagator) => propagator.slug === slug)) return;
    options.forEach((option) => {
      if (option.dataset.propagatorOption === slug) option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
    if (preview) {
      preview.dataset.slug = slug;
      preview.dispatchEvent(new CustomEvent('propagator-preview-change', { detail: { slug } }));
    }
    if (updateHash) history.replaceState(null, '', `#${slug}`);
  };

  options.forEach((option) => option.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    selectPropagator(option.dataset.propagatorOption);
  }));

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const match = !query || (row.dataset.search || '').includes(query);
      row.hidden = !match;
      if (match) visible += 1;
    });
    groups.forEach((group) => {
      group.hidden = ![...group.querySelectorAll('[data-propagator-row]')].some((row) => !row.hidden);
    });
    if (empty) empty.hidden = visible > 0;
  });

  const requested = decodeURIComponent(location.hash.slice(1));
  if (requested) selectPropagator(requested, false);
</script>

<style>
  .intro{max-width:820px;padding-block:clamp(56px,8vw,92px)}
  .eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}
  .intro>p:not(.eyebrow){color:var(--muted)}
  .links-row{display:flex;flex-wrap:wrap;gap:20px;margin-top:14px}
  .relationships-link{display:inline-block;color:var(--cyan)}
  .browser{display:grid;grid-template-columns:minmax(250px,300px) minmax(0,1fr);gap:48px;padding-block:40px 72px;border-top:1px solid var(--rule);align-items:start}
  .selector{position:sticky;top:92px;max-height:calc(100vh - 116px);overflow:auto;padding-right:12px}
  .selector>label{display:block;margin-bottom:9px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  input{width:100%;padding:10px 12px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit}
  input:focus{outline:2px solid var(--cyan);outline-offset:2px}
  .propagator-list{margin-top:26px}
  .group{margin-top:25px}
  .group:first-child{margin-top:0}
  .group h2{margin:0 0 7px;padding-bottom:7px;border-bottom:1px solid var(--rule);font-size:.88rem;letter-spacing:.02em}
  .group h2 span{margin-left:5px;color:var(--muted);font:400 .72rem var(--mono)}
  ul{margin:0;padding:0;list-style:none}
  li a{display:block;padding:9px 10px;border-left:2px solid transparent;color:var(--paper);text-decoration:none}
  li a:hover{background:var(--accent-wash)}
  li a[aria-current=true]{border-left-color:var(--cyan);background:var(--accent-wash)}
  li code{display:block;color:var(--cyan);font-size:.82rem;overflow-wrap:anywhere}
  li span{display:block;margin-top:3px;color:var(--muted);font-size:.73rem;line-height:1.4}
  .empty{color:var(--muted);font-size:.84rem}
  [hidden]{display:none!important}
  @media(max-width:820px){.browser{grid-template-columns:1fr;gap:28px}.selector{position:static;max-height:none;padding-right:0}.propagator-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}}
  @media(max-width:560px){.propagator-list{display:block}}
</style>
