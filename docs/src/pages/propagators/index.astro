---
import Layout from '../../layouts/Layout.astro';
import rawPropagators from '../../data/propagators.json';
import { toSlug } from '../../lib/catalogue';

const GROUPS = [
  { name: 'Field', blurb: 'Advance FEEC field variables — the spline coefficients of the de Rham complex.' },
  { name: 'Particle', blurb: 'Push markers: positions, velocities, and weights of the PIC or SPH sampling.' },
  { name: 'Coupling', blurb: 'Update fields and markers together, the steps that make a hybrid model hybrid.' },
  { name: 'Other', blurb: 'Steps that do not yet declare their variables on the class.' },
];

const propagators = (rawPropagators as any[]).map((propagator) => ({
  ...propagator,
  slug: toSlug(propagator.className),
  // `algo` / `model` select the scheme itself (`implicit` vs `explicit`,
  // `barotropic` vs `full`, ...), which is worth showing on a card. Every other
  // multiple-choice option picks a solver, preconditioner or space, and would
  // only repeat what the chips already say or bury the card in noise.
  algorithms: propagator.options.find((option: any) => ['algo', 'model'].includes(option.name))?.choices ?? [],
}));

const groups = GROUPS.map((group) => ({
  ...group,
  items: propagators.filter((propagator) => propagator.category === group.name),
})).filter((group) => group.items.length);

const modelCount = new Set(propagators.flatMap((propagator: any) => propagator.usedBy.map((entry: any) => entry.model))).size;
---

<Layout
  title="Propagators — Struphy"
  description="Browse the propagators Struphy splits its models into: what each one solves, the variables it advances, its options, and the models that use it."
>
  <main>
    <header class="intro">
      <p class="eyebrow">Time-stepping building blocks</p>
      <h1>Propagators</h1>
      <p>
        Struphy does not integrate a model in one piece. Each model is split into <strong>propagators</strong> —
        substeps that each advance part of the state over a time step <code>dt</code>, composed in sequence to make
        the full scheme. Splitting this way keeps each substep small enough to be discretized in a
        structure-preserving way, and lets models reuse each other's physics: the {propagators.length} propagators
        below are shared across {modelCount} models.
      </p>
      <p class="links-row">
        <a href="/models/">Browse the models built from them →</a>
        <a href="/feec/">How the field variables are discretized →</a>
      </p>
    </header>

    <section class="catalogue" aria-label="Propagator catalogue">
      <div class="toolbar">
        <label for="propagator-filter">{propagators.length} propagators</label>
        <input id="propagator-filter" type="search" data-filter placeholder="Filter by name, variable, space, or model…" />
      </div>

      {groups.map((group) => (
        <section class="group" data-group aria-labelledby={`group-${group.name}`}>
          <div class="group-heading">
            <h2 id={`group-${group.name}`}>{group.name} <span>{group.items.length}</span></h2>
            <p>{group.blurb}</p>
          </div>
          <div class="grid">
            {group.items.map((propagator: any) => (
              <a
                class="card"
                href={`/propagators/${propagator.slug}/`}
                data-card
                data-search={`${propagator.className} ${propagator.summary} ${propagator.category} ${propagator.variables.map((variable: any) => `${variable.name} ${variable.spaces.join(' ')} ${variable.kinds.join(' ')}`).join(' ')} ${propagator.usedBy.map((entry: any) => entry.model).join(' ')} ${propagator.algorithms.join(' ')}`.toLowerCase()}
              >
                <h3>{propagator.className}</h3>
                <p class="summary">{propagator.summary}</p>
                {propagator.variables.length > 0 && (
                  <p class="chips">
                    {propagator.variables.map((variable: any) => (
                      <span class="chip">
                        {variable.name}
                        {variable.spaces.length === 1 && <em> · {variable.spaces[0]}</em>}
                      </span>
                    ))}
                  </p>
                )}
                <p class="meta">
                  {propagator.usedBy.length
                    ? `Used by ${propagator.usedBy.length} model${propagator.usedBy.length === 1 ? '' : 's'}`
                    : 'Not used by a model yet'}
                  {propagator.algorithms.length > 0 && <em> · {propagator.algorithms.slice(0, 3).join(' / ')}</em>}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))}

      <p class="empty" data-empty hidden>No propagators match your search.</p>
    </section>
  </main>
</Layout>

<script is:inline>
  const input = document.querySelector('[data-filter]');
  const cards = [...document.querySelectorAll('[data-card]')];
  const groups = [...document.querySelectorAll('[data-group]')];
  const empty = document.querySelector('[data-empty]');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const match = !query || (card.dataset.search || '').includes(query);
      card.hidden = !match;
      if (match) visible += 1;
    });
    groups.forEach((group) => {
      group.hidden = ![...group.querySelectorAll('[data-card]')].some((card) => !card.hidden);
    });
    if (empty) empty.hidden = visible > 0;
  });
</script>

<style>
  .intro{max-width:820px;padding-block:clamp(56px,8vw,92px)}
  .eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}
  .intro>p:not(.eyebrow){color:var(--muted)}
  .links-row{display:flex;flex-wrap:wrap;gap:22px;margin-top:14px}
  .links-row a{color:var(--cyan)}
  .catalogue{padding-block:36px 72px;border-top:1px solid var(--rule)}
  .toolbar{max-width:460px;margin-bottom:34px}
  .toolbar label{display:block;margin-bottom:9px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  input{width:100%;padding:10px 12px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit}
  input:focus{outline:2px solid var(--cyan);outline-offset:2px}
  .group{margin-top:44px}
  .group:first-of-type{margin-top:0}
  .group-heading{max-width:680px;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--rule)}
  .group-heading h2{margin:0;font-size:1.15rem}
  .group-heading h2 span{margin-left:6px;color:var(--muted);font:400 .78rem var(--mono)}
  .group-heading p{margin:6px 0 0;color:var(--muted);font-size:.86rem}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
  .card{display:flex;flex-direction:column;padding:16px 18px;border:1px solid var(--rule);color:var(--paper);text-decoration:none}
  .card:hover{border-color:var(--cyan);background:var(--accent-wash)}
  .card h3{margin:0;color:var(--cyan);font:650 .93rem/1.35 var(--mono);overflow-wrap:anywhere}
  .summary{margin:7px 0 0;color:var(--muted);font-size:.82rem;line-height:1.45}
  .chips{display:flex;flex-wrap:wrap;gap:5px;margin:11px 0 0}
  .chip{padding:2px 7px;border:1px solid var(--rule);font:.74rem var(--mono)}
  .chip em{color:var(--muted);font-style:normal}
  .meta{margin:auto 0 0;padding-top:11px;color:var(--muted);font-size:.75rem}
  .meta em{font-style:normal;opacity:.8}
  .empty{margin-top:28px;color:var(--muted);font-size:.86rem}
  [hidden]{display:none!important}
</style>
