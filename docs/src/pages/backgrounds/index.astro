---
import Layout from '../../layouts/Layout.astro';
import BackgroundPreview from '../../components/BackgroundPreview.astro';
import rawBackgrounds from '../../data/kinetic-backgrounds.json';
import { toSlug } from '../../lib/catalogue';

const backgrounds = (rawBackgrounds as any[]).map((background) => ({
  className: background.className, summary: background.summary, vdim: background.vdim,
  velocityLabels: background.velocityLabels, slug: toSlug(background.className),
})).sort((a, b) => a.className.localeCompare(b.className));
const initial = backgrounds[0];
---

<Layout title="Kinetic backgrounds — Struphy" description="Browse the velocity-space distributions that initialize kinetic species in Struphy.">
  <main>
    <header class="intro"><p class="eyebrow">Velocity-space distributions</p><h1>Kinetic backgrounds</h1><p>A kinetic background is the distribution <strong>f₀</strong> a kinetic species starts from. Select one to inspect its velocity-space distribution, phase-space conventions, and constructor defaults.</p></header>
    <section class="browser" aria-label="Kinetic background catalogue">
      <aside class="selector" aria-label="Select a kinetic background"><label for="background-filter">{backgrounds.length} available</label><input id="background-filter" type="search" data-filter placeholder="Filter backgrounds…" /><ul>{backgrounds.map((background) => <li data-row data-search={`${background.className} ${background.summary} ${background.velocityLabels.join(' ')}`.toLowerCase()}><a href={`/backgrounds/${background.slug}/`} data-option={background.slug} aria-current={background.slug === initial.slug ? 'true' : undefined}><code>{background.className}</code><span>{background.summary}</span></a></li>)}</ul><p class="empty" data-empty hidden>No kinetic backgrounds match your search.</p></aside>
      <BackgroundPreview initialSlug={initial.slug} />
    </section>
    <section class="note"><h2>How these are sampled</h2><p>Plots are evaluated through Struphy’s <code>reduced_eval</code>, integrating over phase-space axes not shown. They use the fixed logical point <code>η = (0.5, 0.5, 0.5)</code> and each class’s constructor defaults.</p></section>
  </main>
</Layout>

<script is:inline define:vars={{ backgrounds }}>
  const input=document.querySelector('[data-filter]'),options=[...document.querySelectorAll('[data-option]')],rows=[...document.querySelectorAll('[data-row]')],empty=document.querySelector('[data-empty]'),preview=document.querySelector('[data-background-preview]');
  function select(slug,updateHash=true){if(!backgrounds.some((item)=>item.slug===slug))return;options.forEach((option)=>option.setAttribute('aria-current',String(option.dataset.option===slug)));if(preview){preview.dataset.slug=slug;preview.dispatchEvent(new CustomEvent('background-preview-change',{detail:{slug}}));}if(updateHash)history.replaceState(null,'',`#${slug}`);}
  options.forEach((option)=>option.addEventListener('click',(event)=>{if(event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;event.preventDefault();select(option.dataset.option);}));
  input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();let visible=0;rows.forEach((row)=>{const match=!query||(row.dataset.search||'').includes(query);row.hidden=!match;if(match)visible++;});if(empty)empty.hidden=visible>0;});
  const requested=decodeURIComponent(location.hash.slice(1));if(requested)select(requested,false);
</script>

<style>
  .intro{max-width:820px;padding-block:clamp(56px,8vw,92px)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}.intro>p:not(.eyebrow),.note p{color:var(--muted)}.browser{display:grid;grid-template-columns:minmax(250px,300px) minmax(0,1fr);gap:48px;padding-block:40px 72px;border-top:1px solid var(--rule);align-items:start}.selector{position:sticky;top:92px;max-height:calc(100vh - 116px);overflow:auto;padding-right:12px}.selector label{display:block;margin-bottom:9px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}.selector input{width:100%;padding:10px 12px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit}.selector ul{margin:26px 0 0;padding:0;list-style:none}.selector a{display:block;padding:9px 10px;border-left:2px solid transparent;color:var(--paper);text-decoration:none}.selector a:hover{background:var(--accent-wash)}.selector a[aria-current=true]{border-left-color:var(--cyan);background:var(--accent-wash)}.selector code{display:block;color:var(--cyan);font-size:.82rem;overflow-wrap:anywhere}.selector span{display:block;margin-top:3px;color:var(--muted);font-size:.73rem;line-height:1.4}.empty{color:var(--muted);font-size:.84rem}.note{max-width:820px;padding-block:40px 64px;border-top:1px solid var(--rule)}.note h2{margin:0 0 14px;font-size:1.15rem}[hidden]{display:none!important}@media(max-width:820px){.browser{grid-template-columns:1fr;gap:28px}.selector{position:static;max-height:none;padding-right:0}.selector ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}}@media(max-width:560px){.selector ul{display:block}}
</style>
