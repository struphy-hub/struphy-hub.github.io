---
import Layout from '../../layouts/Layout.astro';
import rawBackgrounds from '../../data/kinetic-backgrounds.json';
import { toSlug } from '../../lib/catalogue';

const backgrounds = (rawBackgrounds as any[]).map((background) => ({
  ...background,
  slug: toSlug(background.className),
}));

// The 1-D profile along the first velocity axis, drawn small enough to sit on a
// card: enough to tell a Maxwellian from a shifted or anisotropic one at a glance.
function linePoints(values: number[], width = 260, height = 90) {
  const finite = values.map((value) => (Number.isFinite(value) ? value : 0));
  const min = Math.min(...finite);
  const max = Math.max(...finite);
  const span = max - min || 1;
  return finite
    .map((value, index) => `${(index / Math.max(1, finite.length - 1)) * width},${height - ((value - min) / span) * height}`)
    .join(' ');
}
---

<Layout
  title="Kinetic backgrounds — Struphy"
  description="Browse the kinetic backgrounds available in Struphy: the velocity-space distributions f₀ that kinetic species are initialized from and weighted against."
>
  <main>
    <header class="intro">
      <p class="eyebrow">Velocity-space distributions</p>
      <h1>Kinetic backgrounds</h1>
      <p>
        A kinetic background is the distribution <strong>f₀</strong> a kinetic species starts from. It sets the
        initial marker sampling, appears in the numerator of the particle weights, and is subtracted off again in
        the control-variate method that keeps PIC noise down. Where a fluid <a href="/equilibria/">equilibrium</a>
        {' '}describes a background in space, these describe one in velocity — each in its own velocity coordinates.
      </p>
    </header>

    <section class="catalogue" aria-label="Kinetic background catalogue">
      <div class="grid">
        {backgrounds.map((background) => (
          <a class="card" href={`/backgrounds/${background.slug}/`}>
            <div class="card-plot">
              {background.profiles.length > 0 ? (
                <svg viewBox="0 0 260 90" role="img" aria-label={`${background.className} distribution along ${background.profiles[0].axis}`} preserveAspectRatio="none">
                  <polyline points={linePoints(background.profiles[0].values)} fill="none" stroke="var(--cyan)" stroke-width="2" vector-effect="non-scaling-stroke" />
                </svg>
              ) : (
                <p class="no-plot">No velocity space</p>
              )}
            </div>
            <div class="card-body">
              <h2>{background.className}</h2>
              <p class="meta">
                {background.vdim === 0 ? 'vdim 0' : `vdim ${background.vdim} · ${background.velocityLabels.join(', ')}`}
                {background.volumeForm && <span class="tag">volume form</span>}
              </p>
              <p class="summary">{background.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section note" aria-labelledby="sampling-title">
      <h2 id="sampling-title">How these are sampled</h2>
      <p>
        Every plot on these pages is evaluated through struphy's own <code>reduced_eval</code>, which integrates the
        distribution over the phase-space axes that are not shown. Velocity space is sampled at the fixed logical
        point <code>η = (0.5, 0.5, 0.5)</code>; that choice only matters for backgrounds whose moments vary in
        space, but it keeps the plots comparable across classes. Each class is shown with its constructor defaults,
        so a background that looks symmetric here can still be shifted or sheared by the moments you give it in a
        parameter file.
      </p>
    </section>
  </main>
</Layout>

<style>
  .intro{max-width:820px;padding-block:clamp(56px,8vw,92px)}
  .eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}
  .intro>p:not(.eyebrow){color:var(--muted)}
  .intro a{color:var(--cyan)}
  .catalogue{padding-block:40px 20px;border-top:1px solid var(--rule)}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
  .card{display:flex;flex-direction:column;border:1px solid var(--rule);color:var(--paper);text-decoration:none}
  .card:hover{border-color:var(--cyan)}
  .card-plot{padding:14px 16px 0;background:var(--plot-bg)}
  .card-plot svg{display:block;width:100%;height:90px}
  .no-plot{margin:0;padding:33px 0;color:var(--muted);font-size:.8rem;text-align:center}
  .card-body{padding:14px 16px 16px}
  .card-body h2{margin:0;color:var(--cyan);font:650 .95rem/1.35 var(--mono);overflow-wrap:anywhere}
  .meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:7px 0 0;color:var(--muted);font:.76rem var(--mono)}
  .tag{padding:1px 6px;border:1px solid var(--rule)}
  .summary{margin:9px 0 0;color:var(--muted);font-size:.82rem;line-height:1.45}
  .section{padding-block:40px 64px;border-top:1px solid var(--rule);margin-top:44px}
  .note{max-width:820px}
  .note h2{margin:0 0 14px;font-size:1.15rem}
  .note p{margin:0;color:var(--muted)}
</style>
