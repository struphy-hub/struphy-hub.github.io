---
import Layout from '../../layouts/Layout.astro';
import Heatmap from '../../components/Heatmap.astro';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import rawBackgrounds from '../../data/kinetic-backgrounds.json';
import { toSlug } from '../../lib/catalogue';

function renderMath(html = '', items: any[] = []) {
  return items.reduce((result: string, { token, latex, display }: any) => {
    let rendered;
    try {
      rendered = katex.renderToString(latex, { displayMode: display, throwOnError: false, strict: false, output: 'html' });
    } catch {
      rendered = `<code>${latex}</code>`;
    }
    return result.split(token).join(display ? `<div class="math-display">${rendered}</div>` : rendered);
  }, html);
}

export function getStaticPaths() {
  return (rawBackgrounds as any[]).map((background) => ({
    params: { slug: toSlug(background.className) },
    props: { background },
  }));
}

const { background } = Astro.props;
const descriptionHtml = renderMath(background.descriptionHtml, background.descriptionMath);
const coordsLabel = background.vdim === 0
  ? 'no velocity space'
  : `${background.velocityLabels.join(', ')} (${background.velocityCoords})`;

// Moments are stored as [background, perturbation] pairs; everything else is a plain value.
const parameters = Object.entries(background.parameters ?? {}).map(([name, value]: [string, any]) => {
  const isMoment = Array.isArray(value) && value.length === 2;
  return {
    name,
    value: isMoment ? String(value[0]) : typeof value === 'object' ? JSON.stringify(value) : String(value),
    perturbation: isMoment ? value[1] : undefined,
    description: background.parameterDescriptions?.[name] ?? '',
  };
});

function linePoints(values: number[], width = 300, height = 150) {
  const finite = values.map((value) => (Number.isFinite(value) ? value : 0));
  const min = Math.min(...finite);
  const max = Math.max(...finite);
  const span = max - min || 1;
  return finite
    .map((value, index) => `${(index / Math.max(1, finite.length - 1)) * width},${height - ((value - min) / span) * height}`)
    .join(' ');
}

const range = (values: number[]) => {
  const finite = values.filter((value) => Number.isFinite(value));
  return { min: Math.min(...finite), max: Math.max(...finite) };
};
---

<Layout
  title={`${background.className} — Struphy kinetic backgrounds`}
  description={`${background.className}, a kinetic background distribution available in Struphy, in ${coordsLabel} velocity coordinates.`}
>
  <main>
    <header class="intro">
      <p class="eyebrow">Kinetic background</p>
      <h1>{background.className}</h1>
      <div class="prose" set:html={descriptionHtml}></div>
      <div class="actions">
        <a href="/backgrounds/">← All backgrounds</a>
        <a href={background.docsUrl}>Reference documentation ↗</a>
      </div>
    </header>

    <section class="section" aria-labelledby="coords-title">
      <h2 id="coords-title">Phase space</h2>
      <dl class="facts">
        <div><dt>Velocity dimension</dt><dd>{background.vdim}</dd></div>
        <div><dt>Velocity coordinates</dt><dd>{background.velocityCoords ?? '—'}</dd></div>
        <div><dt>Axes</dt><dd>{background.velocityLabels.length ? background.velocityLabels.join(' · ') : '—'}</dd></div>
        <div>
          <dt>Volume form</dt>
          <dd>{background.volumeForm ? 'yes — includes the velocity Jacobian' : 'no'}</dd>
        </div>
      </dl>
    </section>

    {background.slice && (
      <section class="section" aria-labelledby="slice-title">
        <h2 id="slice-title">Velocity-space distribution</h2>
        <p class="lead">
          f₀ over ({background.slice.axes.join(', ')}){background.vdim > 2 ? ', remaining velocity axes integrated out' : ''},
          at logical position <code>η = ({background.eta.join(', ')})</code>.
        </p>
        <div class="slice">
          <Heatmap
            values={background.slice.values}
            label={`f₀(${background.slice.axes.join(', ')})`}
            xLabel={background.slice.axes[0]}
            yLabel={background.slice.axes[1]}
          />
          <dl class="axis-ranges">
            {background.slice.axes.map((axis: string) => {
              const span = range(background.slice.coordinates[axis]);
              return <div><dt>{axis}</dt><dd>{span.min} to {span.max}</dd></div>;
            })}
          </dl>
        </div>
      </section>
    )}

    {background.profiles.length > 0 && (
      <section class="section" aria-labelledby="profiles-title">
        <h2 id="profiles-title">Reduced profiles</h2>
        <p class="lead">The distribution along each velocity axis, with every other phase-space axis integrated out.</p>
        <div class="profiles">
          {background.profiles.map((profile: any) => {
            const span = range(profile.values);
            const points = range(profile.coordinates);
            return (
              <figure>
                <svg viewBox="0 0 330 175" role="img" aria-label={`Distribution along ${profile.axis}, from ${span.min.toExponential(2)} to ${span.max.toExponential(2)}`}>
                  <g transform="translate(15 10)">
                    <rect width="300" height="150" fill="none" stroke="var(--rule)" />
                    <polyline points={linePoints(profile.values)} fill="none" stroke="var(--cyan)" stroke-width="2" />
                  </g>
                </svg>
                <figcaption>
                  <strong>{profile.axis}</strong>
                  <span>{points.min} to {points.max} · peak {span.max.toExponential(2)}</span>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="parameters-title">
      <h2 id="parameters-title">Parameters</h2>
      <p class="lead">
        Constructor defaults. Moments are given as a background value (a float or a callable) paired with an
        optional <a href="/perturbations/">perturbation</a>.
        {background.constructedWith.length > 0 && (
          <> This class cannot be built from defaults alone; the catalogue constructs it with <code>{background.constructedWith.join(', ')}</code>.</>
        )}
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Parameter</th><th>Default</th><th>Perturbation</th><th>Description</th></tr></thead>
          <tbody>
            {parameters.map((parameter) => (
              <tr>
                <td><code class="accent">{parameter.name}</code></td>
                <td><code>{parameter.value}</code></td>
                <td>{parameter.perturbation === undefined ? '—' : <code>{String(parameter.perturbation ?? 'None')}</code>}</td>
                <td>{parameter.description || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<style>
  .intro{max-width:850px;padding-block:clamp(50px,7vw,82px)}
  .eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  h1{margin:0 0 16px;font-size:clamp(2rem,5vw,3.6rem);line-height:1.08;overflow-wrap:anywhere}
  .actions{display:flex;flex-wrap:wrap;gap:22px;margin-top:22px}
  .actions a{color:var(--cyan)}
  .section{padding-block:40px 56px;border-top:1px solid var(--rule)}
  h2{margin:0 0 14px}
  .lead{max-width:820px;color:var(--muted)}
  .lead a{color:var(--cyan)}
  .prose{max-width:850px}
  .prose :global(p),.prose :global(li){color:var(--muted)}
  .prose :global(.math-display){max-width:100%;margin:14px 0;overflow-x:auto}
  .facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0;margin:0;border-top:1px solid var(--rule)}
  .facts div{padding:16px 20px 16px 0}
  .facts div+div{padding-left:20px;border-left:1px solid var(--rule)}
  dt{font-weight:700;font-size:.86rem}
  dd{margin:5px 0 0;color:var(--muted);font-size:.86rem}
  .slice{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:28px;align-items:start;margin-top:22px}
  .axis-ranges{margin:0}
  .axis-ranges div{padding-bottom:12px}
  .axis-ranges dt{font:600 .8rem var(--mono)}
  .profiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:22px}
  .profiles figure{margin:0}
  .profiles svg{display:block;width:100%;background:var(--plot-bg);border:1px solid var(--rule)}
  figcaption{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;margin-top:7px;color:var(--muted);font-size:.78rem}
  figcaption strong{color:var(--paper);font:650 .82rem var(--mono)}
  .table-wrap{max-width:100%;margin-top:20px;overflow-x:auto;border:1px solid var(--rule)}
  table{width:100%;border-collapse:collapse;font-size:.86rem}
  th,td{padding:11px 14px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:top}
  thead th{color:var(--muted);font:600 .74rem var(--mono);letter-spacing:.07em;text-transform:uppercase}
  tbody tr:last-child td{border-bottom:0}
  td{color:var(--muted)}
  td :global(code){color:var(--paper)}
  .accent{color:var(--cyan)!important}
  @media(max-width:760px){.slice{grid-template-columns:1fr}.facts div+div{padding-left:0;border-left:0;border-top:1px solid var(--rule)}}
</style>
