---
import Layout from '../layouts/Layout.astro';
import VtkHeroViewer from '../components/VtkHeroViewer.astro';
import rawModels from '../data/models.json';
import catalogueIndex from '../data/catalogue-index.json';
import allExamples from '../data/examples-index.json';
import { exampleConfig } from '../data/example-config';

const projectStats = [
  { value: rawModels.length, label: 'simulation models' },
  { value: 14, label: 'mapped domains' },
  { value: catalogueIndex.equilibria.length, label: 'equilibria' },
  { value: catalogueIndex.perturbations.length, label: 'perturbations' },
];

const links = {
  docs: 'https://struphy-hub.github.io/struphy',
  install: 'https://struphy-hub.github.io/struphy/sections/install.html',
  quickstart: 'https://struphy-hub.github.io/struphy/sections/quickstart.html',
  github: 'https://github.com/struphy-hub/struphy',
  tutorials: 'https://github.com/struphy-hub/struphy-tutorials',
  publications: 'https://nmpp.pages.mpcdf.de/codes/struphy/',
};

const featuredExamples = ['weak-landau-damping', 'orszag-tang-vortex', 'acoustic-pulse', 'vlasov-tokamak']
  .map((slug) => (allExamples as any[]).find((example) => example.slug === slug))
  .filter(Boolean) as any[];

const publications = [
  {
    title: 'The linearized Vlasov–Maxwell system as a Hamiltonian system',
    authors: 'Bell, Campos Pinto, Possanner, Sonnendrücker',
    venue: 'Journal of Computational Physics (2026)',
    url: 'https://doi.org/10.1016/j.jcp.2026.114765',
  },
  {
    title: 'Variational discretizations of ideal magnetohydrodynamics in smooth regime using structure-preserving finite elements',
    authors: 'Carlier, Campos-Pinto',
    venue: 'Journal of Computational Physics (2025)',
    url: 'https://doi.org/10.1016/j.jcp.2024.113647',
  },
  {
    title: 'Geometric Particle-In-Cell discretizations of a plasma hybrid model with kinetic ions and mass-less fluid electrons',
    authors: 'Li, Campos Pinto, Holderied, Possanner, Sonnendrücker',
    venue: 'arXiv (2023)',
    url: 'https://doi.org/10.48550/arxiv.2304.01891',
  },
  {
    title: 'High-Order Structure-Preserving Algorithms for Plasma Hybrid Models',
    authors: 'Possanner, Holderied, Li, Na, Bell, Hadjout, Güçlü',
    venue: 'Lecture Notes in Computer Science (2023)',
    url: 'https://doi.org/10.1007/978-3-031-38299-4_28',
  },
  {
    title: 'Magneto-hydrodynamic eigenvalue solver for axisymmetric equilibria based on smooth polar splines',
    authors: 'Holderied, Possanner',
    venue: 'Journal of Computational Physics (2022)',
    url: 'https://doi.org/10.1016/j.jcp.2022.111329',
  },
  {
    title: 'MHD-kinetic hybrid code based on structure-preserving finite elements with particles-in-cell',
    authors: 'Holderied, Possanner, Wang',
    venue: 'Journal of Computational Physics (2021)',
    url: 'https://doi.org/10.1016/j.jcp.2021.110143',
  },
];
---

<Layout
  title="Struphy — Structure-preserving simulation of plasma models"
  description="Struphy is an open-source Python package for the numerical solution of fluid, kinetic and hybrid plasma models with structure-preserving finite elements and particle-in-cell methods."
>
  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <h1 id="page-title">Struphy</h1>
        <p>
          Struphy is an open-source Python package for the numerical solution of fluid, kinetic and hybrid
          plasma models. Fields are discretized with structure-preserving (geometric) finite elements and kinetic
          species with particle-in-cell methods.
        </p>
        <div class="actions">
          <a class="button primary" href="/examples/">Examples</a>
          <a class="button secondary" href={links.github}>View on GitHub</a>
        </div>
      </div>

      <VtkHeroViewer />
    </section>

    <section class="project-proof" aria-label="Project snapshot">
      <ul>
        {projectStats.map((stat) => <li><strong>{stat.value}</strong><span>{stat.label}</span></li>)}
        <li><strong>MIT</strong><span>open-source license</span></li>
      </ul>
      <p class="health-links"><span>Generated from the current Struphy catalogue at build time.</span><a href="https://github.com/struphy-hub/struphy/releases">Releases</a><a href="https://github.com/struphy-hub/struphy/issues">Issue tracker</a><a href="https://github.com/struphy-hub/struphy-hub.github.io/actions/workflows/deploy.yml">Build status</a></p>
    </section>

    <section class="why" aria-labelledby="why-title">
      <div class="section-heading">
        <h2 id="why-title">Overview</h2>
        <p>
          Struphy provides a common interface for fluid, kinetic and hybrid plasma models, together with the
          discretization, time stepping and post-processing tools needed to run them.
        </p>
      </div>
      <div class="benefit-grid">
        <article><h3>Discretization</h3><p>Fields are represented in B-spline finite element spaces forming a discrete de Rham complex. Kinetic species are represented by weighted markers (particle-in-cell), with an optional δf method.</p></article>
        <article><h3>Models</h3><p>Fluid, kinetic and hybrid models are composed from shared propagators, so that the same substeps are reused across models.</p></article>
        <article><h3>Geometry</h3><p>Simulations run on mapped domains, including Cartesian, cylindrical and toroidal geometries, and on domains generated externally.</p></article>
        <article><h3>Implementation</h3><p>The interface is written in Python; performance-critical kernels are compiled. A simulation is defined by a model, a domain, an equilibrium, perturbations and numerical parameters, which are stored together with the output.</p></article>
      </div>
      <p class="why-actions"><a href="/numerics/">Numerical methods</a><a href="/search/">Search the catalogue</a><a href="/citation/">Citation and reproducibility</a></p>
    </section>

    <section class="explainer" aria-labelledby="explainer-title">
      <h2 id="explainer-title">What "structure-preserving" means</h2>
      <p class="intro">
        The equations of plasma physics have structural properties such as conservation of energy and mass
        and the divergence-free condition on the magnetic field. Standard discretizations satisfy these only
        up to truncation error, which can accumulate over long simulations. Struphy builds its finite element
        discretization on a discrete de Rham complex, for which the vector-calculus identities underlying these
        properties, such as ∇·(∇×A) = 0, hold at the discrete level up to round-off and not only in the limit of
        vanishing grid size. Conservation of energy additionally depends on the time discretization.
      </p>

      <figure class="derham">
        <svg viewBox="0 0 780 140" role="img" aria-labelledby="derham-title derham-desc">
          <title id="derham-title">The discrete de Rham complex</title>
          <desc id="derham-desc">
            Four compatible finite-element spaces are connected by the gradient, curl, and
            divergence operators: H1 maps to H(curl) via grad, H(curl) maps to H(div) via curl,
            and H(div) maps to L2 via div. Because these discrete spaces and operators commute
            exactly with their continuous counterparts, identities such as curl grad equals zero
            and div curl equals zero hold to machine precision, not just approximately.
          </desc>
          {[
            { x: 20, label: 'H¹', sub: 'scalar potentials' },
            { x: 220, label: 'H(curl)', sub: 'electric field' },
            { x: 440, label: 'H(div)', sub: 'magnetic field' },
            { x: 660, label: 'L²', sub: 'mass density' },
          ].map((node) => (
            <g transform={`translate(${node.x} 30)`}>
              <rect width="100" height="60" rx="4" class="node" />
              <text x="50" y="30" text-anchor="middle" class="node-label">{node.label}</text>
              <text x="50" y="46" text-anchor="middle" class="node-sub">{node.sub}</text>
            </g>
          ))}
          {[
            { x1: 122, x2: 218, label: 'grad' },
            { x1: 342, x2: 438, label: 'curl' },
            { x1: 562, x2: 658, label: 'div' },
          ].map((edge) => (
            <g>
              <line x1={edge.x1} y1="60" x2={edge.x2} y2="60" class="edge" marker-end="url(#arrow)" />
              <text x={(edge.x1 + edge.x2) / 2} y="50" text-anchor="middle" class="edge-label">{edge.label}</text>
            </g>
          ))}
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0L10 5L0 10z" class="arrowhead" />
            </marker>
          </defs>
        </svg>
        <figcaption>
          Discrete fields are elements of compatible finite element spaces connected by discrete
          operators, so that identities such as ∇·(∇×A) = 0 hold to round-off.
        </figcaption>
      </figure>
    </section>

    <section class="overview" aria-labelledby="models-title">
      <h2 id="models-title">Models</h2>
      <p class="intro">
        Struphy supports three classes of plasma models, all built on the same discretization.
      </p>
      <div class="model-list">
        <article>
          <h3>Fluid</h3>
          <p>Maxwell, MHD and multi-fluid models, discretized with compatible finite elements.</p>
        </article>
        <article>
          <h3>Kinetic</h3>
          <p>Vlasov and drift-kinetic models, represented by markers (particle-in-cell).</p>
        </article>
        <article>
          <h3>Hybrid</h3>
          <p>Coupled field–particle models, including MHD-kinetic models.</p>
        </article>
      </div>
    </section>

    <section class="quick-start" aria-labelledby="quick-start-title">
      <div>
        <h2 id="quick-start-title">Quick start</h2>
        <p>Install Struphy and compile its kernels.</p>
        <p>
          A simulation is defined by a model, a domain and grid, the discretization parameters and the time
          stepping, which are collected in one <code>Simulation</code> object; see{' '}
          <a href="/simulation/">building a simulation</a>.
        </p>
        <p class="more">
          Continue with the <a href={links.install}>installation guide</a>, the <a href={links.quickstart}>quick start guide</a>, and{' '}
          <a href={links.tutorials}>tutorials</a>.
        </p>
      </div>
      <div class="code-block">
        <button type="button" class="copy-button" data-copy-button aria-label="Copy installation commands">Copy</button>
        <pre aria-label="Struphy installation commands"><code data-copy-source><span>$</span> pip install struphy
<span>$</span> struphy compile</code></pre>
      </div>
    </section>

    <section class="featured-examples" aria-labelledby="featured-examples-title">
      <div class="section-heading">
        <h2 id="featured-examples-title">Featured examples</h2>
        <p>Several end-to-end runs illustrate the kinds of problems Struphy is built to solve.</p>
      </div>
      <div class="example-grid">
        {featuredExamples.map((example: any) => (
          <a class="example-card" href={example.href}>
            {example.thumbnail && <div class="example-thumb"><img src={example.thumbnail} alt={`Figure from the ${example.name} example`} loading="lazy" /></div>}
            <div class="example-body">
              <span class="example-tag">{example.model}</span>
              <h3>{example.name}</h3>
              <p>{exampleConfig[example.slug]?.category ?? 'Example'}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="publications" aria-labelledby="publications-title">
      <h2 id="publications-title">Publications</h2>
      <p class="intro">
        A selection of papers on the methods and algorithms implemented in Struphy. See the{' '}
        <a href={links.publications}>full publication list</a> for more.
      </p>
      <ul class="publication-list">
        {publications.map((pub) => (
          <li>
            <a href={pub.url}>{pub.title}</a>
            <p class="pub-meta">{pub.authors} — {pub.venue}</p>
          </li>
        ))}
      </ul>
    </section>

    <aside class="next-page" aria-label="Domains">
      <strong>See also:</strong> the <a href="/domains/">domains</a> used by Struphy models and the
      <a href="/perturbations/">initial-condition perturbations</a>.
    </aside>
  </main>
</Layout>

<script>
  function mountCopyButton() {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-button]');
    const source = document.querySelector<HTMLElement>('[data-copy-source]');
    if (!button || !source) return;

    button.onclick = async () => {
      const text = source.innerText.replace(/\$\s?/g, '').trim();
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy'; }, 1800);
      } catch {
        button.textContent = 'Copy failed';
        setTimeout(() => { button.textContent = 'Copy'; }, 1800);
      }
    };
  }

  mountCopyButton();
  document.addEventListener('astro:page-load', mountCopyButton);
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(380px, 1.08fr);
    gap: clamp(40px, 7vw, 88px);
    align-items: center;
    padding-block: clamp(64px, 9vw, 112px);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 680px;
    margin-bottom: 24px;
    font-size: clamp(2.35rem, 5vw, 4.35rem);
    line-height: 1.07;
    letter-spacing: -0.035em;
  }

  .hero-copy > p {
    max-width: 620px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-block;
    padding: 10px 17px;
    border: 1px solid var(--cyan);
    color: var(--paper);
    font-weight: 650;
    text-decoration: none;
  }

  .button.primary {
    background: var(--cyan);
    color: var(--ink);
  }

  .button:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  figure {
    margin: 0;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .project-proof,
  .why,
  .explainer,
  .overview,
  .quick-start,
  .featured-examples,
  .publications {
    border-top: 1px solid var(--rule);
    padding-block: clamp(48px, 7vw, 76px);
  }

  .project-proof { padding-block: 28px; }

  .project-proof ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-proof li { padding-right: 18px; }
  .project-proof li + li { padding-left: 18px; border-left: 1px solid var(--rule); }
  .project-proof strong { display: block; color: var(--paper); font: 700 1.35rem var(--mono); }
  .project-proof span { color: var(--muted); font-size: .78rem; }
  .project-proof > p { margin: 18px 0 0; color: var(--muted); font-size: .75rem; }
  .health-links { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .health-links a { color: var(--cyan); }

  .section-heading { max-width: 790px; }
  .section-heading > p { color: var(--muted); }
  .benefit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin-top: 34px; background: var(--rule); border: 1px solid var(--rule); }
  .benefit-grid article { min-height: 0; padding: 24px; background: var(--ink); }
  .benefit-grid p { margin: 0; color: var(--muted); font-size: .93rem; }
  .why-actions { display: flex; flex-wrap: wrap; gap: 22px; margin: 24px 0 0; }
  .why-actions a { color: var(--cyan); }

  h2 {
    margin-bottom: 12px;
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  .intro {
    max-width: 720px;
    color: var(--muted);
  }

  .explainer .intro {
    font-size: 1.05rem;
  }

  .derham {
    margin: 32px 0 0;
    max-width: 100%;
  }

  .derham svg {
    display: block;
    width: 100%;
    max-width: 780px;
    height: auto;
  }

  .derham .node {
    fill: var(--accent-wash);
    stroke: var(--cyan);
    stroke-width: 1.2;
  }

  .derham .node-label {
    fill: var(--paper);
    font: 700 15px var(--mono);
  }

  .derham .node-sub {
    fill: var(--muted);
    font: 10px var(--sans);
  }

  .derham .edge {
    stroke: var(--cyan);
    stroke-width: 1.4;
  }

  .derham .edge-label {
    fill: var(--muted);
    font: italic 12px var(--sans);
  }

  .derham .arrowhead {
    fill: var(--cyan);
  }

  .derham figcaption {
    margin-top: 4px;
  }

  .example-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-top: 30px;
  }

  .example-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--rule);
    color: var(--paper);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .example-card:hover {
    border-color: var(--cyan);
    transform: translateY(-2px);
  }

  .example-thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #fff;
  }

  .example-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .example-body {
    display: grid;
    gap: 8px;
    padding: 16px 18px 18px;
  }

  .example-tag {
    color: var(--cyan);
    font: 600 0.7rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .example-body h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .example-body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .publication-list {
    display: grid;
    gap: 0;
    margin: 30px 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .publication-list li {
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .publication-list a {
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 0.2em;
  }

  .publication-list a:hover {
    color: var(--cyan);
    text-decoration: underline;
  }

  .pub-meta {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .model-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 38px;
    border-top: 1px solid var(--rule);
  }

  .model-list article {
    padding: 28px 30px 0 0;
  }

  .model-list article + article {
    padding-left: 30px;
    border-left: 1px solid var(--rule);
  }

  h3 {
    margin-bottom: 8px;
    font-size: 1.15rem;
  }

  .model-list p,
  .quick-start p {
    color: var(--muted);
  }

  .quick-start {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 8vw, 96px);
    align-items: start;
  }

  .quick-start p {
    margin-bottom: 8px;
  }

  .more {
    font-size: 0.95rem;
  }

  .code-block {
    position: relative;
  }

  pre {
    max-width: 100%;
    margin: 0;
    padding: 22px 24px;
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: var(--code-bg);
    color: var(--paper);
    font: 0.95rem/1.9 var(--mono);
  }

  code span {
    color: var(--cyan);
  }

  .copy-button {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 5px 10px;
    border: 1px solid var(--rule);
    background: var(--ink);
    color: var(--muted);
    cursor: pointer;
    font: 600 0.75rem/1.4 var(--sans);
  }

  .copy-button:hover { color: var(--paper); border-color: var(--cyan); }

  .next-page {
    padding: 20px 0 48px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .next-page strong {
    color: var(--paper);
  }

  .next-page a {
    color: var(--cyan);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 56px;
    }

    figure {
      max-width: 600px;
    }

    .model-list,
    .quick-start,
    .example-grid {
      grid-template-columns: 1fr;
    }

    .model-list article,
    .model-list article + article {
      padding: 24px 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }

    .quick-start {
      gap: 24px;
    }

    .project-proof ul { grid-template-columns: repeat(2, 1fr); }
    .project-proof li, .project-proof li + li { padding: 12px; border: 0; border-bottom: 1px solid var(--rule); }
    .benefit-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 400px) {
    h1 {
      font-size: 2.15rem;
    }

    .actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      text-align: center;
    }

    pre {
      padding: 18px 16px;
      font-size: 0.82rem;
    }
  }
</style>
