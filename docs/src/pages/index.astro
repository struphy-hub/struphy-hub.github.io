---
import Layout from '../layouts/Layout.astro';

const links = {
  docs: 'https://struphy-hub.github.io/struphy',
  github: 'https://github.com/struphy-hub/struphy',
  pypi: 'https://pypi.org/project/struphy/',
  tutorials: 'https://github.com/struphy-hub/struphy-tutorials',
};
---

<Layout
  title="Struphy — Structure-preserving plasma physics in Python"
  description="Struphy is an open-source Python package for structure-preserving simulations of fluid, kinetic, and hybrid plasma models."
>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Struphy home">Struphy</a>
    <nav aria-label="Primary navigation">
      <a href="/models/">Models</a>
      <a href="/domains/">Domains</a>
      <a href="/equilibria/">Equilibria</a>
      <a href={links.docs}>Documentation</a>
      <a href={links.github}>GitHub</a>
      <a href={links.pypi}>PyPI</a>
      <a href={links.tutorials}>Tutorials</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <h1 id="page-title">Structure-preserving plasma physics in Python.</h1>
        <p>
          Struphy is an open-source framework for solving fluid, kinetic, and hybrid
          plasma models with geometric finite elements and Lagrangian particles.
        </p>
        <div class="actions">
          <a class="button primary" href={links.docs}>Get started</a>
          <a class="button secondary" href={links.github}>View on GitHub</a>
        </div>
      </div>

      <figure>
        <img
          src="/images/gvec-domain.webp"
          width="1800"
          height="1400"
          alt="Curved wireframe GVEC unit domain generated with Struphy"
        />
        <figcaption>GVEC unit domain generated with Struphy.</figcaption>
      </figure>
    </section>

    <section class="overview" aria-labelledby="models-title">
      <h2 id="models-title">Models</h2>
      <p class="intro">
        A common numerical framework supports several descriptions of plasma
        dynamics while preserving their underlying geometric structure.
      </p>
      <div class="model-list">
        <article>
          <h3>Fluid</h3>
          <p>Maxwell, MHD, and multi-fluid systems using compatible finite elements.</p>
        </article>
        <article>
          <h3>Kinetic</h3>
          <p>Vlasov and drift-kinetic models represented by Lagrangian particles.</p>
        </article>
        <article>
          <h3>Hybrid</h3>
          <p>Coupled field-particle descriptions, including MHD-kinetic models.</p>
        </article>
      </div>
    </section>

    <section class="quick-start" aria-labelledby="quick-start-title">
      <div>
        <h2 id="quick-start-title">Quick start</h2>
        <p>Install Struphy and compile its performance-critical kernels.</p>
        <p class="more">
          Continue with the <a href={links.docs}>installation guide</a> and
          <a href={links.tutorials}>tutorials</a>.
        </p>
      </div>
      <pre aria-label="Struphy installation commands"><code><span>$</span> pip install struphy
<span>$</span> struphy compile</code></pre>
    </section>

    <aside class="next-page" aria-label="Domains">
      <strong>Geometry:</strong> <a href="/domains/">Explore domains</a> used by Struphy models.
    </aside>
  </main>

  <footer>
    <p>Struphy is open-source software released under the MIT License.</p>
    <p>Built by the Struphy community.</p>
  </footer>
</Layout>

<style>
  :global(:root) {
    --ink: #07131d;
    --paper: #eeeadd;
    --cyan: #63eee6;
    --muted: #a9b7bb;
    --rule: rgba(238, 234, 221, 0.2);
    --sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  :global(body) {
    color: var(--paper);
    font-family: var(--sans);
    line-height: 1.6;
  }

  .site-header,
  main,
  footer {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border-bottom: 1px solid var(--rule);
  }

  .brand {
    color: var(--paper);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px 24px;
  }

  nav a,
  .more a {
    color: var(--cyan);
    text-underline-offset: 0.2em;
  }

  nav a {
    font-size: 0.925rem;
    text-decoration: none;
  }

  nav a:hover,
  .more a:hover {
    text-decoration: underline;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(380px, 1.08fr);
    gap: clamp(40px, 7vw, 88px);
    align-items: center;
    padding-block: clamp(64px, 9vw, 112px);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 680px;
    margin-bottom: 24px;
    font-size: clamp(2.35rem, 5vw, 4.35rem);
    line-height: 1.07;
    letter-spacing: -0.035em;
  }

  .hero-copy > p {
    max-width: 620px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-block;
    padding: 10px 17px;
    border: 1px solid var(--cyan);
    color: var(--paper);
    font-weight: 650;
    text-decoration: none;
  }

  .button.primary {
    background: var(--cyan);
    color: var(--ink);
  }

  .button:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  figure {
    margin: 0;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .overview,
  .quick-start {
    border-top: 1px solid var(--rule);
    padding-block: clamp(48px, 7vw, 76px);
  }

  h2 {
    margin-bottom: 12px;
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  .intro {
    max-width: 720px;
    color: var(--muted);
  }

  .model-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 38px;
    border-top: 1px solid var(--rule);
  }

  .model-list article {
    padding: 28px 30px 0 0;
  }

  .model-list article + article {
    padding-left: 30px;
    border-left: 1px solid var(--rule);
  }

  h3 {
    margin-bottom: 8px;
    font-size: 1.15rem;
  }

  .model-list p,
  .quick-start p {
    color: var(--muted);
  }

  .quick-start {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 8vw, 96px);
    align-items: start;
  }

  .quick-start p {
    margin-bottom: 8px;
  }

  .more {
    font-size: 0.95rem;
  }

  pre {
    max-width: 100%;
    margin: 0;
    padding: 22px 24px;
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: #0b1a25;
    color: var(--paper);
    font: 0.95rem/1.9 var(--mono);
  }

  code span {
    color: var(--cyan);
  }

  .next-page {
    padding: 20px 0 48px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .next-page strong {
    color: var(--paper);
  }

  .next-page a {
    color: var(--cyan);
    text-underline-offset: 0.2em;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 26px 38px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.85rem;
  }

  footer p {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      padding-block: 18px;
    }

    nav {
      justify-content: flex-start;
    }

    .hero {
      grid-template-columns: 1fr;
      padding-block: 56px;
    }

    figure {
      max-width: 600px;
    }

    .model-list,
    .quick-start {
      grid-template-columns: 1fr;
    }

    .model-list article,
    .model-list article + article {
      padding: 24px 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }

    .quick-start {
      gap: 24px;
    }

    footer {
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (max-width: 400px) {
    .site-header,
    main,
    footer {
      width: min(100% - 28px, 1120px);
    }

    nav {
      gap: 8px 16px;
    }

    h1 {
      font-size: 2.15rem;
    }

    .actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      text-align: center;
    }

    pre {
      padding: 18px 16px;
      font-size: 0.82rem;
    }
  }
</style>
