  h1{margin:0 0 20px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}
  .standfirst{color:var(--muted);font-size:1.12rem;line-height:1.6}
  .section{padding-block:44px 62px;border-top:1px solid var(--rule)}
  h2{margin:0 0 20px;font-size:clamp(1.4rem,2.6vw,1.85rem)}
  h3{margin:34px 0 12px;font-size:1.1rem}
  .prose{max-width:720px}
  .prose p{margin:0 0 16px;color:var(--muted);line-height:1.68}
  .prose p:last-child{margin-bottom:0}
  .prose strong{color:var(--paper);font-weight:650}
  .prose a{color:var(--cyan)}
  .aside{margin-top:20px!important;padding-left:14px;border-left:2px solid var(--cyan);font-size:.9rem}
