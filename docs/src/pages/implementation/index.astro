  .layer{padding:20px 22px;background:var(--ink)}
  .layer h3{margin:0 0 12px;color:var(--cyan);font:650 .8rem var(--mono);letter-spacing:.08em;text-transform:uppercase}
  .layer dl{margin:0;display:grid;gap:12px}
  .layer dt{margin:0}
  .layer dd{margin:2px 0 0;color:var(--muted);font-size:.88rem;line-height:1.5}
  .table-wrap{max-width:960px;margin:28px 0 0;overflow-x:auto}
  .levels{width:100%;border-collapse:collapse;font-size:.88rem}
  .levels th,.levels td{padding:12px 14px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:top;line-height:1.5}
  .levels thead th{color:var(--muted);font:600 .74rem var(--mono);letter-spacing:.06em;text-transform:uppercase}
  .levels tbody th{color:var(--paper);font-weight:650;white-space:nowrap}
  .levels td{color:var(--muted)}
  .levels code{font-size:.8rem}
