---
import Layout from '../../layouts/Layout.astro';

const channels = [
  {
    eyebrow: 'Questions and ideas',
    title: 'Start a discussion',
    description: 'Ask how to use Struphy, compare approaches, or propose a feature in the community forum.',
    href: 'https://github.com/struphy-hub/struphy/discussions',
    action: 'Open GitHub Discussions',
  },
  {
    eyebrow: 'Bugs and tasks',
    title: 'Report an issue',
    description: 'Found a reproducible problem? Share the version, configuration, traceback, and expected result.',
    href: 'https://github.com/struphy-hub/struphy/issues/new/choose',
    action: 'Create a GitHub issue',
  },
  {
    eyebrow: 'Contributions',
    title: 'Work with us',
    description: 'Read the contribution guide before opening a pull request or planning a larger change.',
    href: 'https://github.com/struphy-hub/struphy/blob/main/CONTRIBUTING.md',
    action: 'Read the contribution guide',
  },
];

const maintainers = [
  {
    name: 'Stefan Possanner',
    email: 'stefan.possanner@ipp.mpg.de',
    github: 'spossann',
  },
  {
    name: 'Max Lindqvist',
    email: 'max.lindqvist@ipp.mpg.de',
    github: 'max-models',
  },
];
---

<Layout
  title="Contact us — Struphy"
  description="Ask questions, report bugs, contribute, or contact the Struphy maintainers."
>
  <main>
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Community support</p>
      <h1 id="page-title">Contact us</h1>
      <p>
        Choose the channel that best fits your message. Public questions and bug reports help answers remain
        discoverable for the whole Struphy community.
      </p>
    </section>

    <section class="channel-grid" aria-label="Contact channels">
      {channels.map((channel) => (
        <article class="channel">
          <p class="eyebrow">{channel.eyebrow}</p>
          <h2>{channel.title}</h2>
          <p>{channel.description}</p>
          <a href={channel.href}>{channel.action}<span aria-hidden="true"> →</span></a>
        </article>
      ))}
    </section>

    <section class="section maintainer-section" aria-labelledby="maintainers-title">
      <div>
        <p class="eyebrow">Direct contact</p>
        <h2 id="maintainers-title">Maintainers</h2>
        <p class="section-copy">
          For private or project-level enquiries, contact a maintainer directly. Please use GitHub for technical
          support whenever the conversation can be public.
        </p>
      </div>
      <ul class="maintainers">
        {maintainers.map((maintainer) => (
          <li>
            <strong>{maintainer.name}</strong>
            <a href={`mailto:${maintainer.email}`}>{maintainer.email}</a>
            <a class="github" href={`https://github.com/${maintainer.github}`}>@{maintainer.github}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section response-note" aria-labelledby="before-title">
      <h2 id="before-title">Before you write</h2>
      <ul>
        <li>Search the <a href="https://github.com/struphy-hub/struphy/issues">existing issues</a> and <a href="https://github.com/struphy-hub/struphy/discussions">discussions</a>.</li>
        <li>Include your Struphy version, operating system, and the smallest configuration that reproduces the problem.</li>
        <li>Do not post passwords, access tokens, private datasets, or other sensitive information.</li>
      </ul>
      <p>
        You can also follow project updates on the <a href="https://www.linkedin.com/company/struphy/">Struphy LinkedIn page</a>.
      </p>
    </section>
  </main>
</Layout>

<style>
  .intro{max-width:800px;padding-block:clamp(54px,8vw,88px)}
  .eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}
  .intro>p:not(.eyebrow),.section-copy{color:var(--muted)}
  .channel-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding-bottom:56px}
  .channel{display:flex;min-height:260px;padding:24px;flex-direction:column;border:1px solid var(--rule)}
  .channel h2{margin:4px 0 10px;font-size:1.35rem}
  .channel>p:not(.eyebrow){margin:0;color:var(--muted)}
  .channel a{margin-top:auto;padding-top:28px;color:var(--cyan);font-weight:650;text-decoration:none}
  .channel a:hover{text-decoration:underline}
  .section{padding-block:44px 58px;border-top:1px solid var(--rule)}
  .section h2{margin:0 0 9px;font-size:1.65rem}
  .maintainer-section{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.9fr);gap:clamp(36px,7vw,90px)}
  .section-copy{max-width:600px;margin:0}
  .maintainers{display:grid;gap:12px;margin:0;padding:0;list-style:none}
  .maintainers li{display:grid;grid-template-columns:1fr auto;gap:2px 20px;padding:16px 18px;border:1px solid var(--rule)}
  .maintainers strong{grid-column:1/-1}
  .maintainers a{color:var(--cyan);font-size:.84rem;overflow-wrap:anywhere}
  .maintainers .github{color:var(--muted);font-family:var(--mono);text-decoration:none}
  .response-note{max-width:840px}
  .response-note ul{display:grid;gap:9px;margin:16px 0 20px;padding-left:22px;color:var(--muted)}
  .response-note p{color:var(--muted)}
  .response-note a{color:var(--cyan)}
  @media(max-width:800px){.channel-grid{grid-template-columns:1fr}.channel{min-height:0}.maintainer-section{grid-template-columns:1fr}}
  @media(max-width:480px){.maintainers li{grid-template-columns:1fr}.maintainers strong{grid-column:auto}.maintainers .github{margin-top:5px}}
</style>
