---
import Layout from '../../layouts/Layout.astro';
import catalogueIndex from '../../data/catalogue-index.json';
const equilibria = catalogueIndex.equilibria;
---

<Layout title="Equilibria — Struphy" description="Browse equilibrium fields available for Struphy simulations.">
  <main>
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Background fields</p>
      <h1 id="page-title">Equilibria</h1>
      <p>Browse reference equilibria generated directly from Struphy. Each entry has shareable plots, parameters, and coordinate-line profiles.</p>
    </section>
    <section class="directory" aria-labelledby="directory-title">
      <div class="directory-heading">
        <div><p class="eyebrow">{equilibria.length} available</p><h2 id="directory-title">Choose an equilibrium</h2></div>
        <input type="search" data-filter placeholder="Filter equilibria…" aria-label="Filter equilibria" />
      </div>
      <div class="cards" data-items>
        {equilibria.map((equilibrium: any) => (
          <a class="card" href={`/equilibria/${equilibrium.slug}/`} data-search={equilibrium.type.toLowerCase()}>
            <code>{equilibrium.type}</code>
            <span>{equilibrium.parameterCount} parameters</span>
          </a>
        ))}
      </div>
      <p data-empty hidden>No equilibria match your search.</p>
    </section>
  </main>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let count = 0;
    items.forEach((item) => { const match = !query || (item.dataset.search || '').includes(query); item.hidden = !match; if (match) count += 1; });
    if (empty) empty.hidden = count > 0;
  });
</script>

<style>
  .intro { max-width: 760px; padding-block: clamp(56px,8vw,92px); }
  h1 { margin: 0 0 18px; font-size: clamp(2.35rem,5vw,4rem); line-height: 1.08; letter-spacing: -.035em; }
  .intro>p:not(.eyebrow), [data-empty] { color: var(--muted); }
  .eyebrow { margin: 0 0 7px; color: var(--muted); font: 600 .76rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .directory { padding-block: 40px 72px; border-top: 1px solid var(--rule); }
  .directory-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 24px; }
  h2 { margin: 0; font-size: 1.6rem; }
  input { width: min(100%,320px); padding: 10px 12px; border: 1px solid var(--rule); background: var(--ink); color: var(--paper); font: inherit; }
  .cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
  .card { display: flex; min-width: 0; padding: 18px; border: 1px solid var(--rule); color: var(--paper); text-decoration: none; flex-direction: column; gap: 8px; }
  .card:hover { border-color: var(--cyan); background: var(--accent-wash); }
  .card code { overflow-wrap: anywhere; color: var(--cyan); }
  .card span { color: var(--muted); font-size: .82rem; }
  @media(max-width:760px){.directory-heading{align-items:stretch;flex-direction:column}.cards{grid-template-columns:1fr 1fr}}
  @media(max-width:480px){.cards{grid-template-columns:1fr}}
</style>
