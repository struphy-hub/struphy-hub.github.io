---
import Layout from '../../layouts/Layout.astro';

const imported = import.meta.glob('../../data/equilibria/*.json', { eager: true, import: 'default' });
const equilibria = [...new Map(Object.entries(imported).map(([path, value]) => {
  const data = value as any;
  return { ...data, slug: path.split('/').pop()?.replace(/\.json$/, '') ?? data.name };
}).map((data) => [data.type, data])).values()].sort((a, b) => a.type.localeCompare(b.type));

function cells(values: number[][], size = 28) {
  const rows = values.length;
  const cols = rows ? values[0].length : 0;
  const flat = values.flat();
  const min = Math.min(...flat), max = Math.max(...flat), span = max - min || 1;
  return Array.from({ length: size * size }, (_, index) => {
    const x = index % size, y = Math.floor(index / size);
    const row = values[Math.min(rows - 1, Math.floor(y * rows / size))];
    const value = row?.[Math.min(cols - 1, Math.floor(x * cols / size))] ?? 0;
    return { x, y, value, intensity: (value - min) / span, min, max };
  });
}

function jet(intensity: number) {
  const i = Math.max(0, Math.min(1, intensity));
  const channel = (center: number) => Math.max(0, Math.min(1, 1.5 - Math.abs(4 * i - center)));
  return `rgb(${Math.round(channel(3) * 255)},${Math.round(channel(2) * 255)},${Math.round(channel(1) * 255)})`;
}

function linePoints(values: number[], width = 280, height = 150) {
  const finite = values.map((value) => Number.isFinite(value) ? value : 0);
  const min = Math.min(...finite), max = Math.max(...finite), span = max - min || 1;
  return finite.map((value, index) => `${(index / Math.max(1, finite.length - 1)) * width},${height - ((value - min) / span) * height}`).join(' ');
}
---
<Layout title="Equilibria — Struphy" description="Equilibrium fields and slices available in Struphy.">
  <main>
    <section class="intro"><p class="eyebrow">Background fields</p><h1>Equilibria</h1><p>Explore the reference equilibria used to initialize Struphy simulations. Each slice is generated from the corresponding Struphy equilibrium class during the site build.</p></section>
    {equilibria.length ? <section class="browser" aria-label="Available equilibria"><aside class="selector"><p class="eyebrow">Select an equilibrium</p><input type="search" class="equilibrium-filter" data-equilibrium-filter placeholder="Filter equilibria…" aria-label="Filter equilibria" /><div class="equilibrium-list" data-equilibrium-list>{equilibria.map((equilibrium, index) => <button type="button" class="equilibrium-option" data-equilibrium={equilibrium.slug} data-equilibrium-search={equilibrium.type.toLowerCase()} aria-pressed={index === 0}><code>{equilibrium.type}</code></button>)}</div><p class="empty-filter" data-equilibrium-filter-empty hidden>No equilibria match "<span data-equilibrium-filter-query></span>".</p></aside><div class="grid" aria-label="Selected equilibrium">
      {equilibria.map((equilibrium, index) => <article class="card" id={equilibrium.slug} data-equilibrium-card={equilibrium.slug} hidden={index !== 0}>
        <div class="card-heading"><div><p class="eyebrow">Equilibrium</p><h2>{equilibrium.type}</h2></div><button type="button" class="copy-link" data-copy-link={equilibrium.slug} aria-label={`Copy link to ${equilibrium.type}`}>Copy link</button></div>
        <div class="slice-tabs" role="tablist" aria-label={`${equilibrium.type} slice planes`}>{(['xy', 'xz', 'yz'] as const).map((plane, index) => <button type="button" role="tab" aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} aria-controls={`${equilibrium.slug}-${plane}`} data-slice-tab={`${equilibrium.slug}-${plane}`}>{plane.toUpperCase()}</button>)}</div>
        {(['xy', 'xz', 'yz'] as const).map((plane, planeIndex) => { const slice = equilibrium.slices?.[plane] ?? equilibrium.slice; return <div id={`${equilibrium.slug}-${plane}`} class="slice-panel" role="tabpanel" hidden={planeIndex !== 0}><div class="plots">{(['p', 'n'] as const).filter((field) => slice.fields[field]?.values).map((field) => { const data = cells(slice.fields[field].values); const min = data[0]?.min ?? 0; const max = data[0]?.max ?? 0; return <figure><div class="plot-wrap expandable" tabindex="0" role="button" aria-label={`Expand ${equilibrium.type} ${field === 'p' ? 'pressure' : 'density'} ${plane} plot`}><svg viewBox="0 0 340 300" role="img" aria-label={`${equilibrium.type} ${field} ${plane} plot`}><g transform="translate(38 10)">{data.map((cell) => <rect x={cell.x * 8.6} y={cell.y * 8.6} width="8.7" height="8.7" fill={jet(cell.intensity)} />)}<line x1="0" y1="241" x2="241" y2="241" /><line x1="0" y1="0" x2="0" y2="241" /><text x="120" y="265" text-anchor="middle">{slice.axes[0]}</text><text x="-24" y="120" text-anchor="middle" transform="rotate(-90 -24 120)">{slice.axes[1]}</text><text x="0" y="255">{slice.coordinates[slice.axes[0]][0].toFixed(1)}</text><text x="241" y="255" text-anchor="end">{slice.coordinates[slice.axes[0]].at(-1)?.toFixed(1)}</text><text x="-6" y="8" text-anchor="end">{slice.coordinates[slice.axes[1]].at(-1)?.toFixed(1)}</text><text x="-6" y="241" text-anchor="end">{slice.coordinates[slice.axes[1]][0].toFixed(1)}</text></g><defs><linearGradient id={`jet-${equilibrium.slug}-${plane}-${field}`} x1="0" x2="0" y1="1" y2="0"><stop offset="0%" stop-color={jet(0)} /><stop offset="25%" stop-color={jet(.25)} /><stop offset="50%" stop-color={jet(.5)} /><stop offset="75%" stop-color={jet(.75)} /><stop offset="100%" stop-color={jet(1)} /></linearGradient></defs><rect x="294" y="10" width="14" height="241" fill={`url(#jet-${equilibrium.slug}-${plane}-${field})`} /><text x="314" y="17">{max.toExponential(1)}</text><text x="314" y="250">{min.toExponential(1)}</text></svg></div><figcaption>{field === 'p' ? 'Pressure' : 'Density'} <code>{field}</code></figcaption></figure>})}</div><p class="meta">Coordinates: {slice.axes.join('–')} · value {slice.value}</p></div>})}
        {equilibrium.centerlines && <section class="centerline" aria-labelledby={`${equilibrium.slug}-centerline`}><h3 id={`${equilibrium.slug}-centerline`}>Coordinate-line profiles</h3><p class="meta">Each line varies one coordinate while the other two remain zero.</p><div class="line-plots">{(['x', 'y', 'z'] as const).map((axis) => { const line = equilibrium.centerlines[axis]; return <figure><figcaption><strong>{axis.toUpperCase()}-line</strong> <span>(other coordinates = 0)</span></figcaption><div class="plot-wrap expandable" tabindex="0" role="button" aria-label={`Expand ${equilibrium.type} ${axis}-line profile`}><svg viewBox="0 0 330 190" role="img" aria-label={`${equilibrium.type} ${axis}-line pressure and density profiles`}><g transform="translate(30 12)"><rect width="280" height="150" fill="none" stroke="var(--rule)" />{(['p', 'n'] as const).filter((field) => line.fields?.[field]).map((field) => { const values = line.fields[field]; const min = Math.min(...values), max = Math.max(...values); return <polyline points={linePoints(values)} fill="none" stroke={field === 'p' ? 'var(--cyan)' : '#f2b35d'} stroke-width="2" />})}<text x="140" y="178" text-anchor="middle">{axis}</text><text x="0" y="174">{line.coordinates[0].toFixed(1)}</text><text x="280" y="174" text-anchor="end">{line.coordinates.at(-1)?.toFixed(1)}</text><text x="-18" y="12">max</text><text x="-18" y="162">min</text></g></svg></div><div class="line-legend"><span class="pressure">Pressure <code>p</code></span><span class="density">Density <code>n</code></span></div></figure>})}</div></section>}
        <section class="parameters" aria-labelledby={`${equilibrium.slug}-parameters`}><h3 id={`${equilibrium.slug}-parameters`}>Parameters</h3><div class="parameter-table-wrap"><table><thead><tr><th scope="col">Parameter</th><th scope="col">Value</th><th scope="col">Description</th></tr></thead><tbody>{Object.entries(equilibrium.parameters ?? {}).map(([key, value]) => <tr><th scope="row"><code>{key}</code></th><td>{typeof value === 'object' ? JSON.stringify(value) : String(value)}</td><td>{equilibrium.parameter_descriptions?.[key] ?? '—'}</td></tr>)}</tbody></table></div></section>
      </article>)}
    </div></section> : <p class="empty">No equilibrium slices are available yet. They are generated automatically in CI.</p>}
  </main>
  <dialog class="lightbox" data-lightbox aria-label="Expanded plot">
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">Close ✕</button>
    <div class="lightbox-content" data-lightbox-content></div>
  </dialog>
</Layout>
<script is:inline>
  const options = [...document.querySelectorAll('.equilibrium-option')];
  const cards = [...document.querySelectorAll('[data-equilibrium-card]')];

  const selectEquilibrium = (slug, { updateHash = true } = {}) => {
    const option = options.find((item) => item.dataset.equilibrium === slug);
    if (!option) return;
    options.forEach((item) => item.setAttribute('aria-pressed', String(item === option)));
    cards.forEach((card) => { card.hidden = card.dataset.equilibriumCard !== slug; });
    if (updateHash && history.replaceState) history.replaceState(null, '', `#${slug}`);
  };

  options.forEach((option, index) => {
    option.addEventListener('click', () => selectEquilibrium(option.dataset.equilibrium));
    option.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const next = options[(index + (event.key === 'ArrowRight' ? 1 : -1) + options.length) % options.length];
      next.focus();
      selectEquilibrium(next.dataset.equilibrium);
    });
  });

  const setSliceTab = (tab) => {
    const panelId = tab.getAttribute('aria-controls');
    const root = tab.closest('.card');
    root?.querySelectorAll('[data-slice-tab]').forEach((item) => {
      const active = item === tab;
      item.setAttribute('aria-selected', String(active));
      item.tabIndex = active ? 0 : -1;
    });
    root?.querySelectorAll('.slice-panel').forEach((panel) => { panel.hidden = panel.id !== panelId; });
  };
  document.querySelectorAll('.slice-tabs').forEach((tablist) => {
    const tabs = [...tablist.querySelectorAll('[data-slice-tab]')];
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => setSliceTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
        next.focus();
        setSliceTab(next);
      });
    });
  });

  const hashSlug = decodeURIComponent(location.hash.replace(/^#/, ''));
  if (hashSlug && options.some((option) => option.dataset.equilibrium === hashSlug)) {
    selectEquilibrium(hashSlug, { updateHash: false });
  }

  const filterInput = document.querySelector('[data-equilibrium-filter]');
  const filterEmpty = document.querySelector('[data-equilibrium-filter-empty]');
  const filterQuery = document.querySelector('[data-equilibrium-filter-query]');
  filterInput?.addEventListener('input', () => {
    const query = filterInput.value.trim().toLowerCase();
    let visibleCount = 0;
    options.forEach((option) => {
      const matches = !query || (option.dataset.equilibriumSearch || '').includes(query);
      option.hidden = !matches;
      if (matches) visibleCount += 1;
    });
    if (filterEmpty) filterEmpty.hidden = visibleCount > 0;
    if (filterQuery) filterQuery.textContent = query;
  });

  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxContent = document.querySelector('[data-lightbox-content]');
  const openLightbox = (wrap) => {
    if (!lightbox || !lightboxContent) return;
    const svg = wrap.querySelector('svg');
    if (!svg) return;
    lightboxContent.innerHTML = '';
    const clone = svg.cloneNode(true);
    clone.removeAttribute('width');
    clone.removeAttribute('height');
    lightboxContent.appendChild(clone);
    const label = wrap.getAttribute('aria-label');
    if (label) lightbox.setAttribute('aria-label', label);
    lightbox.showModal();
  };
  document.querySelectorAll('.expandable').forEach((wrap) => {
    wrap.addEventListener('click', () => openLightbox(wrap));
    wrap.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openLightbox(wrap);
    });
  });
  document.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lightbox?.close());
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });

  document.querySelectorAll('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const slug = button.dataset.copyLink;
      const url = `${location.origin}${location.pathname}#${slug}`;
      try {
        await navigator.clipboard.writeText(url);
        const original = button.textContent;
        button.textContent = 'Copied!';
        setTimeout(() => { button.textContent = original; }, 1800);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
  });
</script>
<style>
  .equilibrium-option{color:var(--cyan);font-size:.925rem;text-decoration:none}
  .equilibrium-filter{width:100%;margin-bottom:10px;padding:8px 10px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit;font-size:.87rem}
  .equilibrium-filter:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
  .empty-filter{margin:14px 0 0;color:var(--muted);font-size:.85rem}
  .copy-link{flex:none;padding:6px 11px;border:1px solid var(--rule);background:transparent;color:var(--muted);cursor:pointer;font:600 .78rem/1.4 var(--sans)}
  .copy-link:hover{color:var(--paper);border-color:var(--cyan)}
  .intro{padding-block:clamp(56px,8vw,92px);max-width:760px}h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}.intro>p:not(.eyebrow){color:var(--muted);font-size:1.1rem}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}.browser{display:grid;grid-template-columns:minmax(250px,300px) minmax(0,1fr);gap:48px;border-top:1px solid var(--rule);padding-block:40px 64px}.selector{position:sticky;top:24px;align-self:start;min-width:0}.equilibrium-list{max-height:600px;overflow:auto;border-top:1px solid var(--rule)}.equilibrium-option{display:block;width:100%;padding:11px 8px;border:0;border-bottom:1px solid var(--rule);background:none;text-align:left;cursor:pointer}.equilibrium-option small{display:block;margin-top:2px;color:var(--muted);font:.72rem var(--mono)}.equilibrium-option:hover,.equilibrium-option:focus-visible,.equilibrium-option[aria-pressed="true"]{background:var(--accent-wash);color:var(--paper)}.grid{min-width:0}.card{border:1px solid var(--rule);padding:20px}.card-heading{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.card h2{margin:0 0 18px;font-size:1.45rem;overflow-wrap:anywhere}.slice-tabs{display:flex;gap:0 24px;border-bottom:1px solid var(--rule);margin:4px 0 18px}.slice-tabs button{padding:10px 0 8px;border:0;border-bottom:2px solid transparent;background:none;color:var(--muted);cursor:pointer;font:inherit;font-size:.9rem}.slice-tabs button[aria-selected="true"]{border-bottom-color:var(--cyan);color:var(--paper)}.plots{display:grid;grid-template-columns:1fr 1fr;gap:12px}.plots figure{margin:0}.plots svg{display:block;width:100%;height:auto;border:1px solid var(--rule);background:var(--plot-bg)}.plots line{stroke:var(--paper);stroke-width:.7}.plots text{fill:var(--muted);font:7px var(--mono)}figcaption{margin-top:7px;color:var(--muted);font-size:.86rem}.parameters{margin-top:30px;border-top:1px solid var(--rule);padding-top:20px}.parameters h3{margin:0 0 12px;font-size:1.05rem}.parameters dl{display:grid;grid-template-columns:minmax(110px,.35fr) minmax(0,1fr);margin:0;font-size:.84rem}.parameters dt,.parameters dd{margin:0;padding:7px 0;border-bottom:1px solid var(--rule)}.parameters dd{color:var(--muted);overflow-wrap:anywhere}.empty{padding:40px 0 64px;color:var(--muted)}@media(max-width:600px){main{width:calc(100% - 28px)}.browser{grid-template-columns:1fr;gap:28px}.selector{position:static}.equilibrium-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-height:none}.equilibrium-option{border-right:1px solid var(--rule)}.grid{grid-template-columns:1fr}.plots{gap:8px}}
</style>
<style>
  .centerline { margin-top: 32px; border-top: 1px solid var(--rule); padding-top: 20px; }
  .centerline h3 { margin: 0; font-size: 1.05rem; }
  .line-plots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 14px; }
  .line-plots figure { margin: 0; }
  .line-plots svg { display: block; width: 100%; height: auto; background: var(--plot-bg); border: 1px solid var(--rule); }
  .line-plots text { fill: var(--paper); font: 10px var(--mono); }
  .line-plots figcaption { margin: 0 0 6px; }
  .line-plots figcaption span { color: var(--muted); font-size: .78rem; }
  .line-legend { display: flex; gap: 14px; margin-top: 6px; color: var(--muted); font-size: .78rem; }
  .line-legend .pressure { color: var(--cyan); }
  .line-legend .density { color: #f2b35d; }
  @media (max-width: 600px) { .line-plots { grid-template-columns: 1fr; } }
</style>
<style>
  .plots text { font-size: 10px; fill: var(--paper); }
  .parameter-table-wrap { overflow-x: auto; }
  .parameter-table-wrap table { width: 100%; border-collapse: collapse; font-size: .84rem; }
  .parameter-table-wrap th, .parameter-table-wrap td { padding: 9px 12px; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .parameter-table-wrap thead th { color: var(--paper); font: 600 .72rem var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .parameter-table-wrap tbody th { width: 22%; font-weight: 400; }
  .parameter-table-wrap tbody td:nth-child(2) { width: 24%; color: var(--paper); font-family: var(--mono); overflow-wrap: anywhere; }
  .parameter-table-wrap tbody td:nth-child(3) { color: var(--muted); }

  .expandable { position: relative; cursor: zoom-in; }
  .expandable::after {
    content: '⤢';
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 2px 5px;
    border: 1px solid var(--rule);
    background: var(--ink);
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.4;
    pointer-events: none;
  }
  .expandable:hover::after,
  .expandable:focus-visible::after { color: var(--paper); border-color: var(--cyan); }
  .expandable:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }

  .lightbox {
    max-width: min(92vw, 900px);
    max-height: 90vh;
    padding: 20px;
    border: 1px solid var(--rule);
    background: var(--ink);
    color: var(--paper);
  }
  .lightbox::backdrop { background: rgba(0, 0, 0, .6); }
  .lightbox-close {
    float: right;
    padding: 6px 11px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: 600 .78rem/1.4 var(--sans);
  }
  .lightbox-close:hover { color: var(--paper); border-color: var(--cyan); }
  .lightbox-content { clear: both; margin-top: 12px; }
  .lightbox-content svg { display: block; width: 100%; height: auto; max-height: 78vh; }
</style>
