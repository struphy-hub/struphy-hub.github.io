---
import Layout from '../../layouts/Layout.astro';
import Heatmap from '../../components/Heatmap.astro';
import { excerpt, toSlug } from '../../lib/catalogue';

export function getStaticPaths() {
  const imported = import.meta.glob('../../data/equilibria/*.json', { eager: true, import: 'default' });
  return [...new Map(Object.values(imported).map((value: any) => [value.type, value])).values()].map((equilibrium: any) => ({
    params: { slug: toSlug(equilibrium.type) },
    props: { equilibrium },
  }));
}

const { equilibrium } = Astro.props;
const planes = ['xy', 'xz', 'yz'];
const description = excerpt(equilibrium.description_html || '', 240);

function linePoints(values: number[], width = 280, height = 150) {
  const finite = values.map((value) => Number.isFinite(value) ? value : 0);
  const min = Math.min(...finite), max = Math.max(...finite), span = max - min || 1;
  return finite.map((value, index) => `${(index / Math.max(1, finite.length - 1)) * width},${height - ((value - min) / span) * height}`).join(' ');
}
---

<Layout title={`${equilibrium.type} equilibrium — Struphy`} description={description || `${equilibrium.type}, an equilibrium available in Struphy.`}>
  <main>
    <header class="intro"><p class="eyebrow">Struphy equilibrium</p><h1>{equilibrium.type}</h1>{description && <p>{description}</p>}<a href="/equilibria/">← All equilibria</a></header>
    <section class="section" aria-labelledby="slices-title"><h2 id="slices-title">Coordinate slices</h2><p class="lead">Pressure and density sampled from the generated equilibrium data. Heatmaps use the perceptually uniform Viridis palette.</p>
      <div class="planes">{planes.map((plane) => { const slice = equilibrium.slices?.[plane] ?? equilibrium.slice; if (!slice) return null; return <article><h3>{plane.toUpperCase()} plane <small>at {slice.value}</small></h3><div class="plots">{['p','n'].filter((field) => slice.fields?.[field]?.values).map((field) => <Heatmap values={slice.fields[field].values} label={field === 'p' ? 'Pressure' : 'Density'} xLabel={slice.axes[0]} yLabel={slice.axes[1]} />)}</div></article>})}</div>
    </section>
    {equilibrium.centerlines && <section class="section" aria-labelledby="profiles-title"><h2 id="profiles-title">Coordinate-line profiles</h2><div class="profiles">{['x','y','z'].map((axis) => { const line = equilibrium.centerlines[axis]; if (!line) return null; return <figure><svg viewBox="0 0 310 175" role="img" aria-label={`${axis}-axis pressure and density profile`}><g transform="translate(15 10)"><rect width="280" height="150" fill="none" stroke="var(--rule)" />{line.fields?.p && <polyline points={linePoints(line.fields.p)} fill="none" stroke="var(--cyan)" stroke-width="2" />}{line.fields?.n && <polyline points={linePoints(line.fields.n)} fill="none" stroke="#d07720" stroke-width="2" />}</g></svg><figcaption>{axis.toUpperCase()}-line · <span>pressure</span> / density</figcaption></figure>})}</div></section>}
    <section class="section" aria-labelledby="parameters-title"><h2 id="parameters-title">Parameters</h2><div class="table-wrap"><table><thead><tr><th>Parameter</th><th>Value</th><th>Description</th></tr></thead><tbody>{Object.entries(equilibrium.parameters ?? {}).map(([key,value]) => <tr><th><code>{key}</code></th><td><code>{typeof value === 'object' ? JSON.stringify(value) : String(value)}</code></td><td>{equilibrium.parameter_descriptions?.[key] ?? '—'}</td></tr>)}</tbody></table></div></section>
  </main>
</Layout>

<style>
  .intro{max-width:820px;padding-block:clamp(50px,7vw,82px)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}h1{margin:0 0 16px;font-size:clamp(2.1rem,5vw,3.7rem);line-height:1.08;overflow-wrap:anywhere}.intro p:not(.eyebrow),.lead{color:var(--muted)}.intro a{color:var(--cyan)}.section{padding-block:42px 60px;border-top:1px solid var(--rule)}h2{margin:0 0 8px}.planes{display:grid;gap:34px;margin-top:28px}.planes article{padding:20px;border:1px solid var(--rule)}h3{margin:0 0 14px}h3 small{color:var(--muted);font-size:.75rem;font-weight:400}.plots{display:grid;grid-template-columns:1fr 1fr;gap:18px}.profiles{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.profiles figure{margin:0}.profiles svg{display:block;width:100%;background:var(--plot-bg)}.profiles figcaption{color:var(--muted);font-size:.82rem}.profiles span{color:var(--cyan)}.table-wrap{overflow:auto;margin-top:20px}table{width:100%;border-collapse:collapse;font-size:.86rem}th,td{padding:10px 12px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:top}thead th{font-size:.72rem;text-transform:uppercase}tbody th{font-weight:400}td:last-child{color:var(--muted)}@media(max-width:700px){.plots,.profiles{grid-template-columns:1fr}.planes article{padding:14px}}
</style>
