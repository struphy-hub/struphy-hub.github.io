---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Struphy" description="The page you requested could not be found.">
  <main class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <div class="actions">
      <a class="button primary" href="/">Back home</a>
      <a class="button secondary" href="/models/">Browse models</a>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    padding-block: clamp(64px, 12vw, 140px);
    max-width: 640px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--muted);
    font: 600 0.76rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-block;
    padding: 10px 17px;
    border: 1px solid var(--cyan);
    color: var(--paper);
    font-weight: 650;
    text-decoration: none;
  }

  .button.primary {
    background: var(--cyan);
    color: var(--ink);
  }

  .button:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
