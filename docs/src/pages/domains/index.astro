---
import Layout from '../../layouts/Layout.astro';
import VtkDomainViewer from '../../components/VtkDomainViewer.astro';

const links = {
  docs: 'https://struphy-hub.github.io/struphy',
  github: 'https://github.com/struphy-hub/struphy',
  pypi: 'https://pypi.org/project/struphy/',
  tutorials: 'https://github.com/struphy-hub/struphy-tutorials',
};

const domainNames = [
  'Colella', 'Cuboid', 'DESCunit', 'GVECunit', 'HollowCylinder', 'HollowTorus',
  'IGAPolarCylinder', 'IGAPolarTorus', 'Orthogonal', 'PoweredEllipticCylinder',
  'ShafranovDshapedCylinder', 'ShafranovShiftCylinder', 'ShafranovSqrtCylinder', 'Tokamak',
];
const domainDocsBase = 'https://struphy-hub.github.io/struphy/sections/subsections/domains-avail.html#struphy.geometry.domains.';
const domains = domainNames.map((name) => name === 'DESCunit'
  ? {
      name,
      docsUrl: `${domainDocsBase}${name}`,
      unavailableReason: 'The default domain requires DESC equilibrium data.',
    }
  : {
      name,
      url: `/domains/${name}.vtp`,
      docsUrl: `${domainDocsBase}${name}`,
    });
---

<Layout
  title="Domains — Struphy"
  description="An introduction to logical and physical domains in Struphy simulations."
>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Struphy home">Struphy</a>
    <nav aria-label="Primary navigation">
      <a href="/models/">Models</a>
      <a class="current" href="/domains/" aria-current="page">Domains</a><a href="/equilibria/">Equilibria</a>
      <a href={links.docs}>Documentation</a>
      <a href={links.github}>GitHub</a>
      <a href={links.pypi}>PyPI</a>
      <a href={links.tutorials}>Tutorials</a>
    </nav>
  </header>

  <main>
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Mapped geometries</p>
      <h1 id="page-title">Domains</h1>
      <p>
        Explore the logical-to-physical mappings used by Struphy models and numerical
        methods. Each geometry is generated from its Struphy domain class during the site build.
      </p>
    </section>

    <section class="browser" aria-label="Available domains">
      <VtkDomainViewer domains={domains} initialDomain="Cuboid" />
    </section>

    <section class="definitions" aria-labelledby="definitions-title">
      <h2 id="definitions-title">Two coordinate spaces</h2>
      <dl>
        <div>
          <dt>Logical domain</dt>
          <dd>The coordinate space where fields and basis functions are represented.</dd>
        </div>
        <div>
          <dt>Physical domain</dt>
          <dd>The mapped geometry used for a simulation.</dd>
        </div>
      </dl>
    </section>
  </main>

  <footer>
    <p>Struphy is open-source software released under the MIT License.</p>
    <p>Built by the Struphy community.</p>
  </footer>
</Layout>

<style>
  :global(:root) {
    --sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: ui-monospace, "SFMono-Regular", Consolas, monospace;
  }

  :global(body) {
    color: var(--paper);
    font-family: var(--sans);
    line-height: 1.6;
  }

  .site-header,
  main,
  footer {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border-bottom: 1px solid var(--rule);
  }

  .brand {
    color: var(--paper);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px 24px;
  }

  nav a {
    color: var(--cyan);
    font-size: 0.925rem;
    text-decoration: none;
  }

  nav a:hover,
  nav a.current {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .intro {
    padding-block: clamp(56px, 8vw, 92px);
    max-width: 760px;
  }

  h1 {
    margin: 0 0 18px;
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .intro > p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .eyebrow {
    margin: 0 0 7px;
    color: var(--muted);
    font: 600 0.76rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .browser {
    border-top: 1px solid var(--rule);
    padding-block: 40px 64px;
  }

  .definitions {
    border-top: 1px solid var(--rule);
    padding-block: clamp(44px, 6vw, 68px);
  }

  .definitions h2 {
    margin: 0 0 12px;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    line-height: 1.2;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  dl div {
    padding: 25px 28px 0 0;
  }

  dl div + div {
    padding-left: 28px;
    border-left: 1px solid var(--rule);
  }

  dt {
    margin-bottom: 6px;
    font-weight: 700;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 26px 38px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.85rem;
  }

  footer p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      padding-block: 18px;
    }

    nav {
      justify-content: flex-start;
    }

    dl {
      grid-template-columns: 1fr;
    }

    dl div,
    dl div + div {
      padding: 22px 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }

    footer {
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (max-width: 400px) {
    .site-header,
    main,
    footer {
      width: min(100% - 28px, 1120px);
    }

    nav {
      gap: 8px 16px;
    }

    h1 {
      font-size: 2.15rem;
    }
  }
</style>
