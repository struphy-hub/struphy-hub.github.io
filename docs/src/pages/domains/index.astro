---
import Layout from '../../layouts/Layout.astro';
import VtkDomainViewer from '../../components/VtkDomainViewer.astro';

const domainNames = [
  'Colella', 'Cuboid', 'DESCunit', 'GVECunit', 'HollowCylinder', 'HollowTorus',
  'IGAPolarCylinder', 'IGAPolarTorus', 'Orthogonal', 'PoweredEllipticCylinder',
  'ShafranovDshapedCylinder', 'ShafranovShiftCylinder', 'ShafranovSqrtCylinder', 'Tokamak',
];
const domainDocsBase = 'https://struphy-hub.github.io/struphy/sections/subsections/domains-avail.html#struphy.geometry.domains.';
const domains = domainNames.map((name) => name === 'DESCunit'
  ? {
      name,
      docsUrl: `${domainDocsBase}${name}`,
      unavailableReason: 'The default domain requires DESC equilibrium data.',
    }
  : {
      name,
      url: `/domains/${name}.vtp`,
      docsUrl: `${domainDocsBase}${name}`,
    });
---

<Layout
  title="Domains — Struphy"
  description="An introduction to logical and physical domains in Struphy simulations."
>
  <main>
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Mapped geometries</p>
      <h1 id="page-title">Domains</h1>
      <p>
        Explore the logical-to-physical mappings used by Struphy models and numerical
        methods. Each geometry is generated from its Struphy domain class during the site build.
      </p>
    </section>

    <section class="browser" aria-label="Available domains">
      <VtkDomainViewer domains={domains} initialDomain="Cuboid" />
    </section>

    <section class="definitions" aria-labelledby="definitions-title">
      <h2 id="definitions-title">Two coordinate spaces</h2>
      <dl>
        <div>
          <dt>Logical domain</dt>
          <dd>The coordinate space where fields and basis functions are represented.</dd>
        </div>
        <div>
          <dt>Physical domain</dt>
          <dd>The mapped geometry used for a simulation.</dd>
        </div>
      </dl>
    </section>
  </main>
</Layout>

<style>
  .intro {
    padding-block: clamp(56px, 8vw, 92px);
    max-width: 760px;
  }

  h1 {
    margin: 0 0 18px;
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .intro > p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .eyebrow {
    margin: 0 0 7px;
    color: var(--muted);
    font: 600 0.76rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .browser {
    border-top: 1px solid var(--rule);
    padding-block: 40px 64px;
  }

  .definitions {
    border-top: 1px solid var(--rule);
    padding-block: clamp(44px, 6vw, 68px);
  }

  .definitions h2 {
    margin: 0 0 12px;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    line-height: 1.2;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  dl div {
    padding: 25px 28px 0 0;
  }

  dl div + div {
    padding-left: 28px;
    border-left: 1px solid var(--rule);
  }

  dt {
    margin-bottom: 6px;
    font-weight: 700;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    dl {
      grid-template-columns: 1fr;
    }

    dl div,
    dl div + div {
      padding: 22px 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
  }

  @media (max-width: 400px) {
    main {
      width: min(100% - 28px, 1120px);
    }

    h1 {
      font-size: 2.15rem;
    }
  }
</style>
