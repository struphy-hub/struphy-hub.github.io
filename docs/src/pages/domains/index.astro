---
import Layout from '../../layouts/Layout.astro';
import VtkDomainViewer from '../../components/VtkDomainViewer.astro';

const links = {
  docs: 'https://struphy.readthedocs.io/en/latest/',
  github: 'https://github.com/struphy-hub/struphy',
  pypi: 'https://pypi.org/project/struphy/',
  tutorials: 'https://github.com/struphy-hub/struphy-tutorials',
};

const domainNames = [
  'Colella', 'Cuboid', 'DESCunit', 'GVECunit', 'HollowCylinder', 'HollowTorus',
  'IGAPolarCylinder', 'IGAPolarTorus', 'Orthogonal', 'PoweredEllipticCylinder',
  'ShafranovDshapedCylinder', 'ShafranovShiftCylinder', 'ShafranovSqrtCylinder', 'Tokamak',
];
const domainDocsBase = 'https://struphy.readthedocs.io/en/latest/sections/subsections/domains-avail.html#struphy.geometry.domains.';
const domains = domainNames.map((name) => name === 'DESCunit'
  ? {
      name,
      docsUrl: `${domainDocsBase}${name}`,
      unavailableReason: 'The default domain requires DESC equilibrium data.',
    }
  : {
      name,
      url: `/domains/${name}.vtp`,
      docsUrl: `${domainDocsBase}${name}`,
    });
---

<Layout
  title="Domains — Struphy"
  description="An introduction to logical and physical domains in Struphy simulations."
>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Struphy home">Struphy</a>
    <nav aria-label="Primary navigation">
      <a href="/models/">Models</a>
      <a class="current" href="/domains/" aria-current="page">Domains</a>
      <a href={links.docs}>Documentation</a>
      <a href={links.github}>GitHub</a>
      <a href={links.pypi}>PyPI</a>
      <a href={links.tutorials}>Tutorials</a>
    </nav>
  </header>

  <main>
    <section class="introduction" aria-labelledby="page-title">
      <h1 id="page-title">Domains</h1>
      <p>
        Struphy maps logical coordinates to physical geometries used by its models
        and numerical methods.
      </p>
    </section>

    <section class="catalogue" aria-labelledby="catalogue-title">
      <div class="catalogue-copy">
        <h2 id="catalogue-title">Domain catalogue</h2>
        <p>
          Select a domain to inspect its default geometry. Each available geometry
          was generated by Struphy and exported as VTK PolyData.
        </p>
      </div>
      <VtkDomainViewer domains={domains} initialDomain="Cuboid" />
    </section>

    <section class="definitions" aria-labelledby="definitions-title">
      <h2 id="definitions-title">Two coordinate spaces</h2>
      <dl>
        <div>
          <dt>Logical domain</dt>
          <dd>The coordinate space where fields and basis functions are represented.</dd>
        </div>
        <div>
          <dt>Physical domain</dt>
          <dd>The mapped geometry used for a simulation.</dd>
        </div>
      </dl>
    </section>
  </main>

  <footer>
    <p>Struphy is open-source software released under the MIT License.</p>
    <p>Built by the Struphy community.</p>
  </footer>
</Layout>

<style>
  :global(:root) {
    --ink: #07131d;
    --paper: #eeeadd;
    --cyan: #63eee6;
    --muted: #a9b7bb;
    --rule: rgba(238, 234, 221, 0.2);
    --sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global(body) {
    color: var(--paper);
    font-family: var(--sans);
    line-height: 1.6;
  }

  .site-header,
  main,
  footer {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border-bottom: 1px solid var(--rule);
  }

  .brand {
    color: var(--paper);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px 24px;
  }

  nav a {
    color: var(--cyan);
    font-size: 0.925rem;
    text-decoration: none;
  }

  nav a:hover,
  nav a.current {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h1,
  h2,
  p,
  dl,
  dd {
    margin-top: 0;
  }

  .introduction {
    padding-block: clamp(56px, 8vw, 92px);
  }

  h1 {
    margin-bottom: 18px;
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .introduction p {
    max-width: 680px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .catalogue,
  .definitions {
    border-top: 1px solid var(--rule);
    padding-block: clamp(44px, 6vw, 68px);
  }

  .catalogue {
    display: block;
  }

  h2 {
    margin-bottom: 12px;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    line-height: 1.2;
  }

  .catalogue-copy p {
    max-width: 620px;
    margin-bottom: 32px;
    color: var(--muted);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: 0;
    border-top: 1px solid var(--rule);
  }

  dl div {
    padding: 25px 28px 0 0;
  }

  dl div + div {
    padding-left: 28px;
    border-left: 1px solid var(--rule);
  }

  dt {
    margin-bottom: 6px;
    font-weight: 700;
  }

  dd {
    margin-left: 0;
    margin-bottom: 0;
    color: var(--muted);
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 26px 38px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.85rem;
  }

  footer p {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      padding-block: 18px;
    }

    nav {
      justify-content: flex-start;
    }

    dl {
      grid-template-columns: 1fr;
    }

    dl div,
    dl div + div {
      padding: 22px 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }

    footer {
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (max-width: 400px) {
    .site-header,
    main,
    footer {
      width: min(100% - 28px, 1120px);
    }

    nav {
      gap: 8px 16px;
    }

    h1 {
      font-size: 2.15rem;
    }
  }
</style>
