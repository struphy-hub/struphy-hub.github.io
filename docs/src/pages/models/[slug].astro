---
import Layout from '../../layouts/Layout.astro';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import rawCatalogue from '../../data/models.json';
import { toSlug } from '../../lib/catalogue';

const fields = ['pde','longDescription','normalization','discretization','scalarQuantities','useCases','cannotBeUsedFor','examples'];
function renderMath(html = '', items = []) { return items.reduce((result: string,{token,latex,display}: any)=>{let rendered;try{rendered=katex.renderToString(latex,{displayMode:display,throwOnError:false,strict:false,output:'html'})}catch{rendered=`<code>${latex}</code>`}return result.split(token).join(display?`<div class="math-display">${rendered}</div>`:rendered)},html); }
export function getStaticPaths() { return rawCatalogue.map((model: any)=>({params:{slug:toSlug(model.className)},props:{model}})); }
const { model: rawModel } = Astro.props;
const model: any = { ...rawModel };
for (const field of fields) model[`${field}Html`] = renderMath(model[`${field}Html`], model[`${field}Math`] ?? []);
const docsUrl = `https://struphy-hub.github.io/struphy/sections/subsections/models-all.html#struphy.models.${model.className}`;
---

<Layout title={`${model.className} model — Struphy`} description={model.description}>
  <main>
    <header class="intro"><p class="eyebrow">{model.type} model</p><h1>{model.className}</h1><p>{model.description}</p><div class="actions"><a href="/models/">← All models</a><a href={docsUrl}>Reference documentation ↗</a></div></header>
    <section class="section prose"><h2>Overview</h2><div set:html={model.longDescriptionHtml}></div><div class="split"><div><h3>Use cases</h3><div set:html={model.useCasesHtml}></div></div><div><h3>Limitations</h3><div set:html={model.cannotBeUsedForHtml}></div></div></div></section>
    <section class="section prose"><h2>Governing equations</h2><div set:html={model.pdeHtml}></div></section>
    <section class="section prose"><h2>Normalization</h2><div set:html={model.normalizationHtml}></div></section>
    <section class="section prose"><h2>Discretization</h2><div set:html={model.discretizationHtml}></div></section>
    <section class="section prose"><h2>Diagnostics</h2><div set:html={model.scalarQuantitiesHtml}></div></section>
    <section class="section prose"><h2>Example</h2><div set:html={model.examplesHtml}></div></section>
  </main>
</Layout>
<style>
  .intro{max-width:850px;padding-block:clamp(50px,7vw,82px)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}h1{margin:0 0 16px;font-size:clamp(2rem,5vw,3.7rem);line-height:1.08;overflow-wrap:anywhere}.intro>p:not(.eyebrow){color:var(--muted);font-size:1.08rem}.actions{display:flex;flex-wrap:wrap;gap:22px;margin-top:22px}.actions a{color:var(--cyan)}.section{padding-block:40px 56px;border-top:1px solid var(--rule)}h2{margin:0 0 18px}.split{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:30px}.prose{max-width:900px}.prose :global(p),.prose :global(li){color:var(--muted)}.prose :global(pre){max-width:100%;padding:18px;overflow:auto;border:1px solid var(--rule);background:var(--code-bg)}.prose :global(.math-display){max-width:100%;overflow:auto}.prose :global(table){display:block;max-width:100%;overflow:auto;border-collapse:collapse}.prose :global(th),.prose :global(td){padding:8px;border-bottom:1px solid var(--rule);text-align:left}@media(max-width:650px){.split{grid-template-columns:1fr}}
</style>
