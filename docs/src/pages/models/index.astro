---
import Layout from '../../layouts/Layout.astro';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import rawCatalogue from '../../data/models.json';

// Math is extracted server-side (build time) from real LaTeX docstrings and
// pre-rendered into static KaTeX markup here, so no math-rendering JS ships
// to the browser -- switching models client-side just swaps in this
// already-rendered HTML.
const MATH_FIELDS = [
  'pde', 'longDescription', 'normalization', 'discretization',
  'scalarQuantities', 'useCases', 'cannotBeUsedFor', 'examples',
];

function renderMath(html, mathItems) {
  if (!mathItems?.length) return html;
  return mathItems.reduce((result, { token, latex, display }) => {
    let rendered;
    try {
      rendered = katex.renderToString(latex, { displayMode: display, throwOnError: false, output: 'html' });
    } catch {
      rendered = `<code>${latex}</code>`;
    }
    const wrapped = display ? `<div class="math-display">${rendered}</div>` : rendered;
    return result.split(token).join(wrapped);
  }, html);
}

const catalogue = rawCatalogue.map((model) => {
  const resolved = { ...model };
  for (const field of MATH_FIELDS) {
    resolved[`${field}Html`] = renderMath(model[`${field}Html`], model[`${field}Math`]);
    delete resolved[`${field}Math`];
  }
  return resolved;
});

const docsBase = 'https://struphy-hub.github.io/struphy/';
const modelDocsUrl = (modelName) => `https://struphy-hub.github.io/struphy/sections/subsections/models-all.html#struphy.models.${modelName}`;
const categories = [
  { name: 'Fluid', description: 'Continuum field and fluid descriptions, including Maxwell, MHD, multi-fluid, variational fluid, and SPH formulations.' },
  { name: 'Kinetic', description: 'Particle-based Vlasov, drift-kinetic, guiding-center, and diffusion models.' },
  { name: 'Hybrid', description: 'Coupled fluid-field and kinetic-particle descriptions.' },
  { name: 'Toy', description: 'Compact reference models useful for examples and verification.' },
].map((category) => ({ ...category, id: category.name.toLowerCase(), models: catalogue.filter((model) => model.type === category.name) }));
const initialModel = catalogue[0];
---
<Layout title="Models — Struphy" description="The complete catalogue of fluid, kinetic, hybrid, and reference models available in Struphy.">
  <main>
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Simulation models</p>
      <h1 id="page-title">Models</h1>
      <p>Struphy provides fluid, kinetic, hybrid, and smaller toy and reference models within a common simulation framework.</p>
    </section>
    <section class="model-browser" aria-label="Model catalogue">
      <aside class="selector" aria-label="Select a model">
        <p class="eyebrow">Select a model</p>
        <input type="search" class="model-filter" data-model-filter placeholder="Filter models…" aria-label="Filter models" />
        <div class="selector-scroll" data-selector-scroll>
          {categories.map((category) => <section class="selector-group" data-selector-group aria-labelledby={`${category.id}-title`}><div class="selector-heading"><h2 id={`${category.id}-title`}>{category.name}</h2><span>{category.models.length}</span></div><div class="model-list">{category.models.map((model) => <button type="button" class="model-option" data-model={model.className} data-model-search={`${model.className} ${model.description}`.toLowerCase()} aria-pressed={model.className === initialModel.className}><code>{model.className}</code></button>)}</div></section>)}
        </div>
        <p class="empty-filter" data-model-filter-empty hidden>No models match "<span data-model-filter-query></span>".</p>
      </aside>
      <article class="detail" aria-live="polite">
        <div class="detail-heading"><div><p class="eyebrow" id="detail-type">{initialModel.type} model</p><h2 id="detail-name">{initialModel.className}</h2></div><div class="detail-heading-actions"><button type="button" class="copy-link" data-copy-link aria-label="Copy link to this model">Copy link</button><a id="detail-docs" class="docs-link" href={modelDocsUrl(initialModel.className)} target="_blank" rel="noreferrer">Read the docs ↗</a></div></div>
        <div class="tabs" role="tablist" aria-label="Model information">
          <button type="button" role="tab" id="tab-information" aria-selected="true" aria-controls="panel-information" tabindex="0">Overview</button>
          <button type="button" role="tab" id="tab-pde" aria-selected="false" aria-controls="panel-pde" tabindex="-1">PDE</button>
          <button type="button" role="tab" id="tab-normalization" aria-selected="false" aria-controls="panel-normalization" tabindex="-1">Normalization</button>
          <button type="button" role="tab" id="tab-discretization" aria-selected="false" aria-controls="panel-discretization" tabindex="-1">Discretization</button>
          <button type="button" role="tab" id="tab-diagnostics" aria-selected="false" aria-controls="panel-diagnostics" tabindex="-1">Diagnostics</button>
          <button type="button" role="tab" id="tab-examples" aria-selected="false" aria-controls="panel-examples" tabindex="-1">Examples</button>
        </div>
        <div id="panel-information" class="tab-panel generated-content" role="tabpanel" aria-labelledby="tab-information">
          <p id="detail-description">{initialModel.description}</p>
          <div id="detail-long-description" set:html={initialModel.longDescriptionHtml}></div>
          <h3>Use cases</h3>
          <div id="detail-use-cases" set:html={initialModel.useCasesHtml}></div>
          <h3>Limitations</h3>
          <div id="detail-cannot-be-used-for" set:html={initialModel.cannotBeUsedForHtml}></div>
        </div>
        <div id="panel-pde" class="tab-panel generated-content" role="tabpanel" aria-labelledby="tab-pde" hidden set:html={initialModel.pdeHtml}></div>
        <div id="panel-normalization" class="tab-panel generated-content" role="tabpanel" aria-labelledby="tab-normalization" hidden set:html={initialModel.normalizationHtml}></div>
        <div id="panel-discretization" class="tab-panel generated-content" role="tabpanel" aria-labelledby="tab-discretization" hidden set:html={initialModel.discretizationHtml}></div>
        <div id="panel-diagnostics" class="tab-panel generated-content" role="tabpanel" aria-labelledby="tab-diagnostics" hidden set:html={initialModel.scalarQuantitiesHtml}></div>
        <div id="panel-examples" class="tab-panel generated-content" role="tabpanel" aria-labelledby="tab-examples" hidden set:html={initialModel.examplesHtml}></div>
      </article>
    </section>
    <p class="documentation-link">See the <a href={docsBase}>full Struphy model documentation</a> for equations, parameters, and usage.</p>
  </main>
</Layout>
<script is:inline define:vars={{ catalogue }}>
  const models = catalogue;
  const docsUrl = (modelName) => `https://struphy-hub.github.io/struphy/sections/subsections/models-all.html#struphy.models.${modelName}`;
  const options = [...document.querySelectorAll('.model-option')];
  const tabs = [...document.querySelectorAll('[role="tab"]')];
  const panels = [...document.querySelectorAll('[role="tabpanel"]')];
  const setTab = (tab) => { tabs.forEach((item) => { const active = item === tab; item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; }); panels.forEach((panel) => { panel.hidden = panel.getAttribute('aria-labelledby') !== tab.id; }); };
  const selectModel = (className, { updateHash = true } = {}) => { const model = models.find((item) => item.className === className); if (!model) return; options.forEach((option) => option.setAttribute('aria-pressed', String(option.dataset.model === className))); document.querySelector('#detail-name').textContent = model.className; document.querySelector('#detail-type').textContent = `${model.type} model`; document.querySelector('#detail-description').textContent = model.description; document.querySelector('#detail-docs').href = docsUrl(model.className); document.querySelector('#detail-long-description').innerHTML = model.longDescriptionHtml; document.querySelector('#detail-use-cases').innerHTML = model.useCasesHtml; document.querySelector('#detail-cannot-be-used-for').innerHTML = model.cannotBeUsedForHtml; document.querySelector('#panel-pde').innerHTML = model.pdeHtml; document.querySelector('#panel-normalization').innerHTML = model.normalizationHtml; document.querySelector('#panel-discretization').innerHTML = model.discretizationHtml; document.querySelector('#panel-diagnostics').innerHTML = model.scalarQuantitiesHtml; document.querySelector('#panel-examples').innerHTML = model.examplesHtml; setTab(document.querySelector('#tab-information')); if (updateHash && history.replaceState) history.replaceState(null, '', `#${className}`); };
  options.forEach((option) => option.addEventListener('click', () => selectModel(option.dataset.model)));
  tabs.forEach((tab, index) => { tab.addEventListener('click', () => setTab(tab)); tab.addEventListener('keydown', (event) => { if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return; event.preventDefault(); const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length]; next.focus(); setTab(next); }); });

  const filterInput = document.querySelector('[data-model-filter]');
  const groups = [...document.querySelectorAll('[data-selector-group]')];
  const filterEmpty = document.querySelector('[data-model-filter-empty]');
  const filterQuery = document.querySelector('[data-model-filter-query]');
  const applyFilter = () => {
    const query = (filterInput?.value || '').trim().toLowerCase();
    let visibleCount = 0;
    groups.forEach((group) => {
      let groupVisible = 0;
      group.querySelectorAll('.model-option').forEach((option) => {
        const matches = !query || (option.dataset.modelSearch || '').includes(query);
        option.hidden = !matches;
        if (matches) groupVisible += 1;
      });
      group.hidden = groupVisible === 0;
      visibleCount += groupVisible;
    });
    if (filterEmpty) filterEmpty.hidden = visibleCount > 0;
    if (filterQuery) filterQuery.textContent = query;
  };
  filterInput?.addEventListener('input', applyFilter);

  const hashClassName = decodeURIComponent(location.hash.replace(/^#/, ''));
  if (hashClassName && models.some((model) => model.className === hashClassName)) {
    selectModel(hashClassName, { updateHash: false });
  }

  const copyLinkButton = document.querySelector('[data-copy-link]');
  copyLinkButton?.addEventListener('click', async () => {
    const className = document.querySelector('#detail-name')?.textContent;
    const url = `${location.origin}${location.pathname}#${className}`;
    try {
      await navigator.clipboard.writeText(url);
      copyLinkButton.textContent = 'Copied!';
      setTimeout(() => { copyLinkButton.textContent = 'Copy link'; }, 1800);
    } catch {
      copyLinkButton.textContent = 'Copy failed';
    }
  });
</script>
<style>
  h1,h2,p { margin-top:0; }
  .intro { padding-block:clamp(56px,8vw,92px); max-width:760px; } h1 { margin:0 0 18px; font-size:clamp(2.35rem,5vw,4rem); line-height:1.08; letter-spacing:-.035em; } .intro>p:not(.eyebrow) { margin:0; color:var(--muted); font-size:1.1rem; }
  .documentation-link a,.docs-link { color:var(--cyan); text-underline-offset:.2em; } .documentation-link a:hover { text-decoration:underline; }
  .model-browser { display:grid; grid-template-columns:minmax(250px,300px) minmax(0,1fr); gap:48px; border-top:1px solid var(--rule); padding:40px 0 64px; } .selector { position:sticky; top:24px; align-self:start; min-width:0; }
  .model-filter { width:100%; margin-bottom:10px; padding:8px 10px; border:1px solid var(--rule); background:var(--ink); color:var(--paper); font:inherit; font-size:.87rem; }
  .model-filter:focus-visible { outline:2px solid var(--cyan); outline-offset:2px; }
  .empty-filter { margin:14px 0 0; color:var(--muted); font-size:.85rem; }
  .selector-scroll { max-height:600px; overflow:auto; border-top:1px solid var(--rule); } .selector-group+.selector-group { margin-top:20px; } .selector-heading { display:flex; align-items:baseline; justify-content:space-between; gap:10px; padding:9px 8px 6px; border-bottom:1px solid var(--rule); } .selector-heading h2 { margin:0; font:600 .72rem/1.4 var(--mono); letter-spacing:.08em; text-transform:uppercase; } .selector-heading span { color:var(--muted); font:.72rem var(--mono); } .model-option { display:block; width:100%; padding:11px 8px; border:0; border-bottom:1px solid var(--rule); background:none; color:var(--cyan); text-align:left; cursor:pointer; } .model-option:hover,.model-option:focus-visible,.model-option[aria-pressed="true"] { background:var(--accent-wash); color:var(--paper); } code { overflow-wrap:anywhere; font:600 .87rem/1.45 var(--mono); } button:focus-visible,a:focus-visible { outline:2px solid var(--cyan); outline-offset:3px; }
  .eyebrow { margin:0 0 7px; color:var(--muted); font:600 .76rem/1.4 var(--mono); text-transform:uppercase; letter-spacing:.08em; } .detail { min-width:0; border:1px solid var(--rule); padding:20px; } .detail-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; } .detail h2 { margin:0 0 18px; font-size:1.45rem; overflow-wrap:anywhere; } .detail-heading-actions { display:flex; align-items:center; gap:12px; flex:none; } .docs-link { padding-top:4px; font-size:.9rem; white-space:nowrap; } .copy-link { flex:none; padding:6px 11px; border:1px solid var(--rule); background:transparent; color:var(--muted); cursor:pointer; font:600 .78rem/1.4 var(--sans); }
  .copy-link:hover { color:var(--paper); border-color:var(--cyan); } .tabs { display:flex; flex-wrap:wrap; gap:0 24px; margin:4px 0 18px; border-bottom:1px solid var(--rule); } .tabs button { padding:10px 0 8px; border:0; border-bottom:2px solid transparent; background:none; color:var(--muted); cursor:pointer; font:inherit; font-size:.9rem; } .tabs button[aria-selected="true"] { border-bottom-color:var(--cyan); color:var(--paper); } .tab-panel { padding-top:0; } .tab-panel>p { color:var(--muted); max-width:72ch; } .generated-content { max-height:560px; overflow:auto; overflow-wrap:anywhere; color:var(--muted); font-size:.94rem; } .generated-content :global(p),.generated-content :global(ul),.generated-content :global(ol),.generated-content :global(h3),.generated-content :global(h4) { margin-block:0 12px; } .generated-content :global(ul),.generated-content :global(ol) { padding-left:1.25rem; } .generated-content :global(h3),.generated-content :global(h4) { color:var(--paper); font-size:.98rem; } .generated-content :global(a) { color:var(--cyan); } .generated-content :global([style*="display:block"]) { max-width:100%; overflow-x:auto; overflow-y:hidden; }
  .generated-content :global(.math-display) { margin:10px 0; overflow-x:auto; overflow-y:hidden; text-align:center; }
  .generated-content :global(.katex-display) { margin:0; }
  .documentation-link { margin:0; padding:0 0 52px; color:var(--muted); }
  @media (max-width:760px) { .model-browser { grid-template-columns:1fr; gap:28px; } .selector { position:static; } .selector-scroll { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); max-height:none; border-left:1px solid var(--rule); } .selector-group,.selector-group+.selector-group { margin:0; min-width:0; } .selector-group:nth-child(odd) { border-right:1px solid var(--rule); } .selector-heading { border-top:1px solid var(--rule); } .detail-heading { flex-direction:column; gap:2px; } .docs-link { padding-top:0; } }
  @media (max-width:400px) { main { width:min(100% - 28px,1120px); } h1 { font-size:2.15rem; } .selector-scroll { display:block; border-left:0; } .selector-group+.selector-group { margin-top:20px; } .selector-group:nth-child(odd) { border-right:0; } .tabs { gap:0 15px; } .tabs button { font-size:.83rem; } }
</style>
