---
import Layout from '../../layouts/Layout.astro';
import ModelPreview from '../../components/ModelPreview.astro';
import rawModels from '../../data/models.json';
import { toSlug } from '../../lib/catalogue';

const categoryOrder = ['Fluid', 'Kinetic', 'Hybrid', 'Toy'];
const models = rawModels.map((model: any) => ({
  className: model.className,
  type: model.type,
  description: model.description,
  slug: toSlug(model.className),
}));
const categories = categoryOrder
  .map((name) => ({ name, models: models.filter((model) => model.type === name) }))
  .filter((category) => category.models.length);
const initial = models[0];
---

<Layout title="Models — Struphy" description="Browse the complete catalogue of fluid, kinetic, hybrid, and reference models available in Struphy.">
  <main>
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Simulation models</p>
      <h1 id="page-title">Models</h1>
      <p>Choose among fluid, kinetic, hybrid, and reference models. Every model has a shareable page with equations, use cases, limitations, discretization details, diagnostics, and an example.</p>
      <p class="links-row">
        <a class="relationships-link" href="/feec/">How Struphy discretizes fields (FEEC) →</a>
      </p>
    </section>

    <section class="browser" aria-label="Model catalogue">
      <aside class="selector">
        <label for="model-filter">{models.length} available</label>
        <input id="model-filter" type="search" data-filter placeholder="Filter models or physics…" />

        <div class="model-list">
          {categories.map((category) => (
            <section class="group" data-group>
              <h2>{category.name} <span>{category.models.length}</span></h2>
              <ul>
                {category.models.map((model) => (
                  <li data-model-row data-search={`${model.className} ${model.description} ${model.type}`.toLowerCase()}>
                    <a
                      href={`/models/${model.slug}/`}
                      data-model-option={model.slug}
                      aria-current={model.slug === initial.slug ? 'true' : undefined}
                    >
                      <code>{model.className}</code>
                      <span>{model.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <p class="empty" data-empty hidden>No models match your search.</p>
        </div>
      </aside>

      <ModelPreview initialSlug={initial.slug} />
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ models }}>
  const input = document.querySelector('[data-filter]');
  const options = [...document.querySelectorAll('[data-model-option]')];
  const rows = [...document.querySelectorAll('[data-model-row]')];
  const groups = [...document.querySelectorAll('[data-group]')];
  const empty = document.querySelector('[data-empty]');
  const preview = document.querySelector('[data-model-preview]');

  const selectModel = (slug, updateHash = true) => {
    if (!models.some((model) => model.slug === slug)) return;
    options.forEach((option) => {
      if (option.dataset.modelOption === slug) option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
    if (preview) {
      preview.dataset.slug = slug;
      preview.dispatchEvent(new CustomEvent('model-preview-change', { detail: { slug } }));
    }
    if (updateHash) history.replaceState(null, '', `#${slug}`);
  };

  options.forEach((option) => option.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    selectModel(option.dataset.modelOption);
  }));

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const match = !query || (row.dataset.search || '').includes(query);
      row.hidden = !match;
      if (match) visible += 1;
    });
    groups.forEach((group) => {
      group.hidden = ![...group.querySelectorAll('[data-model-row]')].some((row) => !row.hidden);
    });
    if (empty) empty.hidden = visible > 0;
  });

  const requested = decodeURIComponent(location.hash.slice(1));
  if (requested) selectModel(requested, false);
</script>

<style>
  .intro{max-width:780px;padding-block:clamp(56px,8vw,92px)}
  .eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}
  .intro>p:not(.eyebrow){color:var(--muted)}
  .links-row{display:flex;flex-wrap:wrap;gap:20px;margin-top:14px}
  .relationships-link{display:inline-block;color:var(--cyan)}
  .browser{display:grid;grid-template-columns:minmax(250px,300px) minmax(0,1fr);gap:48px;padding-block:40px 72px;border-top:1px solid var(--rule);align-items:start}
  .selector{position:sticky;top:92px;max-height:calc(100vh - 116px);overflow:auto;padding-right:12px}
  .selector>label{display:block;margin-bottom:9px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  input{width:100%;padding:10px 12px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit}
  input:focus{outline:2px solid var(--cyan);outline-offset:2px}
  .model-list{margin-top:26px}
  .group{margin-top:25px}
  .group:first-child{margin-top:0}
  .group h2{margin:0 0 7px;padding-bottom:7px;border-bottom:1px solid var(--rule);font-size:.88rem;letter-spacing:.02em}
  .group h2 span{margin-left:5px;color:var(--muted);font:400 .72rem var(--mono)}
  ul{margin:0;padding:0;list-style:none}
  li a{display:block;padding:9px 10px;border-left:2px solid transparent;color:var(--paper);text-decoration:none}
  li a:hover{background:var(--accent-wash)}
  li a[aria-current=true]{border-left-color:var(--cyan);background:var(--accent-wash)}
  li code{display:block;color:var(--cyan);font-size:.82rem;overflow-wrap:anywhere}
  li span{display:block;margin-top:3px;color:var(--muted);font-size:.73rem;line-height:1.4}
  .empty{color:var(--muted);font-size:.84rem}
  [hidden]{display:none!important}
  @media(max-width:820px){.browser{grid-template-columns:1fr;gap:28px}.selector{position:static;max-height:none;padding-right:0}.model-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}}
  @media(max-width:560px){.model-list{display:block}}
</style>
