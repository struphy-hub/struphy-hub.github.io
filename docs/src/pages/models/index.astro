---
import Layout from '../../layouts/Layout.astro';
import rawModels from '../../data/models.json';
import { toSlug } from '../../lib/catalogue';

const categoryOrder = ['Fluid','Kinetic','Hybrid','Toy'];
const categories = categoryOrder.map((name) => ({ name, models: rawModels.filter((model: any) => model.type === name) }));
---

<Layout title="Models — Struphy" description="Browse the complete catalogue of fluid, kinetic, hybrid, and reference models available in Struphy.">
  <main>
    <section class="intro" aria-labelledby="page-title"><p class="eyebrow">Simulation models</p><h1 id="page-title">Models</h1><p>Choose among fluid, kinetic, hybrid, and reference models. Every model has a shareable page with equations, use cases, limitations, discretization details, diagnostics, and an example.</p></section>
    <section class="directory" aria-labelledby="directory-title">
      <div class="directory-heading"><div><p class="eyebrow">{rawModels.length} available</p><h2 id="directory-title">Choose a model</h2></div><input type="search" data-filter placeholder="Filter models or physics…" aria-label="Filter models" /></div>
      {categories.map((category) => <section class="group" data-group><h3>{category.name} <span>{category.models.length}</span></h3><div class="cards">{category.models.map((model: any) => <a class="card" href={`/models/${toSlug(model.className)}/`} data-search={`${model.className} ${model.description} ${model.useCasesHtml ?? ''}`.toLowerCase()}><code>{model.className}</code><p>{model.description}</p><span>View model →</span></a>)}</div></section>)}
      <p data-empty hidden>No models match your search.</p>
    </section>
  </main>
</Layout>
<script>
  const input=document.querySelector<HTMLInputElement>('[data-filter]');const items=[...document.querySelectorAll<HTMLElement>('[data-search]')];const groups=[...document.querySelectorAll<HTMLElement>('[data-group]')];const empty=document.querySelector<HTMLElement>('[data-empty]');input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();let total=0;items.forEach((item)=>{const match=!query||(item.dataset.search||'').includes(query);item.hidden=!match;if(match)total+=1});groups.forEach((group)=>{group.hidden=![...group.querySelectorAll<HTMLElement>('[data-search]')].some((item)=>!item.hidden)});if(empty)empty.hidden=total>0});
</script>
<style>
  .intro{max-width:780px;padding-block:clamp(56px,8vw,92px)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}.intro>p:not(.eyebrow),[data-empty]{color:var(--muted)}.directory{padding-block:40px 72px;border-top:1px solid var(--rule)}.directory-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:34px}h2{margin:0;font-size:1.6rem}input{width:min(100%,320px);padding:10px 12px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit}.group{margin-top:34px}.group h3{margin:0 0 12px;padding-bottom:8px;border-bottom:1px solid var(--rule)}.group h3 span{margin-left:6px;color:var(--muted);font:400 .78rem var(--mono)}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.card{display:flex;min-width:0;min-height:180px;padding:18px;border:1px solid var(--rule);color:var(--paper);text-decoration:none;flex-direction:column}.card:hover{border-color:var(--cyan);background:var(--accent-wash)}.card code{color:var(--cyan);overflow-wrap:anywhere}.card p{margin:10px 0;color:var(--muted);font-size:.84rem}.card span{margin-top:auto;color:var(--cyan);font-size:.78rem}@media(max-width:760px){.directory-heading{align-items:stretch;flex-direction:column}.cards{grid-template-columns:1fr 1fr}}@media(max-width:480px){.cards{grid-template-columns:1fr}}
</style>
