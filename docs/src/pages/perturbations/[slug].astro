---
import Layout from '../../layouts/Layout.astro';
import Heatmap from '../../components/Heatmap.astro';
import catalogueIndex from '../../data/catalogue-index.json';
import catalogueDetails from '../../data/catalogue-details.json';

export function getStaticPaths() {
  return catalogueIndex.perturbations.map((record) => ({ params: { slug: record.slug }, props: { slug: record.slug } }));
}
const { slug } = Astro.props;
const perturbation = catalogueDetails.perturbations.find((item) => item.slug === slug);
if (!perturbation) throw new Error(`Unknown perturbation: ${slug}`);
const planes = ['xy','xz','yz'];
const docsUrl = `https://struphy-hub.github.io/struphy/sections/perturbations.html#struphy.initial.perturbations.${perturbation.type}`;
function linePoints(values: number[], width = 280, height = 150) { const finite=values.map((value)=>Number.isFinite(value)?value:0); const min=Math.min(...finite),max=Math.max(...finite),span=max-min||1; return finite.map((value,index)=>`${(index/Math.max(1,finite.length-1))*width},${height-((value-min)/span)*height}`).join(' '); }
---

<Layout title={`${perturbation.type} perturbation — Struphy`} description={`${perturbation.type}, an initial-condition perturbation available in Struphy.`}>
  <main>
    <header class="intro"><p class="eyebrow">Struphy perturbation{perturbation.given_in_basis ? ` · ${perturbation.given_in_basis} basis` : ''}</p><h1>{perturbation.type}</h1><div class="actions"><a href="/perturbations/">← All perturbations</a><a href={docsUrl}>Documentation ↗</a></div></header>
    <section class="section"><h2>Coordinate slices</h2><p class="lead">The sampled perturbation value across the three logical coordinate planes.</p><div class="plots">{planes.map((plane)=>{const slice=perturbation.slices?.[plane]??perturbation.slice;if(!slice?.fields?.u?.values)return null;return <article><h3>{plane.toUpperCase()} plane <small>at {slice.value}</small></h3><Heatmap values={slice.fields.u.values} label="Perturbation value u" palette="diverging" xLabel={slice.axes[0]} yLabel={slice.axes[1]} /></article>})}</div></section>
    {perturbation.centerlines && <section class="section"><h2>Coordinate-line profiles</h2><div class="profiles">{['eta1','eta2','eta3'].map((axis)=>{const line=perturbation.centerlines[axis];if(!line?.fields?.u)return null;return <figure><svg viewBox="0 0 310 175" role="img" aria-label={`${axis} perturbation profile`}><g transform="translate(15 10)"><rect width="280" height="150" fill="none" stroke="var(--rule)"/><polyline points={linePoints(line.fields.u)} fill="none" stroke="var(--cyan)" stroke-width="2"/></g></svg><figcaption>{axis} · other coordinates fixed at 0.5</figcaption></figure>})}</div></section>}
    <section class="section"><h2>Parameters</h2><div class="table-wrap"><table><thead><tr><th>Parameter</th><th>Value</th><th>Description</th></tr></thead><tbody>{Object.entries(perturbation.parameters??{}).filter(([key])=>key!=='self').map(([key,value])=><tr><th><code>{key}</code></th><td><code>{typeof value==='object'?JSON.stringify(value):String(value)}</code></td><td>{perturbation.parameter_descriptions?.[key]??'—'}</td></tr>)}</tbody></table></div></section>
  </main>
</Layout>
<style>
  .intro{padding-block:clamp(50px,7vw,82px)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}h1{margin:0 0 18px;font-size:clamp(2rem,5vw,3.6rem);line-height:1.08;overflow-wrap:anywhere}.actions{display:flex;gap:22px}.actions a{color:var(--cyan)}.section{padding-block:42px 60px;border-top:1px solid var(--rule)}h2{margin:0 0 8px}.lead{color:var(--muted)}.plots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:26px}.plots article{padding:14px;border:1px solid var(--rule)}h3{margin:0 0 12px;font-size:1rem;overflow-wrap:anywhere}h3 small{color:var(--muted);font-size:.72rem;font-weight:400}.profiles{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.profiles figure{margin:0}.profiles svg{display:block;width:100%;background:var(--plot-bg)}figcaption{color:var(--muted);font-size:.82rem}.table-wrap{overflow:auto;margin-top:20px}table{width:100%;border-collapse:collapse;font-size:.86rem}th,td{padding:10px 12px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:top}thead th{font-size:.72rem;text-transform:uppercase}tbody th{font-weight:400}td:last-child{color:var(--muted)}@media(max-width:760px){.plots,.profiles{grid-template-columns:1fr}}
</style>
