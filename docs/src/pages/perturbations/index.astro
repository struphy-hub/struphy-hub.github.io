---
import Layout from '../../layouts/Layout.astro';
import CataloguePreview from '../../components/CataloguePreview.astro';
import catalogueIndex from '../../data/catalogue-index.json';
const perturbations = catalogueIndex.perturbations;
const initial = perturbations[0];
const summary = (item) => item.basis ? `Initial-condition function represented in the ${item.basis} basis.` : 'Initial-condition function used to seed a Struphy simulation.';
---

<Layout title="Perturbations — Struphy" description="Browse initial-condition perturbations available in Struphy.">
  <main>
    <section class="intro" aria-labelledby="page-title"><p class="eyebrow">Initial conditions</p><h1 id="page-title">Perturbations</h1><p>Explore functions used to seed Struphy simulations. Select an entry to open its coordinate slices, profiles, parameters, and reference documentation.</p></section>
    <section class="browser" aria-label="Available perturbations">
      <aside class="selector" aria-label="Select a perturbation"><p class="eyebrow">Select a perturbation</p><input type="search" data-filter placeholder="Filter perturbations…" aria-label="Filter perturbations" /><ul>{perturbations.map((item,index)=><li data-item><a href={`/perturbations/${item.slug}/`} data-option={item.slug} data-search={`${item.type} ${item.basis??''}`.toLowerCase()} aria-current={index===0?'true':undefined}><code>{item.type}</code></a></li>)}</ul><p class="empty" data-empty hidden>No perturbations match your search.</p></aside>
      <article class="detail" aria-live="polite"><p class="eyebrow">Perturbation</p><h2 data-name>{initial.type}</h2><p class="description" data-description>{summary(initial)}</p><CataloguePreview category="perturbations" initialSlug={initial.slug} /><dl><div><dt>Basis</dt><dd data-basis>{initial.basis || 'Not specified'}</dd></div><div><dt>Available data</dt><dd>XY, XZ, and YZ slices · coordinate-line profiles</dd></div></dl><a class="button" data-open href={`/perturbations/${initial.slug}/`}>Open plots and parameters →</a></article>
    </section>
  </main>
</Layout>
<script is:inline define:vars={{ perturbations }}>
  const options=[...document.querySelectorAll('[data-option]')],items=[...document.querySelectorAll('[data-item]')];const input=document.querySelector('[data-filter]'),empty=document.querySelector('[data-empty]'),name=document.querySelector('[data-name]'),description=document.querySelector('[data-description]'),basis=document.querySelector('[data-basis]'),open=document.querySelector('[data-open]');
  function select(slug,updateHash=true){const item=perturbations.find((entry)=>entry.slug===slug);if(!item)return;options.forEach((option)=>option.setAttribute('aria-current',String(option.dataset.option===slug)));name.textContent=item.type;description.textContent=item.basis?`Initial-condition function represented in the ${item.basis} basis.`:'Initial-condition function used to seed a Struphy simulation.';basis.textContent=item.basis||'Not specified';open.href=`/perturbations/${item.slug}/`;document.querySelector('[data-catalogue-preview]')?.dispatchEvent(new CustomEvent('catalogue-preview-change',{detail:{slug}}));if(updateHash&&history.replaceState)history.replaceState(null,'',`#${item.slug}`)}
  options.forEach((option)=>option.addEventListener('click',(event)=>{if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;event.preventDefault();select(option.dataset.option)}));input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();let count=0;items.forEach((item)=>{const option=item.querySelector('[data-option]');const match=!query||(option?.dataset.search||'').includes(query);item.hidden=!match;if(match)count+=1});if(empty)empty.hidden=count>0});const hash=decodeURIComponent(location.hash.replace(/^#/,''));if(hash&&perturbations.some((item)=>item.slug===hash))select(hash,false);
</script>
<style>
  .intro{max-width:760px;padding-block:clamp(56px,8vw,92px)}h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}.intro>p:not(.eyebrow){color:var(--muted);font-size:1.1rem}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}.browser{display:grid;grid-template-columns:minmax(250px,300px) minmax(0,1fr);gap:48px;padding-block:40px 72px;border-top:1px solid var(--rule)}.selector{position:sticky;top:24px;align-self:start;min-width:0}.selector input{width:100%;margin-bottom:10px;padding:8px 10px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit;font-size:.87rem}.selector ul{max-height:600px;margin:0;padding:0;overflow:auto;border-top:1px solid var(--rule);list-style:none}.selector li{margin:0}.selector a{display:block;width:100%;padding:11px 8px;border-bottom:1px solid var(--rule);color:var(--cyan);text-decoration:none}.selector a:hover,.selector a:focus-visible,.selector a[aria-current=true]{background:var(--accent-wash);color:var(--paper)}.selector code{color:inherit;font:600 .87rem/1.45 var(--mono);overflow-wrap:anywhere}.empty{color:var(--muted);font-size:.85rem}.detail{min-width:0;padding:28px;border:1px solid var(--rule)}.detail h2{margin:0 0 14px;font-size:clamp(1.6rem,3vw,2.2rem);overflow-wrap:anywhere}.description{max-width:680px;color:var(--muted)}dl{display:grid;grid-template-columns:1fr 1fr;margin:28px 0;border-top:1px solid var(--rule)}dl div{padding:18px 20px 0 0}dl div+div{padding-left:20px;border-left:1px solid var(--rule)}dt{font-weight:700}dd{margin:4px 0 0;color:var(--muted)}.button{display:inline-block;margin-top:12px;padding:10px 15px;border:1px solid var(--cyan);color:var(--cyan);font-weight:650;text-decoration:none}.button:hover{background:var(--cyan);color:var(--ink)}@media(max-width:700px){.browser{grid-template-columns:1fr;gap:28px}.selector{position:static}.detail{min-height:0}dl{grid-template-columns:1fr}dl div,dl div+div{padding:14px 0;border-left:0;border-bottom:1px solid var(--rule)}}
</style>
