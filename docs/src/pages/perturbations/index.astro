---
import Layout from '../../layouts/Layout.astro';
import { toSlug } from '../../lib/catalogue';

const imported = import.meta.glob('../../data/perturbations/*.json', { eager: true, import: 'default' });
const perturbations = [...new Map(Object.values(imported).map((value: any) => [value.type, value])).values()]
  .sort((a: any, b: any) => a.type.localeCompare(b.type));
---

<Layout title="Perturbations — Struphy" description="Browse initial-condition perturbations available in Struphy.">
  <main>
    <section class="intro" aria-labelledby="page-title"><p class="eyebrow">Initial conditions</p><h1 id="page-title">Perturbations</h1><p>Browse functions used to seed Struphy simulations. Each entry has a shareable page with slice plots, profiles, parameters, and a documentation link.</p></section>
    <section class="directory" aria-labelledby="directory-title">
      <div class="directory-heading"><div><p class="eyebrow">{perturbations.length} available</p><h2 id="directory-title">Choose a perturbation</h2></div><input type="search" data-filter placeholder="Filter perturbations…" aria-label="Filter perturbations" /></div>
      <div class="cards">{perturbations.map((item: any) => <a class="card" href={`/perturbations/${toSlug(item.type)}/`} data-search={`${item.type} ${item.given_in_basis ?? ''}`.toLowerCase()}><code>{item.type}</code><span>{item.given_in_basis ? `Basis: ${item.given_in_basis}` : 'Initial-condition function'}</span></a>)}</div>
      <p data-empty hidden>No perturbations match your search.</p>
    </section>
  </main>
</Layout>
<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();let count=0;items.forEach((item)=>{const match=!query||(item.dataset.search||'').includes(query);item.hidden=!match;if(match)count+=1});if(empty)empty.hidden=count>0});
</script>
<style>
  .intro{max-width:760px;padding-block:clamp(56px,8vw,92px)}h1{margin:0 0 18px;font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}.intro>p:not(.eyebrow),[data-empty]{color:var(--muted)}.eyebrow{margin:0 0 7px;color:var(--muted);font:600 .76rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}.directory{padding-block:40px 72px;border-top:1px solid var(--rule)}.directory-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:24px}h2{margin:0;font-size:1.6rem}input{width:min(100%,320px);padding:10px 12px;border:1px solid var(--rule);background:var(--ink);color:var(--paper);font:inherit}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.card{display:flex;min-width:0;padding:18px;border:1px solid var(--rule);color:var(--paper);text-decoration:none;flex-direction:column;gap:8px}.card:hover{border-color:var(--cyan);background:var(--accent-wash)}.card code{overflow-wrap:anywhere;color:var(--cyan)}.card span{color:var(--muted);font-size:.82rem}@media(max-width:760px){.directory-heading{align-items:stretch;flex-direction:column}.cards{grid-template-columns:1fr 1fr}}@media(max-width:480px){.cards{grid-template-columns:1fr}}
</style>
